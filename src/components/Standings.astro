---
import { warbands } from '../data/warbands';
import Icon from './Icon.astro';

const sorted = [...warbands].sort((a, b) => b.rating - a.rating);
---

<section id="standings" class="standings reveal">
  <div class="ledger-heading"><span>The balance of power</span><span>Campaign ledger</span></div>
  <h2 class="section-title"><span class="ornament" aria-hidden="true"><Icon name="diamond" /></span> Campaign Standings <span class="ornament" aria-hidden="true"><Icon name="diamond" /></span></h2>
  <p class="scroll-hint" id="standings-scroll-hint" hidden>Scroll sideways to see all standings <Icon name="arrow-right" size={14} /></p>
  <div class="standings-table-wrap" tabindex="0" role="region" aria-label="Campaign standings">
    <table class="standings-table">
      <thead>
        <tr>
          <th scope="col">Warband</th><th scope="col">Rating</th><th scope="col">Battles</th><th scope="col">Victories</th><th scope="col">Wyrdstone</th><th scope="col">Gold Crowns</th>
        </tr>
      </thead>
      <tbody>
        {
          sorted.map((wb, index) => (
            <tr>
              <th scope="row"><span class="ledger-rank" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span class="ledger-sigil">{wb.sigil}</span> {wb.name}</th>
              <td class="ledger-rating">{wb.rating}</td>
              <td>{wb.battles}</td>
              <td>{wb.victories}</td>
              <td class="wyrd">{wb.wyrdstone} shards</td>
              <td>{wb.gold} gc</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="ledger-footer"><span>Ranked by warband rating</span><span>Fortune favours the living</span></div>
</section>

<style>
  .ledger-heading, .ledger-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: #b69a62;
    font: var(--text-meta)/1.6 var(--font-utility);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ledger-heading { margin-bottom: 1rem; }
  .ledger-footer { padding-top: 0.8rem; color: #a9aa98; }
  .scroll-hint { color: var(--ink-dim); font: var(--text-ui)/1.6 var(--font-utility); margin-bottom: .75rem; }
  .scroll-hint :global(svg) { margin-left: .25rem; }
  .standings-table-wrap {
    overflow-x: auto;
    border: 1px solid #514936;
    border-top: 3px double #b69a62;
    scrollbar-color: #b69a62 #101715;
  }
  .standings-table-wrap:focus-visible { outline: 2px solid #b69a62; outline-offset: 5px; }
  .standings-table {
    width: 100%;
    min-width: 660px;
    border-collapse: separate;
    border-spacing: 0;
    background: #141b18;
    color: #c9c4b3;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-utility);
  }
  .standings-table th,
  .standings-table td {
    border-bottom: 1px solid #363b30;
    border-right: 1px solid rgba(182, 154, 98, 0.1);
    padding: 1.15rem 1rem;
    text-align: center;
  }
  .standings-table thead th {
    font-family: Georgia, serif;
    font-size: var(--text-ui);
    color: #b69a62;
    background: rgba(182, 154, 98, 0.055);
    font-weight: normal;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }
  .standings-table th:first-child {
    position: sticky;
    left: 0;
    z-index: 1;
    background: #141b18;
    text-align: left;
    box-shadow: 1px 0 0 var(--border);
  }
  .standings-table thead th:first-child,
  .standings-table tbody tr:first-child th:first-child { background: #1d221c; }
  .standings-table tbody tr:hover th:first-child { background: #23261f; }
  .standings-table tbody th {
    font-family: Georgia, serif;
    font-size: 0.96rem;
    font-weight: normal;
    color: #e7dcc5;
  }
  .standings-table tbody tr:first-child { background: rgba(182, 154, 98, 0.055); }
  .standings-table tbody tr:last-child > * { border-bottom: 0; }
  .standings-table tbody tr:hover { background: rgba(182, 154, 98, 0.09); }
  .ledger-rank { color: #b69a62; font-size: var(--text-meta); margin-right: .5rem; }
  .ledger-sigil { display: inline-block; margin-right: 0.45rem; color: #b69a62; font-size: var(--text-meta); letter-spacing: .04em; }
  .standings-table .ledger-rating { color: #e7dcc5; font-size: 1.15rem; }
  .standings-table .wyrd { color: #a8b69b; }
  @media (max-width: 700px) {
    .ledger-heading, .ledger-footer { flex-wrap: wrap; gap: .35rem 1rem; letter-spacing: .04em; }
    .standings-table th, .standings-table td { padding: 1rem 0.8rem; }
    .standings-table th:first-child { min-width: 8.5rem; width: 8.5rem; max-width: 8.5rem; overflow-wrap: anywhere; }
  }
</style>

<script>
  const scroller = document.querySelector<HTMLElement>('.standings-table-wrap')!;
  const hint = document.getElementById('standings-scroll-hint')!;
  function updateOverflow() {
    const overflowing = scroller.scrollWidth > scroller.clientWidth + 1;
    hint.hidden = !overflowing;
    if (overflowing) scroller.setAttribute('aria-describedby', hint.id);
    else scroller.removeAttribute('aria-describedby');
  }
  const observer = new ResizeObserver(updateOverflow);
  observer.observe(scroller);
  observer.observe(scroller.querySelector('table')!);
  updateOverflow();
</script>
