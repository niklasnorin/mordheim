---
// Atmospheric layers: rain, crows, fog, lightning, vignette (night)
// and autumn leaves, foggy city skyline (day) — with a day/night switch
---

<canvas id="rain-canvas" aria-hidden="true"></canvas>
<canvas id="leaf-canvas" aria-hidden="true"></canvas>
<canvas id="crow-canvas" aria-hidden="true"></canvas>
<canvas id="crow-canvas-front" aria-hidden="true"></canvas>
<!-- Tall vertical backdrop: sky + city outline on top, black earth in the middle,
     the graveyard at the bottom. The viewport pans down through it as the page scrolls. -->
<div class="backdrop" aria-hidden="true">
  <div class="backdrop-stack">
    <div class="stack-sky" style={`--sky-img: url(${import.meta.env.BASE_URL}/day-skyline.jpg)`}>
      <div class="day-fog"></div>
    </div>
    <div class="stack-gap"></div>
    <div class="stack-grave" style={`--grave-img: url(${import.meta.env.BASE_URL}/graveyard.jpg)`}></div>
  </div>
</div>
<div class="fog" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>
<div class="lightning" id="lightning" aria-hidden="true"></div>
<button id="theme-toggle" type="button" aria-label="Switch between stormy night and autumn day" title="Switch day / night">
  <span class="icon-night" aria-hidden="true">☾</span>
  <span class="icon-day" aria-hidden="true">☀</span>
</button>

<style>
  #rain-canvas,
  #leaf-canvas,
  #crow-canvas,
  #crow-canvas-front {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #rain-canvas { z-index: 5; opacity: 0.35; }
  #leaf-canvas { z-index: 5; display: none; }
  #crow-canvas { z-index: 4; }
  #crow-canvas-front { z-index: 12; }

  :global([data-theme='day']) #rain-canvas { display: none; }
  :global([data-theme='day']) #leaf-canvas { display: block; }

  /* ── Scrolling backdrop stack ──
     Three bands stacked vertically, together taller than the viewport:
       sky + city outline (100vh) → black earth (45vh) → graveyard (100vh).
     JS sets --backdrop-progress (0 at page top → 1 as the graveyard section
     arrives) and the stack is translated up so the viewport pans down through it. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .backdrop-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    /* 100vh + 45vh + 100vh */
    height: 245vh;
    transform: translateY(calc(var(--backdrop-progress, 0) * -145vh));
    will-change: transform;
  }
  .stack-sky,
  .stack-gap,
  .stack-grave {
    position: relative;
    width: 100%;
  }
  .stack-sky {
    height: 100vh;
    background-image: var(--sky-img);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center bottom;
    filter: saturate(0.15) brightness(0.22) contrast(1.35);
    transition: filter 0.07s linear;
  }
  :global([data-theme='day']) .stack-sky {
    filter: saturate(0.8) brightness(1) contrast(1);
  }
  /* Night veil — almost black, so only a ghost of the rooftops reads. */
  .stack-sky::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #030504;
    opacity: 0.82;
    transition: opacity 0.07s linear;
  }
  :global([data-theme='day']) .stack-sky::before { opacity: 0; }
  .stack-sky.flash {
    filter: saturate(0.35) brightness(0.55) contrast(1.45);
  }
  .stack-sky.flash::before { opacity: 0.42; }
  /* Painted last, so it sits over both the skyline and the fog:
     the bottom of the outline is always solid black. */
  .stack-sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, #030504 85%, #030504 100%);
  }
  .stack-gap {
    height: 45vh;
    background: #030504;
  }
  .stack-grave {
    height: 100vh;
    background-image: var(--grave-img);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center bottom;
  }
  .stack-grave::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, #030504 0%, transparent 45%);
  }

  /* Low fog hugging the rooftops. Lives inside the sky band so it scrolls away
     with the outline and is capped by the band's black gradient below. */
  .day-fog {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 55%;
    pointer-events: none;
    display: none;
    background:
      linear-gradient(to top, rgba(196, 206, 210, 0.55), rgba(196, 206, 210, 0.25) 45%, transparent),
      radial-gradient(ellipse 70% 50% at 30% 100%, rgba(210, 218, 222, 0.4), transparent),
      radial-gradient(ellipse 60% 45% at 75% 95%, rgba(200, 210, 216, 0.35), transparent);
    animation: fog-drift 50s ease-in-out infinite alternate;
  }
  :global([data-theme='day']) .day-fog { display: block; }

  .fog {
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 40% at 20% 90%, rgba(120, 130, 145, 0.06), transparent),
      radial-gradient(ellipse 70% 35% at 80% 85%, rgba(120, 130, 145, 0.05), transparent);
    animation: fog-drift 40s ease-in-out infinite alternate;
  }
  @keyframes fog-drift {
    from { transform: translateX(-2%); }
    to   { transform: translateX(2%); }
  }
  :global([data-theme='day']) .fog { display: none; }

  .vignette {
    position: fixed;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  }
  :global([data-theme='day']) .vignette {
    background: radial-gradient(ellipse at center, transparent 65%, rgba(40, 52, 64, 0.35) 100%);
  }

  .lightning {
    position: fixed;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: rgba(200, 215, 235, 0);
    transition: background 0.08s;
  }
  .lightning.flash { background: rgba(200, 215, 235, 0.12); }
  :global([data-theme='day']) .lightning { display: none; }

  /* ── Minimalistic day/night switch ── */
  #theme-toggle {
    position: fixed;
    top: 1.35rem;
    right: 1rem;
    z-index: 100;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--gold);
    background: #111915ee;
    border: 1px solid var(--border);
    border-radius: 2px;
    cursor: pointer;
    transition: color 0.25s, box-shadow 0.25s;
  }
  #theme-toggle:hover {
    color: var(--parchment);
    box-shadow: 0 0 12px rgba(184, 150, 62, 0.35);
  }
  #theme-toggle .icon-day { display: none; }
  :global([data-theme='day']) #theme-toggle .icon-day { display: inline; }
  :global([data-theme='day']) #theme-toggle .icon-night { display: none; }

  @media (prefers-reduced-motion: reduce) {
    #rain-canvas, #leaf-canvas, #crow-canvas, #crow-canvas-front { display: none !important; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Day/night switch ── */
  const root = document.documentElement;
  const isDay = () => root.dataset.theme === 'day';

  document.getElementById('theme-toggle')!.addEventListener('click', () => {
    if (isDay()) {
      delete root.dataset.theme;
    } else {
      root.dataset.theme = 'day';
    }
    try {
      localStorage.setItem('mordheim-theme', isDay() ? 'day' : 'night');
    } catch {}
  });

  /* ── Scroll-driven backdrop ──
     The stack is 145vh taller than the viewport (100vh sky + 45vh black + 100vh
     graves). Graveyard art starts 145vh down the stack, so it first touches the
     fold at progress = 45/145. We hold there until #graveyard itself reaches the
     fold, then finish the pan as that section comes on screen. */
  const graveyardSection = document.getElementById('graveyard');
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const REVEAL = 45 / 145;

  let scrollQueued = false;
  function updateScrollVars() {
    scrollQueued = false;
    const vh = window.innerHeight;
    const doc = document.documentElement;
    const scrollY = window.scrollY;

    const graveTop = graveyardSection
      ? graveyardSection.getBoundingClientRect().top + scrollY
      : doc.scrollHeight;
    const revealStart = Math.max(1, graveTop - vh);
    const revealEnd = Math.max(revealStart + 1, graveTop - vh * 0.25);

    let progress: number;
    if (scrollY <= revealStart) {
      progress = REVEAL * clamp01(scrollY / revealStart);
    } else {
      progress = REVEAL + (1 - REVEAL) * clamp01((scrollY - revealStart) / (revealEnd - revealStart));
    }
    root.style.setProperty('--backdrop-progress', progress.toFixed(4));
  }
  function queueScrollUpdate() {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(updateScrollVars);
  }
  window.addEventListener('scroll', queueScrollUpdate, { passive: true });
  window.addEventListener('resize', queueScrollUpdate);
  updateScrollVars();

  /* ── Rain ── */
  const rainCanvas = document.getElementById('rain-canvas') as HTMLCanvasElement;
  const rainCtx = rainCanvas.getContext('2d')!;

  interface Drop { x: number; y: number; len: number; speed: number; drift: number; }
  let drops: Drop[] = [];

  function sizeCanvas(c: HTMLCanvasElement) {
    c.width = window.innerWidth;
    c.height = window.innerHeight;
  }

  function initRain() {
    sizeCanvas(rainCanvas);
    const count = Math.floor((rainCanvas.width * rainCanvas.height) / 9000);
    drops = Array.from({ length: count }, () => ({
      x: Math.random() * rainCanvas.width,
      y: Math.random() * rainCanvas.height,
      len: 8 + Math.random() * 16,
      speed: 9 + Math.random() * 10,
      drift: 1 + Math.random() * 1.5,
    }));
  }

  function drawRain() {
    rainCtx.clearRect(0, 0, rainCanvas.width, rainCanvas.height);
    rainCtx.strokeStyle = 'rgba(170, 190, 210, 0.35)';
    rainCtx.lineWidth = 1;
    for (const d of drops) {
      rainCtx.beginPath();
      rainCtx.moveTo(d.x, d.y);
      rainCtx.lineTo(d.x - d.drift, d.y + d.len);
      rainCtx.stroke();
      d.y += d.speed;
      d.x -= d.drift;
      if (d.y > rainCanvas.height) {
        d.y = -d.len;
        d.x = Math.random() * (rainCanvas.width + 100);
      }
    }
  }

  /* ── Autumn leaves ── */
  const leafCanvas = document.getElementById('leaf-canvas') as HTMLCanvasElement;
  const leafCtx = leafCanvas.getContext('2d')!;

  const LEAF_COLORS = ['#a5622a', '#b8842c', '#8a3d1f', '#c49a3c', '#7d4a22', '#994f18'];

  interface Leaf {
    x: number; y: number; vx: number; vy: number;
    size: number; angle: number; spin: number;
    sway: number; swaySpeed: number; color: string;
  }
  let leaves: Leaf[] = [];

  function spawnLeaf(offscreen = true): Leaf {
    return {
      x: offscreen ? leafCanvas.width + 20 + Math.random() * 120 : Math.random() * leafCanvas.width,
      y: Math.random() * leafCanvas.height,
      vx: -(0.8 + Math.random() * 1.8),
      vy: 0.3 + Math.random() * 0.7,
      size: 4 + Math.random() * 6,
      angle: Math.random() * Math.PI * 2,
      spin: (Math.random() - 0.5) * 0.08,
      sway: Math.random() * Math.PI * 2,
      swaySpeed: 0.02 + Math.random() * 0.03,
      color: LEAF_COLORS[Math.floor(Math.random() * LEAF_COLORS.length)]!,
    };
  }

  function initLeaves() {
    sizeCanvas(leafCanvas);
    const count = Math.floor((leafCanvas.width * leafCanvas.height) / 28000);
    leaves = Array.from({ length: count }, () => spawnLeaf(false));
  }

  function drawLeaf(l: Leaf) {
    leafCtx.save();
    leafCtx.translate(l.x, l.y);
    leafCtx.rotate(l.angle);
    leafCtx.fillStyle = l.color;
    leafCtx.globalAlpha = 0.85;
    leafCtx.beginPath();
    leafCtx.ellipse(0, 0, l.size, l.size * 0.45, 0, 0, Math.PI * 2);
    leafCtx.fill();
    leafCtx.restore();
  }

  function drawLeaves() {
    leafCtx.clearRect(0, 0, leafCanvas.width, leafCanvas.height);
    for (let i = 0; i < leaves.length; i++) {
      const l = leaves[i]!;
      drawLeaf(l);
      l.sway += l.swaySpeed;
      l.x += l.vx + Math.sin(l.sway) * 0.6;
      l.y += l.vy + Math.cos(l.sway * 0.7) * 0.4;
      l.angle += l.spin;
      if (l.x < -30 || l.y > leafCanvas.height + 30) {
        leaves[i] = spawnLeaf();
        if (Math.random() < 0.4) {
          leaves[i]!.x = Math.random() * leafCanvas.width;
          leaves[i]!.y = -20;
        }
      }
    }
  }

  /* ── Crows ──
     Distant flock stays in the sky. Nearer birds fly across the page,
     land on UI edges, sit / caw / flap, then take off again. */
  const crowCanvas = document.getElementById('crow-canvas') as HTMLCanvasElement;
  const crowFrontCanvas = document.getElementById('crow-canvas-front') as HTMLCanvasElement;
  const crowBackCtx = crowCanvas.getContext('2d')!;
  const crowFrontCtx = crowFrontCanvas.getContext('2d')!;
  let crowCtx = crowBackCtx;

  type CrowState = 'flying' | 'approaching' | 'landing' | 'perched' | 'taking-off';
  type PerchAction = 'idle' | 'caw' | 'flap';

  interface PerchSpot {
    id: string;
    el: Element;
    t: number;
    edge: 'top' | 'bottom';
  }

  const PERCH_TARGETS: { selector: string; edge: 'top' | 'bottom' }[] = [
    { selector: '.header-bar', edge: 'bottom' },
    { selector: '.logo-main', edge: 'top' },
    { selector: '.campaign-bar', edge: 'top' },
    { selector: '.town-cryer', edge: 'top' },
    { selector: '.warband-card', edge: 'top' },
    { selector: '.standings-table', edge: 'top' },
    { selector: '.timeline-entry', edge: 'top' },
    { selector: '.section-title', edge: 'top' },
    { selector: '.tombstone-stone', edge: 'top' },
    { selector: '.panel', edge: 'top' },
    { selector: '.site-footer', edge: 'top' },
  ];

  interface Crow {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    flySize: number;
    approachDist: number;
    phase: number;
    flapSpeed: number;
    facing: number;
    canLand: boolean;
    alpha: number;
    state: CrowState;
    target: PerchSpot | null;
    flyTimer: number;
    perchTimer: number;
    actionTimer: number;
    perchAction: PerchAction;
    headAngle: number;
    beakOpen: number;
    wingRaise: number;
    takeoffTimer: number;
  }

  const LAND_SIZE = 18;

  let crows: Crow[] = [];
  const occupied = new Set<string>();
  let nextPerchKey = 1;
  let logicalW = 0;
  let logicalH = 0;

  function sizeCrowLayer(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, dpr: number) {
    canvas.width = Math.floor(logicalW * dpr);
    canvas.height = Math.floor(logicalH * dpr);
    canvas.style.width = `${logicalW}px`;
    canvas.style.height = `${logicalH}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function sizeCrowCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    logicalW = window.innerWidth;
    logicalH = window.innerHeight;
    sizeCrowLayer(crowCanvas, crowBackCtx, dpr);
    sizeCrowLayer(crowFrontCanvas, crowFrontCtx, dpr);
  }

  function fillAlpha(color: string): number {
    if (!color || color === 'transparent') return 0;
    const rgba = color.match(/^rgba?\((.+)\)$/i);
    if (rgba) {
      const parts = rgba[1].split(',').map((part) => parseFloat(part));
      return parts.length >= 4 ? parts[3]! : 1;
    }
    return 1;
  }

  function hasOpaqueFill(el: Element): boolean {
    const style = getComputedStyle(el);
    if (style.visibility === 'hidden' || style.display === 'none') return false;
    if (parseFloat(style.opacity) < 0.08) return false;
    if (fillAlpha(style.backgroundColor) > 0.08) return true;
    return Boolean(style.backgroundImage && style.backgroundImage !== 'none');
  }

  function perchId(el: Element, spot: number) {
    const node = el as HTMLElement;
    if (!node.dataset.perchKey) {
      node.dataset.perchKey = String(nextPerchKey++);
    }
    return `${node.dataset.perchKey}:${spot}`;
  }

  function perchPos(spot: PerchSpot) {
    const r = spot.el.getBoundingClientRect();
    const pad = 18;
    const y = spot.edge === 'bottom' ? r.bottom : r.top + 2;
    return {
      x: r.left + r.width * spot.t,
      y,
      visible:
        r.width > 48 &&
        y > 20 &&
        y < logicalH - 12 &&
        r.right > pad &&
        r.left < logicalW - pad,
    };
  }

  function collectPerches(): PerchSpot[] {
    const spots: PerchSpot[] = [];
    for (const target of PERCH_TARGETS) {
      document.querySelectorAll(target.selector).forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.width < 48 || r.height < 12 || !hasOpaqueFill(el)) return;
        const count = Math.max(1, Math.min(3, Math.floor(r.width / 200)));
        for (let i = 0; i < count; i++) {
          const t = (i + 1) / (count + 1);
          const spot: PerchSpot = { id: perchId(el, i), el, t, edge: target.edge };
          if (perchPos(spot).visible && !occupied.has(spot.id)) spots.push(spot);
        }
      });
    }
    return spots;
  }

  function perchedCount() {
    return crows.filter((c) => c.state === 'perched' || c.state === 'landing' || c.state === 'approaching').length;
  }

  function spawnCrow(offscreen: boolean, canLand: boolean): Crow {
    const leftward = Math.random() < 0.5;
    const facing = leftward ? -1 : 1;
    const flySize = canLand ? 8 + Math.random() * 3.5 : 6 + Math.random() * 5;
    return {
      x: offscreen ? (leftward ? logicalW + 50 : -50) : Math.random() * logicalW,
      y: canLand
        ? 40 + Math.random() * logicalH * 0.45
        : 24 + Math.random() * logicalH * 0.28,
      vx: facing * (canLand ? 0.55 + Math.random() * 0.7 : 0.35 + Math.random() * 0.55),
      vy: 0,
      size: flySize,
      flySize,
      approachDist: 0,
      phase: Math.random() * Math.PI * 2,
      flapSpeed: 0.11 + Math.random() * 0.08,
      facing,
      canLand,
      alpha: canLand ? 0.92 : 0.55,
      state: 'flying',
      target: null,
      flyTimer: canLand ? 90 + Math.random() * 220 : 99999,
      perchTimer: 0,
      actionTimer: 0,
      perchAction: 'idle',
      headAngle: 0,
      beakOpen: 0,
      wingRaise: 0,
      takeoffTimer: 0,
    };
  }

  function initCrows() {
    sizeCrowCanvas();
    occupied.clear();
    crows = [
      ...Array.from({ length: 5 }, () => spawnCrow(false, false)),
      ...Array.from({ length: 3 }, () => spawnCrow(false, true)),
    ];
  }

  function easeToward(current: number, target: number, amount: number) {
    return current + (target - current) * amount;
  }

  function startTakeoff(c: Crow) {
    if (c.target) occupied.delete(c.target.id);
    c.target = null;
    c.state = 'taking-off';
    c.takeoffTimer = 42;
    c.facing = Math.random() < 0.5 ? -1 : 1;
    c.vx = c.facing * (1.15 + Math.random() * 0.55);
    c.vy = -2.4;
    c.beakOpen = 0;
    c.headAngle = 0;
    c.approachDist = 0;
  }

  function updateFlying(c: Crow) {
    c.size = easeToward(c.size, c.flySize, 0.05);
    c.x += c.vx;
    c.y += Math.sin(c.phase * 0.28) * (c.canLand ? 0.35 : 0.22);
    c.phase += c.flapSpeed;
    c.facing = c.vx >= 0 ? 1 : -1;
    c.flyTimer -= 1;

    if (c.canLand && c.flyTimer <= 0 && perchedCount() < 2) {
      const options = collectPerches();
      if (options.length) {
        const spot = options[Math.floor(Math.random() * options.length)]!;
        occupied.add(spot.id);
        c.target = spot;
        c.approachDist = 0;
        c.state = 'approaching';
      } else {
        c.flyTimer = 80 + Math.random() * 160;
      }
    }

    if (c.x < -70 || c.x > logicalW + 70) {
      const next = spawnCrow(true, c.canLand);
      Object.assign(c, next);
    }
  }

  function updateApproaching(c: Crow) {
    if (!c.target) {
      c.state = 'flying';
      return;
    }
    const p = perchPos(c.target);
    if (!p.visible || !hasOpaqueFill(c.target.el)) {
      occupied.delete(c.target.id);
      c.target = null;
      c.approachDist = 0;
      c.state = 'flying';
      c.flyTimer = 100;
      return;
    }

    const destX = p.x;
    const destY = p.y + (c.target.edge === 'bottom' ? -22 : 22);
    const dx = destX - c.x;
    const dy = destY - c.y;
    const dist = Math.hypot(dx, dy) || 1;
    if (c.approachDist <= 0) c.approachDist = Math.max(dist, 80);
    const t = 1 - Math.min(1, dist / c.approachDist);
    const eased = t * t * (3 - 2 * t);
    c.size = c.flySize + (LAND_SIZE - c.flySize) * eased;

    if (dist < 14) {
      c.x = p.x;
      c.y = p.y - (c.target.edge === 'bottom' ? -4 : 4);
      c.size = LAND_SIZE;
      c.state = 'landing';
      return;
    }

    const speed = Math.min(2.4, 1.1 + dist * 0.045);
    c.vx = (dx / dist) * speed;
    c.vy = (dy / dist) * speed;
    c.facing = c.vx >= 0 ? 1 : -1;
    c.x += c.vx;
    c.y += c.vy;
    c.phase += c.flapSpeed * 1.15;
  }

  function updateLanding(c: Crow) {
    if (!c.target) {
      c.state = 'flying';
      return;
    }
    const p = perchPos(c.target);
    c.size = LAND_SIZE;
    c.x = easeToward(c.x, p.x, 0.2);
    c.y = easeToward(c.y, p.y, 0.2);
    c.phase += c.flapSpeed * 0.55;
    c.facing = c.vx >= 0 ? 1 : c.facing;
    if (Math.hypot(p.x - c.x, p.y - c.y) < 2.4) {
      c.x = p.x;
      c.y = p.y;
      c.vx = 0;
      c.vy = 0;
      c.state = 'perched';
      c.perchTimer = 200 + Math.random() * 260;
      c.perchAction = 'idle';
      c.actionTimer = 36 + Math.random() * 40;
      c.wingRaise = 0;
    }
  }

  function updatePerched(c: Crow) {
    if (!c.target) {
      startTakeoff(c);
      return;
    }
    const p = perchPos(c.target);
    if (!p.visible) {
      startTakeoff(c);
      return;
    }
    c.x = p.x;
    c.y = p.y;
    c.size = LAND_SIZE;
    c.perchTimer -= 1;
    c.actionTimer -= 1;

    if (c.perchAction === 'caw') {
      const cycle = ((c.actionTimer % 26) + 26) % 26;
      const open = cycle > 10 && cycle < 22;
      c.headAngle = open ? -0.55 : -0.08;
      c.beakOpen = open ? 1 : 0.1;
      c.wingRaise *= 0.85;
    } else if (c.perchAction === 'flap') {
      c.wingRaise = 0.45 + 0.55 * Math.abs(Math.sin(c.actionTimer * 0.38));
      c.phase += 0.22;
      c.headAngle *= 0.88;
      c.beakOpen *= 0.8;
    } else {
      c.headAngle = easeToward(c.headAngle, Math.sin(c.perchTimer * 0.03) * 0.12, 0.08);
      c.beakOpen *= 0.8;
      c.wingRaise *= 0.88;
    }

    if (c.actionTimer <= 0) {
      if (c.perchTimer <= 0) {
        startTakeoff(c);
        return;
      }
      const roll = Math.random();
      if (roll < 0.38) {
        c.perchAction = 'caw';
        c.actionTimer = 52;
      } else if (roll < 0.72) {
        c.perchAction = 'flap';
        c.actionTimer = 48;
      } else {
        c.perchAction = 'idle';
        c.actionTimer = 55 + Math.random() * 70;
      }
    }
  }

  function updateTakeoff(c: Crow) {
    c.size = easeToward(c.size, c.flySize, 0.08);
    c.x += c.vx;
    c.y += c.vy;
    c.vy += 0.055;
    c.phase += c.flapSpeed * 1.55;
    c.wingRaise *= 0.8;
    c.takeoffTimer -= 1;
    if (c.takeoffTimer <= 0) {
      c.state = 'flying';
      c.vy = 0;
      c.vx = c.facing * (0.55 + Math.random() * 0.7);
      c.flyTimer = 220 + Math.random() * 280;
      c.wingRaise = 0;
      c.headAngle = 0;
      c.beakOpen = 0;
    }
  }

  function fillCrow(alpha: number) {
    const color = isDay() ? `rgba(22, 16, 12, ${alpha})` : `rgba(8, 8, 11, ${alpha})`;
    crowCtx.fillStyle = color;
    crowCtx.strokeStyle = color;
  }

  function drawFlyingCrow(c: Crow) {
    const s = c.size;
    const flap = Math.sin(c.phase);
    crowCtx.save();
    crowCtx.translate(c.x, c.y);
    crowCtx.scale(c.facing, 1);
    fillCrow(c.alpha);
    crowCtx.lineJoin = 'round';
    crowCtx.lineCap = 'round';

    // Far wing
    crowCtx.beginPath();
    crowCtx.moveTo(-s * 0.05, 0);
    crowCtx.quadraticCurveTo(-s * 0.15, -flap * s * 0.85, -s * 0.95, -flap * s * 1.05);
    crowCtx.lineTo(-s * 1.15, -flap * s * 1.05 + s * 0.18);
    crowCtx.lineTo(-s * 0.7, -flap * s * 0.55);
    crowCtx.quadraticCurveTo(-s * 0.15, s * 0.08, 0, s * 0.06);
    crowCtx.fill();

    // Tail
    crowCtx.beginPath();
    crowCtx.moveTo(-s * 0.45, 0);
    crowCtx.lineTo(-s * 1.15, -s * 0.18);
    crowCtx.lineTo(-s * 0.95, 0.02 * s);
    crowCtx.lineTo(-s * 1.12, s * 0.22);
    crowCtx.closePath();
    crowCtx.fill();

    // Body
    crowCtx.beginPath();
    crowCtx.ellipse(0, 0, s * 0.62, s * 0.26, -0.08, 0, Math.PI * 2);
    crowCtx.fill();

    // Head + beak
    crowCtx.beginPath();
    crowCtx.ellipse(s * 0.58, -s * 0.06, s * 0.24, s * 0.2, 0, 0, Math.PI * 2);
    crowCtx.fill();
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.78, -s * 0.08);
    crowCtx.lineTo(s * 1.08, -s * 0.01);
    crowCtx.lineTo(s * 0.78, s * 0.05);
    crowCtx.closePath();
    crowCtx.fill();

    // Near wing
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.08, 0);
    crowCtx.quadraticCurveTo(s * 0.2, flap * s * 0.9, s * 0.15, -flap * s * 0.15);
    crowCtx.quadraticCurveTo(-s * 0.05, -flap * s * 1.15, -s * 0.85, -flap * s * 1.25);
    crowCtx.lineTo(-s * 1.05, -flap * s * 1.2 + s * 0.2);
    crowCtx.lineTo(-s * 0.55, -flap * s * 0.45);
    crowCtx.quadraticCurveTo(s * 0.05, s * 0.12, s * 0.2, s * 0.04);
    crowCtx.fill();

    crowCtx.restore();
  }

  function drawPerchedCrow(c: Crow) {
    const s = c.size * 1.05;
    crowCtx.save();
    crowCtx.translate(c.x, c.y);
    crowCtx.scale(c.facing, 1);
    fillCrow(Math.min(1, c.alpha + 0.05));

    // Contact shadow on the component edge
    crowCtx.fillStyle = 'rgba(0, 0, 0, 0.28)';
    crowCtx.beginPath();
    crowCtx.ellipse(0, 1.5, s * 0.38, 2.1, 0, 0, Math.PI * 2);
    crowCtx.fill();
    fillCrow(Math.min(1, c.alpha + 0.05));

    crowCtx.lineCap = 'round';
    crowCtx.lineJoin = 'round';
    crowCtx.lineWidth = Math.max(1.1, s * 0.08);

    // Legs + feet
    crowCtx.beginPath();
    crowCtx.moveTo(-s * 0.1, -s * 0.42);
    crowCtx.lineTo(-s * 0.14, 0);
    crowCtx.lineTo(-s * 0.28, 0);
    crowCtx.moveTo(s * 0.1, -s * 0.4);
    crowCtx.lineTo(s * 0.12, 0);
    crowCtx.lineTo(s * 0.26, 0);
    crowCtx.stroke();

    const bodyY = -s * 0.82;

    // Tail
    crowCtx.beginPath();
    crowCtx.moveTo(-s * 0.2, bodyY);
    crowCtx.lineTo(-s * 0.95, bodyY - s * 0.22);
    crowCtx.lineTo(-s * 0.72, bodyY + s * 0.08);
    crowCtx.lineTo(-s * 0.98, bodyY + s * 0.28);
    crowCtx.closePath();
    crowCtx.fill();

    // Body
    crowCtx.beginPath();
    crowCtx.ellipse(0, bodyY, s * 0.42, s * 0.36, -0.35, 0, Math.PI * 2);
    crowCtx.fill();

    // Wing — folded, or raised while stretching
    if (c.wingRaise > 0.12) {
      const lift = bodyY - c.wingRaise * s * 1.15;
      crowCtx.beginPath();
      crowCtx.moveTo(-s * 0.05, bodyY);
      crowCtx.quadraticCurveTo(-s * 0.35, lift, s * 0.12, lift - s * 0.12);
      crowCtx.lineTo(s * 0.28, lift + s * 0.08);
      crowCtx.quadraticCurveTo(s * 0.05, bodyY - s * 0.1, s * 0.18, bodyY + s * 0.05);
      crowCtx.closePath();
      crowCtx.fill();
    } else {
      crowCtx.beginPath();
      crowCtx.ellipse(s * 0.04, bodyY + s * 0.04, s * 0.32, s * 0.2, 0.45, 0, Math.PI * 2);
      crowCtx.fill();
    }

    // Head
    crowCtx.save();
    crowCtx.translate(s * 0.32, bodyY - s * 0.28);
    crowCtx.rotate(c.headAngle);
    crowCtx.beginPath();
    crowCtx.ellipse(0, 0, s * 0.26, s * 0.22, 0.1, 0, Math.PI * 2);
    crowCtx.fill();

    // Beak (opens when cawing)
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.2, -s * 0.04);
    crowCtx.lineTo(s * 0.5, -s * 0.06 - c.beakOpen * s * 0.1);
    crowCtx.lineTo(s * 0.2, s * 0.03);
    crowCtx.closePath();
    crowCtx.fill();
    if (c.beakOpen > 0.35) {
      crowCtx.beginPath();
      crowCtx.moveTo(s * 0.2, s * 0.02);
      crowCtx.lineTo(s * 0.48, s * 0.1 + c.beakOpen * s * 0.08);
      crowCtx.lineTo(s * 0.2, s * 0.08);
      crowCtx.closePath();
      crowCtx.fill();

      crowCtx.strokeStyle = 'rgba(210, 200, 180, 0.4)';
      crowCtx.lineWidth = 1;
      crowCtx.beginPath();
      crowCtx.moveTo(s * 0.52, -s * 0.16);
      crowCtx.lineTo(s * 0.78, -s * 0.3);
      crowCtx.moveTo(s * 0.54, -s * 0.02);
      crowCtx.lineTo(s * 0.82, -s * 0.08);
      crowCtx.stroke();
    }
    crowCtx.restore();
    crowCtx.restore();
  }

  function drawCrow(c: Crow) {
    if (c.state === 'perched' || c.state === 'landing') drawPerchedCrow(c);
    else drawFlyingCrow(c);
  }

  function drawCrows() {
    crowBackCtx.clearRect(0, 0, logicalW, logicalH);
    crowFrontCtx.clearRect(0, 0, logicalW, logicalH);
    for (const c of crows) {
      if (c.state === 'flying') updateFlying(c);
      else if (c.state === 'approaching') updateApproaching(c);
      else if (c.state === 'landing') updateLanding(c);
      else if (c.state === 'perched') updatePerched(c);
      else updateTakeoff(c);
      const onLedge = c.state === 'perched' || c.state === 'landing';
      crowCtx = onLedge ? crowFrontCtx : crowBackCtx;
      drawCrow(c);
    }
  }

  /* ── Lightning ── */
  const lightning = document.getElementById('lightning')!;
  const nightSky = document.querySelector('.stack-sky') as HTMLElement;
  function flashSky(ms: number) {
    lightning.classList.add('flash');
    nightSky.classList.add('flash');
    setTimeout(() => {
      lightning.classList.remove('flash');
      nightSky.classList.remove('flash');
    }, ms);
  }
  function scheduleLightning() {
    const delay = 8000 + Math.random() * 18000;
    setTimeout(() => {
      if (!isDay()) {
        flashSky(90);
        if (Math.random() < 0.5) {
          setTimeout(() => flashSky(60), 180);
        }
      }
      scheduleLightning();
    }, delay);
  }

  /* ── Loop ── */
  function loop() {
    if (isDay()) {
      drawLeaves();
    } else {
      drawRain();
    }
    drawCrows();
    requestAnimationFrame(loop);
  }

  if (!reduced) {
    initRain();
    initLeaves();
    initCrows();
    scheduleLightning();
    window.addEventListener('resize', () => {
      initRain();
      initLeaves();
      sizeCrowCanvas();
    });
    requestAnimationFrame(loop);
  }
</script>
