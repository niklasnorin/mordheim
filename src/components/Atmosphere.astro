---
import Icon from './Icon.astro';
// Atmospheric layers: rain, crows, fog, lightning, vignette (night)
// and autumn leaves, foggy city skyline (day) — with a day/night switch
---

<canvas id="rain-canvas" aria-hidden="true"></canvas>
<canvas id="leaf-canvas" aria-hidden="true"></canvas>
<canvas id="crow-canvas" aria-hidden="true"></canvas>
<canvas id="crow-canvas-front" aria-hidden="true"></canvas>
<!-- Tall vertical backdrop: sky + city outline on top, black earth in the middle,
     the graveyard at the bottom. The viewport pans down through it as the page scrolls. -->
<div class="backdrop" aria-hidden="true">
  <div class="backdrop-stack">
    <div class="stack-sky" style={`--sky-img: url(${import.meta.env.BASE_URL}/day-skyline.jpg)`}>
      <div class="day-fog"></div>
    </div>
    <div class="stack-gap"></div>
    <div class="stack-grave" style={`--grave-img: url(${import.meta.env.BASE_URL}/graveyard.jpg)`}></div>
  </div>
</div>
<div class="fog" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>
<div class="lightning" id="lightning" aria-hidden="true"></div>
<button id="theme-toggle" type="button" aria-label="Autumn day" aria-pressed="false" title="Switch to autumn day">
  <span class="icon-night" aria-hidden="true"><Icon name="moon" size={18} /></span>
  <span class="icon-day" aria-hidden="true"><Icon name="sun" size={18} /></span>
</button>

<style>
  #rain-canvas,
  #leaf-canvas,
  #crow-canvas,
  #crow-canvas-front {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #rain-canvas { z-index: 5; opacity: 0.35; }
  #leaf-canvas { z-index: 5; display: none; }
  #crow-canvas { z-index: 4; }
  #crow-canvas-front { z-index: 12; }

  :global([data-theme='day']) #rain-canvas { display: none; }
  :global([data-theme='day']) #leaf-canvas { display: block; }

  /* ── Scrolling backdrop stack ──
     Three bands stacked vertically, together taller than the viewport:
       sky + city outline (100vh) → black earth (45vh) → graveyard (100vh).
     JS sets --backdrop-progress (0 at page top → 1 as the graveyard section
     arrives) and the stack is translated up so the viewport pans down through it. */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }
  .backdrop-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    /* 100vh + 45vh + 100vh */
    height: 245vh;
    transform: translateY(calc(var(--backdrop-progress, 0) * -145vh));
    will-change: transform;
  }
  .stack-sky,
  .stack-gap,
  .stack-grave {
    position: relative;
    width: 100%;
  }
  .stack-sky {
    height: 100vh;
    background-image: var(--sky-img);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center bottom;
    filter: saturate(0.15) brightness(0.22) contrast(1.35);
    transition: filter 0.07s linear;
  }
  :global([data-theme='day']) .stack-sky {
    filter: saturate(0.8) brightness(1) contrast(1);
  }
  /* Night veil — almost black, so only a ghost of the rooftops reads. */
  .stack-sky::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #030504;
    opacity: 0.82;
    transition: opacity 0.07s linear;
  }
  :global([data-theme='day']) .stack-sky::before { opacity: 0; }
  .stack-sky.flash {
    filter: saturate(0.35) brightness(0.55) contrast(1.45);
  }
  .stack-sky.flash::before { opacity: 0.42; }
  /* Painted last, so it sits over both the skyline and the fog:
     the bottom of the outline is always solid black. */
  .stack-sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, #030504 85%, #030504 100%);
  }
  .stack-gap {
    height: 45vh;
    background: #030504;
  }
  .stack-grave {
    height: 100vh;
    background-image: var(--grave-img);
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center bottom;
  }
  .stack-grave::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, #030504 0%, transparent 45%);
  }

  /* Low fog hugging the rooftops. Lives inside the sky band so it scrolls away
     with the outline and is capped by the band's black gradient below. */
  .day-fog {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 55%;
    pointer-events: none;
    display: none;
    background:
      linear-gradient(to top, rgba(196, 206, 210, 0.55), rgba(196, 206, 210, 0.25) 45%, transparent),
      radial-gradient(ellipse 70% 50% at 30% 100%, rgba(210, 218, 222, 0.4), transparent),
      radial-gradient(ellipse 60% 45% at 75% 95%, rgba(200, 210, 216, 0.35), transparent);
    animation: fog-drift 50s ease-in-out infinite alternate;
  }
  :global([data-theme='day']) .day-fog { display: block; }

  .fog {
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 40% at 20% 90%, rgba(120, 130, 145, 0.06), transparent),
      radial-gradient(ellipse 70% 35% at 80% 85%, rgba(120, 130, 145, 0.05), transparent);
    animation: fog-drift 40s ease-in-out infinite alternate;
  }
  @keyframes fog-drift {
    from { transform: translateX(-2%); }
    to   { transform: translateX(2%); }
  }
  :global([data-theme='day']) .fog { display: none; }

  .vignette {
    position: fixed;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  }
  :global([data-theme='day']) .vignette {
    background: radial-gradient(ellipse at center, transparent 65%, rgba(40, 52, 64, 0.35) 100%);
  }

  .lightning {
    position: fixed;
    inset: 0;
    z-index: 6;
    pointer-events: none;
    background: rgba(200, 215, 235, 0);
    transition: background 0.08s;
  }
  .lightning.flash { background: rgba(200, 215, 235, 0.12); }
  :global([data-theme='day']) .lightning { display: none; }

  /* ── Minimalistic day/night switch ── */
  #theme-toggle {
    position: fixed;
    top: 1.35rem;
    right: 1rem;
    z-index: 100;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    line-height: 1;
    color: var(--gold);
    background: #111915ee;
    border: 1px solid var(--border);
    border-radius: 2px;
    cursor: pointer;
    transition: color 0.25s, box-shadow 0.25s;
  }
  #theme-toggle:hover {
    color: var(--parchment);
    box-shadow: 0 0 12px rgba(184, 150, 62, 0.35);
  }
  #theme-toggle .icon-day { display: none; }
  :global([data-theme='day']) #theme-toggle .icon-day { display: inline; }
  :global([data-theme='day']) #theme-toggle .icon-night { display: none; }

  @media (max-width: 900px) {
    #theme-toggle { top: .5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #rain-canvas, #leaf-canvas, #crow-canvas, #crow-canvas-front { display: none !important; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Day/night switch ── */
  const root = document.documentElement;
  const isDay = () => root.dataset.theme === 'day';
  const themeToggle = document.getElementById('theme-toggle')!;
  function updateThemeControl() {
    themeToggle.setAttribute('aria-pressed', String(isDay()));
    themeToggle.title = isDay() ? 'Switch to stormy night' : 'Switch to autumn day';
  }
  updateThemeControl();

  themeToggle.addEventListener('click', () => {
    if (isDay()) {
      delete root.dataset.theme;
    } else {
      root.dataset.theme = 'day';
    }
    updateThemeControl();
    try {
      localStorage.setItem('mordheim-theme', isDay() ? 'day' : 'night');
    } catch {}
  });

  /* ── Scroll-driven backdrop ──
     The stack is 145vh taller than the viewport (100vh sky + 45vh black + 100vh
     graves). Graveyard art starts 145vh down the stack, so it first touches the
     fold at progress = 45/145. We hold there until #graveyard itself reaches the
     fold, then finish the pan as that section comes on screen. */
  const graveyardSection = document.getElementById('graveyard');
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const REVEAL = 45 / 145;

  let scrollQueued = false;
  function updateScrollVars() {
    scrollQueued = false;
    const vh = window.innerHeight;
    const doc = document.documentElement;
    const scrollY = window.scrollY;

    const graveTop = graveyardSection
      ? graveyardSection.getBoundingClientRect().top + scrollY
      : doc.scrollHeight;
    const revealStart = Math.max(1, graveTop - vh);
    const revealEnd = Math.max(revealStart + 1, graveTop - vh * 0.25);

    let progress: number;
    if (scrollY <= revealStart) {
      progress = REVEAL * clamp01(scrollY / revealStart);
    } else {
      progress = REVEAL + (1 - REVEAL) * clamp01((scrollY - revealStart) / (revealEnd - revealStart));
    }
    root.style.setProperty('--backdrop-progress', progress.toFixed(4));
  }
  function queueScrollUpdate() {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(updateScrollVars);
  }
  window.addEventListener('scroll', queueScrollUpdate, { passive: true });
  window.addEventListener('resize', queueScrollUpdate);
  updateScrollVars();

  /* ── Rain ── */
  const rainCanvas = document.getElementById('rain-canvas') as HTMLCanvasElement;
  const rainCtx = rainCanvas.getContext('2d')!;

  interface Drop { x: number; y: number; len: number; speed: number; drift: number; }
  let drops: Drop[] = [];

  function sizeCanvas(c: HTMLCanvasElement) {
    c.width = window.innerWidth;
    c.height = window.innerHeight;
  }

  function initRain() {
    sizeCanvas(rainCanvas);
    const count = Math.floor((rainCanvas.width * rainCanvas.height) / 9000);
    drops = Array.from({ length: count }, () => ({
      x: Math.random() * rainCanvas.width,
      y: Math.random() * rainCanvas.height,
      len: 8 + Math.random() * 16,
      speed: 9 + Math.random() * 10,
      drift: 1 + Math.random() * 1.5,
    }));
  }

  function drawRain() {
    rainCtx.clearRect(0, 0, rainCanvas.width, rainCanvas.height);
    rainCtx.strokeStyle = 'rgba(170, 190, 210, 0.35)';
    rainCtx.lineWidth = 1;
    for (const d of drops) {
      rainCtx.beginPath();
      rainCtx.moveTo(d.x, d.y);
      rainCtx.lineTo(d.x - d.drift, d.y + d.len);
      rainCtx.stroke();
      d.y += d.speed;
      d.x -= d.drift;
      if (d.y > rainCanvas.height) {
        d.y = -d.len;
        d.x = Math.random() * (rainCanvas.width + 100);
      }
    }
  }

  /* ── Autumn leaves ── */
  const leafCanvas = document.getElementById('leaf-canvas') as HTMLCanvasElement;
  const leafCtx = leafCanvas.getContext('2d')!;

  const LEAF_COLORS = ['#b96b32', '#ce9845', '#a34f32', '#d5ae59', '#94603b', '#bf7839'];
  const leafShapes = [
    new Path2D('M -1 0 C -.6 -.55 .2 -.7 1 0 C .35 .55 -.45 .65 -1 0 Z'),
    new Path2D('M -1 0 L -.65 -.18 L -.78 -.48 L -.33 -.4 L -.25 -.8 L .06 -.48 L .55 -.85 L .48 -.32 L 1 0 L .48 .26 L .55 .7 L .05 .48 L -.28 .72 L -.36 .35 L -.8 .42 L -.65 .15 Z'),
  ];

  interface Leaf {
    x: number; y: number; vx: number; vy: number;
    size: number; angle: number; spin: number;
    sway: number; swaySpeed: number; color: string;
    tumble: number; tumbleSpeed: number; depth: number; shape: number;
  }
  let leaves: Leaf[] = [];
  let leafW = 0;
  let leafH = 0;
  let leafDpr = 0;

  function spawnLeaf(offscreen = true): Leaf {
    const depth = 0.45 + Math.random() * 0.55;
    return {
      x: offscreen ? leafW + 30 + Math.random() * 100 : Math.random() * leafW,
      y: Math.random() * leafH,
      vx: -(24 + Math.random() * 32) * depth,
      vy: (20 + Math.random() * 25) * depth,
      size: (8 + Math.random() * 7) * depth,
      angle: Math.random() * Math.PI * 2,
      spin: (Math.random() - 0.5) * 1.2,
      sway: Math.random() * Math.PI * 2,
      swaySpeed: 0.7 + Math.random() * 0.8,
      color: LEAF_COLORS[Math.floor(Math.random() * LEAF_COLORS.length)]!,
      tumble: Math.random() * Math.PI * 2,
      tumbleSpeed: 0.8 + Math.random() * 1.3,
      depth,
      shape: Math.random() < 0.55 ? 0 : 1,
    };
  }

  function resizeLeaves() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const width = window.innerWidth;
    const height = window.innerHeight;
    if (width === leafW && height === leafH && dpr === leafDpr) return;
    const initial = leafW === 0;
    leafW = width;
    leafH = height;
    leafDpr = dpr;
    leafCanvas.width = Math.round(width * dpr);
    leafCanvas.height = Math.round(height * dpr);
    leafCanvas.style.width = `${width}px`;
    leafCanvas.style.height = `${height}px`;
    leafCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.min(70, Math.ceil(width * height / 28000));
    // Mobile browser chrome resizes the viewport while scrolling. Keep existing
    // particles in CSS-pixel coordinates instead of reseeding or stretching them.
    while (leaves.length < count) leaves.push(spawnLeaf(!initial));
  }

  function drawLeaf(l: Leaf) {
    const turn = Math.cos(l.tumble);
    leafCtx.save();
    leafCtx.translate(l.x, l.y);
    leafCtx.rotate(l.angle + Math.sin(l.sway) * 0.3);
    leafCtx.scale(l.size, l.size * (0.18 + Math.abs(turn) * 0.82));
    leafCtx.fillStyle = l.color;
    leafCtx.globalAlpha = 0.5 + l.depth * 0.4;
    leafCtx.fill(leafShapes[l.shape]!);
    leafCtx.fillStyle = turn > 0 ? 'rgba(255, 221, 148, 0.16)' : 'rgba(70, 32, 19, 0.2)';
    leafCtx.fill(leafShapes[l.shape]!);
    leafCtx.strokeStyle = 'rgba(80, 42, 24, 0.55)';
    leafCtx.lineWidth = 0.055;
    leafCtx.lineCap = 'round';
    leafCtx.stroke(leafShapes[l.shape]!);
    leafCtx.beginPath();
    leafCtx.moveTo(-1.28, 0.12);
    leafCtx.quadraticCurveTo(-0.6, -0.05, 0.85, 0);
    for (const x of [-0.45, -0.05, 0.35]) {
      leafCtx.moveTo(x - 0.15, 0);
      leafCtx.lineTo(x + 0.12, -0.26);
      leafCtx.moveTo(x - 0.15, 0);
      leafCtx.lineTo(x + 0.12, 0.26);
    }
    leafCtx.stroke();
    leafCtx.restore();
  }

  function drawLeaves(dt: number) {
    leafCtx.clearRect(0, 0, leafW, leafH);
    const count = Math.min(70, Math.ceil(leafW * leafH / 28000));
    for (let i = leaves.length - 1; i >= 0; i--) {
      const l = leaves[i]!;
      l.sway += l.swaySpeed * dt;
      l.tumble += l.tumbleSpeed * dt;
      l.x += (l.vx + Math.sin(l.sway) * 18 * l.depth) * dt;
      l.y += (l.vy + Math.cos(l.sway * 0.7) * 10 * l.depth) * dt;
      l.angle += l.spin * dt;
      drawLeaf(l);
      if (l.x < -40 || l.y > leafH + 40) {
        if (leaves.length > count) {
          leaves.splice(i, 1);
          continue;
        }
        leaves[i] = spawnLeaf();
        if (Math.random() < 0.4) {
          leaves[i]!.x = Math.random() * leafW;
          leaves[i]!.y = -30;
        }
      }
    }
  }

  /* ── Crows ──
     Distant flock stays in the sky. Nearer birds fly across the page,
     land on UI edges, settle / look / stretch, then take off again. */
  const crowCanvas = document.getElementById('crow-canvas') as HTMLCanvasElement;
  const crowFrontCanvas = document.getElementById('crow-canvas-front') as HTMLCanvasElement;
  const crowBackCtx = crowCanvas.getContext('2d')!;
  const crowFrontCtx = crowFrontCanvas.getContext('2d')!;
  let crowCtx = crowBackCtx;

  type CrowState = 'flying' | 'approaching' | 'landing' | 'perched' | 'taking-off';
  type PerchAction = 'idle' | 'look' | 'stretch';

  interface PerchSpot {
    id: string;
    el: Element;
    t: number;
    edge: 'top' | 'bottom';
  }

  const PERCH_TARGETS: { selector: string; edge: 'top' | 'bottom' }[] = [
    { selector: '.header-bar', edge: 'bottom' },
    { selector: '.logo-main', edge: 'top' },
    { selector: '.campaign-bar', edge: 'top' },
    { selector: '.town-cryer', edge: 'top' },
    { selector: '.warband-card', edge: 'top' },
    { selector: '.standings-table', edge: 'top' },
    { selector: '.timeline-entry', edge: 'top' },
    { selector: '.section-title', edge: 'top' },
    { selector: '.tombstone-stone', edge: 'top' },
    { selector: '.panel', edge: 'top' },
    { selector: '.site-footer', edge: 'top' },
  ];

  interface Crow {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    flySize: number;
    approachDist: number;
    phase: number;
    motionTime: number;
    flightTimer: number;
    gliding: boolean;
    glideMix: number;
    landingBlend: number;
    flapSpeed: number;
    facing: number;
    canLand: boolean;
    alpha: number;
    state: CrowState;
    target: PerchSpot | null;
    flyTimer: number;
    perchTimer: number;
    actionTimer: number;
    perchAction: PerchAction;
    headAngle: number;
    beakOpen: number;
    wingRaise: number;
    takeoffTimer: number;
  }

  const LAND_SIZE = 18;

  let crows: Crow[] = [];
  const occupied = new Set<string>();
  let nextPerchKey = 1;
  let logicalW = 0;
  let logicalH = 0;

  function sizeCrowLayer(canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D, dpr: number) {
    canvas.width = Math.floor(logicalW * dpr);
    canvas.height = Math.floor(logicalH * dpr);
    canvas.style.width = `${logicalW}px`;
    canvas.style.height = `${logicalH}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function sizeCrowCanvas() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    logicalW = window.innerWidth;
    logicalH = window.innerHeight;
    sizeCrowLayer(crowCanvas, crowBackCtx, dpr);
    sizeCrowLayer(crowFrontCanvas, crowFrontCtx, dpr);
  }

  function fillAlpha(color: string): number {
    if (!color || color === 'transparent') return 0;
    const rgba = color.match(/^rgba?\((.+)\)$/i);
    if (rgba) {
      const parts = rgba[1].split(',').map((part) => parseFloat(part));
      return parts.length >= 4 ? parts[3]! : 1;
    }
    return 1;
  }

  function hasOpaqueFill(el: Element): boolean {
    const style = getComputedStyle(el);
    if (style.visibility === 'hidden' || style.display === 'none') return false;
    if (parseFloat(style.opacity) < 0.08) return false;
    if (fillAlpha(style.backgroundColor) > 0.08) return true;
    return Boolean(style.backgroundImage && style.backgroundImage !== 'none');
  }

  function perchId(el: Element, spot: number) {
    const node = el as HTMLElement;
    if (!node.dataset.perchKey) {
      node.dataset.perchKey = String(nextPerchKey++);
    }
    return `${node.dataset.perchKey}:${spot}`;
  }

  function perchPos(spot: PerchSpot) {
    const r = spot.el.getBoundingClientRect();
    const pad = 18;
    const y = spot.edge === 'bottom' ? r.bottom : r.top + 2;
    return {
      x: r.left + r.width * spot.t,
      y,
      visible:
        r.width > 48 &&
        y > 20 &&
        y < logicalH - 12 &&
        r.right > pad &&
        r.left < logicalW - pad,
    };
  }

  function collectPerches(): PerchSpot[] {
    const spots: PerchSpot[] = [];
    for (const target of PERCH_TARGETS) {
      document.querySelectorAll(target.selector).forEach((el) => {
        const r = el.getBoundingClientRect();
        if (r.width < 48 || r.height < 12 || !hasOpaqueFill(el)) return;
        const count = Math.max(1, Math.min(3, Math.floor(r.width / 200)));
        for (let i = 0; i < count; i++) {
          const t = (i + 1) / (count + 1);
          const spot: PerchSpot = { id: perchId(el, i), el, t, edge: target.edge };
          if (perchPos(spot).visible && !occupied.has(spot.id)) spots.push(spot);
        }
      });
    }
    return spots;
  }

  function perchedCount() {
    return crows.filter((c) => c.state === 'perched' || c.state === 'landing' || c.state === 'approaching').length;
  }

  function spawnCrow(offscreen: boolean, canLand: boolean): Crow {
    const leftward = Math.random() < 0.5;
    const facing = leftward ? -1 : 1;
    const flySize = canLand ? 8 + Math.random() * 3.5 : 6 + Math.random() * 5;
    return {
      x: offscreen ? (leftward ? logicalW + 50 : -50) : Math.random() * logicalW,
      y: canLand
        ? 40 + Math.random() * logicalH * 0.45
        : 24 + Math.random() * logicalH * 0.28,
      vx: facing * (canLand ? 0.55 + Math.random() * 0.7 : 0.35 + Math.random() * 0.55),
      vy: 0,
      size: flySize,
      flySize,
      approachDist: 0,
      phase: Math.random() * Math.PI * 2,
      motionTime: Math.random() * 600,
      flightTimer: 90 + Math.random() * 110,
      gliding: false,
      glideMix: 0,
      landingBlend: 0,
      flapSpeed: 0.17 + Math.random() * 0.055,
      facing,
      canLand,
      alpha: canLand ? 0.96 : 0.68,
      state: 'flying',
      target: null,
      flyTimer: canLand ? 90 + Math.random() * 220 : 99999,
      perchTimer: 0,
      actionTimer: 0,
      perchAction: 'idle',
      headAngle: 0,
      beakOpen: 0,
      wingRaise: 0,
      takeoffTimer: 0,
    };
  }

  function initCrows() {
    sizeCrowCanvas();
    occupied.clear();
    crows = [
      ...Array.from({ length: 5 }, () => spawnCrow(false, false)),
      ...Array.from({ length: 3 }, () => spawnCrow(false, true)),
    ];
  }

  function easeToward(current: number, target: number, amount: number) {
    return current + (target - current) * amount;
  }

  function startTakeoff(c: Crow) {
    if (c.target) occupied.delete(c.target.id);
    c.target = null;
    c.state = 'taking-off';
    c.takeoffTimer = 42;
    c.facing = Math.random() < 0.5 ? -1 : 1;
    c.vx = c.facing * (1.15 + Math.random() * 0.55);
    c.vy = -2.4;
    c.beakOpen = 0;
    c.headAngle = 0;
    c.approachDist = 0;
    c.glideMix = 0;
    c.gliding = false;
    c.flightTimer = 80 + Math.random() * 120;
    c.y -= c.size * 1.05 * 0.82;
  }

  function updateFlying(c: Crow) {
    c.size = easeToward(c.size, c.flySize, 0.05);
    c.flightTimer -= 1;
    if (c.flightTimer <= 0) {
      c.gliding = !c.gliding;
      c.flightTimer = c.gliding ? 45 + Math.random() * 100 : 100 + Math.random() * 140;
    }
    c.glideMix = easeToward(c.glideMix, c.gliding ? 1 : 0, 0.055);
    c.x += c.vx * (1 + Math.sin(c.motionTime * 0.017) * 0.08);
    c.vy = easeToward(c.vy, Math.sin(c.motionTime * 0.013) * 0.32 + c.glideMix * 0.045, 0.035);
    c.y += c.vy;
    c.phase += c.flapSpeed * (1 - c.glideMix * 0.82);
    c.facing = c.vx >= 0 ? 1 : -1;
    c.flyTimer -= 1;

    if (c.canLand && c.flyTimer <= 0 && perchedCount() < 2) {
      const options = collectPerches();
      if (options.length) {
        const spot = options[Math.floor(Math.random() * options.length)]!;
        occupied.add(spot.id);
        c.target = spot;
        c.approachDist = 0;
        c.state = 'approaching';
      } else {
        c.flyTimer = 80 + Math.random() * 160;
      }
    }

    if (c.x < -70 || c.x > logicalW + 70) {
      const next = spawnCrow(true, c.canLand);
      Object.assign(c, next);
    }
  }

  function updateApproaching(c: Crow) {
    if (!c.target) {
      c.state = 'flying';
      return;
    }
    const p = perchPos(c.target);
    if (!p.visible || !hasOpaqueFill(c.target.el)) {
      occupied.delete(c.target.id);
      c.target = null;
      c.approachDist = 0;
      c.state = 'flying';
      c.flyTimer = 100;
      return;
    }

    const destX = p.x;
    // Flight is body-centred; the ledge pose is anchored at the feet.
    const destY = p.y - LAND_SIZE * 1.05 * 0.82;
    const dx = destX - c.x;
    const dy = destY - c.y;
    const dist = Math.hypot(dx, dy) || 1;
    if (c.approachDist <= 0) c.approachDist = Math.max(dist, 80);
    const t = 1 - Math.min(1, dist / c.approachDist);
    const eased = t * t * (3 - 2 * t);
    c.size = c.flySize + (LAND_SIZE - c.flySize) * eased;

    c.glideMix = easeToward(c.glideMix, 0, 0.12);
    if (dist < 2) {
      c.y += c.size * 1.05 * 0.82;
      c.landingBlend = 0;
      c.state = 'landing';
      return;
    }

    const speed = Math.min(2.4, 0.16 + dist * 0.035);
    c.vx = easeToward(c.vx, (dx / dist) * speed, 0.12);
    c.vy = easeToward(c.vy, (dy / dist) * speed, 0.12);
    if (Math.abs(c.vx) > 0.12) c.facing = c.vx >= 0 ? 1 : -1;
    c.x += c.vx;
    c.y += c.vy;
    c.phase += c.flapSpeed * 1.15;
  }

  function updateLanding(c: Crow) {
    if (!c.target) {
      c.state = 'flying';
      return;
    }
    const p = perchPos(c.target);
    if (!p.visible || !hasOpaqueFill(c.target.el)) {
      startTakeoff(c);
      return;
    }
    c.size = easeToward(c.size, LAND_SIZE, 0.2);
    c.landingBlend = Math.min(1, c.landingBlend + 0.055);
    c.x = easeToward(c.x, p.x, 0.2);
    c.y = easeToward(c.y, p.y, 0.2);
    c.phase += c.flapSpeed * 0.55;
    if (Math.hypot(p.x - c.x, p.y - c.y) < 0.3 && c.landingBlend === 1) {
      c.x = p.x;
      c.y = p.y;
      c.vx = 0;
      c.vy = 0;
      c.state = 'perched';
      c.perchTimer = 200 + Math.random() * 260;
      c.perchAction = 'idle';
      c.actionTimer = 90 + Math.random() * 120;
      c.wingRaise = 0;
    }
  }

  function updatePerched(c: Crow) {
    if (!c.target) {
      startTakeoff(c);
      return;
    }
    const p = perchPos(c.target);
    if (!p.visible) {
      startTakeoff(c);
      return;
    }
    c.x = p.x;
    c.y = p.y;
    c.size = LAND_SIZE;
    c.perchTimer -= 1;
    c.actionTimer -= 1;

    if (c.perchAction === 'look') {
      c.headAngle = easeToward(c.headAngle, c.actionTimer > 35 ? -0.24 : 0.1, 0.065);
      c.wingRaise *= 0.9;
    } else if (c.perchAction === 'stretch') {
      c.wingRaise = easeToward(c.wingRaise, Math.sin(Math.PI * Math.max(0, c.actionTimer) / 90) * 0.65, 0.1);
      c.headAngle = easeToward(c.headAngle, 0.08, 0.06);
    } else {
      c.headAngle = easeToward(c.headAngle, Math.sin(c.motionTime * 0.016) * 0.045, 0.04);
      c.beakOpen *= 0.8;
      c.wingRaise *= 0.88;
    }

    if (c.actionTimer <= 0) {
      if (c.perchTimer <= 0) {
        startTakeoff(c);
        return;
      }
      const roll = Math.random();
      if (roll < 0.35) {
        c.perchAction = 'look';
        c.actionTimer = 75;
      } else if (roll < 0.48) {
        c.perchAction = 'stretch';
        c.actionTimer = 90;
      } else {
        c.perchAction = 'idle';
        c.actionTimer = 110 + Math.random() * 150;
      }
    }
  }

  function updateTakeoff(c: Crow) {
    c.size = easeToward(c.size, c.flySize, 0.08);
    c.x += c.vx;
    c.y += c.vy;
    c.vy += 0.055;
    c.phase += c.flapSpeed * 1.55;
    c.wingRaise *= 0.8;
    c.takeoffTimer -= 1;
    if (c.takeoffTimer <= 0) {
      c.state = 'flying';
      c.vy = 0;
      c.vx = c.facing * (0.55 + Math.random() * 0.7);
      c.flyTimer = 220 + Math.random() * 280;
      c.wingRaise = 0;
      c.headAngle = 0;
      c.beakOpen = 0;
    }
  }

  function fillCrow(alpha: number) {
    const color = isDay() ? `rgba(30, 28, 29, ${alpha})` : `rgba(53, 59, 69, ${alpha})`;
    crowCtx.fillStyle = color;
    crowCtx.strokeStyle = color;
  }

  function featherHighlight(alpha: number) {
    crowCtx.strokeStyle = isDay()
      ? `rgba(114, 119, 125, ${alpha * 0.24})`
      : `rgba(145, 157, 175, ${alpha * 0.4})`;
    crowCtx.lineWidth = 0.65;
  }

  function drawCrowWing(s: number, lift: number, sweep: number, alpha: number) {
    const wristX = -s * (0.48 + sweep);
    const wristY = lift * s;
    fillCrow(alpha);
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.2, 0);
    crowCtx.quadraticCurveTo(s * 0.14, wristY * 0.5, -s * 0.12, wristY * 0.7);
    crowCtx.quadraticCurveTo(-s * 0.3, wristY * 1.02, wristX, wristY);
    // Unequal primary tips leave a fingered edge without a sawtooth outline.
    crowCtx.lineTo(wristX - s * 0.45, wristY - s * 0.04);
    crowCtx.quadraticCurveTo(wristX - s * 0.54, wristY, wristX - s * 0.25, wristY + s * 0.1);
    crowCtx.lineTo(wristX - s * 0.58, wristY + s * 0.12);
    crowCtx.quadraticCurveTo(wristX - s * 0.64, wristY + s * 0.18, wristX - s * 0.29, wristY + s * 0.2);
    crowCtx.lineTo(wristX - s * 0.59, wristY + s * 0.27);
    crowCtx.quadraticCurveTo(wristX - s * 0.59, wristY + s * 0.33, wristX - s * 0.24, wristY + s * 0.29);
    crowCtx.lineTo(wristX - s * 0.46, wristY + s * 0.39);
    crowCtx.quadraticCurveTo(wristX - s * 0.46, wristY + s * 0.44, wristX - s * 0.12, wristY + s * 0.36);
    crowCtx.quadraticCurveTo(-s * 0.36, wristY * 0.35 + s * 0.26, -s * 0.22, s * 0.18);
    crowCtx.closePath();
    crowCtx.fill();
    featherHighlight(alpha);
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.1, -s * 0.025);
    crowCtx.quadraticCurveTo(-s * 0.08, wristY * 0.62, wristX, wristY + s * 0.06);
    crowCtx.stroke();
  }

  function drawFlyingCrow(c: Crow) {
    const s = c.size;
    const beat = Math.sin(c.phase + Math.sin(c.phase) * 0.24);
    const lift = (-0.18 - beat * 1.05) * (1 - c.glideMix) - c.glideMix * 0.48;
    const sweep = 0.08 + (Math.sin(c.phase - 0.55) + 1) * 0.1 * (1 - c.glideMix);
    crowCtx.save();
    crowCtx.translate(c.x, c.y);
    crowCtx.scale(c.facing, 1);
    crowCtx.rotate(Math.max(-0.2, Math.min(0.2, c.vy * 0.1)) + Math.sin(c.motionTime * 0.019) * 0.025);
    fillCrow(c.alpha);
    crowCtx.lineJoin = 'round';
    crowCtx.lineCap = 'round';

    // Far wing
    crowCtx.save();
    crowCtx.translate(s * 0.16, -s * 0.08);
    drawCrowWing(s * 0.88, lift - Math.cos(c.phase) * 0.12 * (1 - c.glideMix), sweep - 0.16, c.alpha * 0.8);
    crowCtx.restore();
    fillCrow(c.alpha);

    // Tail
    crowCtx.beginPath();
    crowCtx.moveTo(-s * 0.45, 0);
    crowCtx.lineTo(-s * 1.14, -s * 0.12);
    crowCtx.lineTo(-s * 1.2, -s * 0.01);
    crowCtx.lineTo(-s * 1.17, s * 0.1);
    crowCtx.lineTo(-s * 1.06, s * 0.2);
    crowCtx.lineTo(-s * 0.4, s * 0.16);
    crowCtx.closePath();
    crowCtx.fill();

    // Body
    crowCtx.beginPath();
    crowCtx.ellipse(0, 0, s * 0.62, s * 0.26, -0.08, 0, Math.PI * 2);
    crowCtx.fill();

    // Head + beak
    crowCtx.beginPath();
    crowCtx.ellipse(s * 0.58, -s * 0.06, s * 0.24, s * 0.2, 0, 0, Math.PI * 2);
    crowCtx.fill();
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.78, -s * 0.08);
    crowCtx.lineTo(s * 1.08, -s * 0.01);
    crowCtx.lineTo(s * 0.78, s * 0.05);
    crowCtx.closePath();
    crowCtx.fill();

    // Near wing
    drawCrowWing(s, lift, sweep, c.alpha);

    crowCtx.restore();
  }

  function drawPerchedCrow(c: Crow) {
    const s = c.size * 1.05;
    crowCtx.save();
    crowCtx.translate(c.x, c.y);
    crowCtx.scale(c.facing, 1);
    fillCrow(Math.min(1, c.alpha + 0.05));

    // Contact shadow on the component edge
    crowCtx.fillStyle = 'rgba(0, 0, 0, 0.28)';
    crowCtx.beginPath();
    crowCtx.ellipse(0, 1.5, s * 0.38, 2.1, 0, 0, Math.PI * 2);
    crowCtx.fill();
    fillCrow(Math.min(1, c.alpha + 0.05));

    crowCtx.lineCap = 'round';
    crowCtx.lineJoin = 'round';
    crowCtx.lineWidth = Math.max(0.85, s * 0.055);

    // Legs + feet
    crowCtx.beginPath();
    crowCtx.moveTo(-s * 0.1, -s * 0.42);
    crowCtx.lineTo(-s * 0.14, 0);
    crowCtx.lineTo(-s * 0.28, 0);
    crowCtx.moveTo(-s * 0.14, 0);
    crowCtx.lineTo(-s * 0.03, s * 0.025);
    crowCtx.moveTo(s * 0.1, -s * 0.4);
    crowCtx.lineTo(s * 0.12, 0);
    crowCtx.lineTo(s * 0.26, 0);
    crowCtx.moveTo(s * 0.12, 0);
    crowCtx.lineTo(s * 0.04, s * 0.025);
    crowCtx.stroke();

    const bodyY = -s * 0.82 + Math.sin(c.motionTime * 0.035) * s * 0.008;

    // Tail
    crowCtx.beginPath();
    crowCtx.moveTo(-s * 0.2, bodyY);
    crowCtx.lineTo(-s * 0.98, bodyY + s * 0.24);
    crowCtx.lineTo(-s * 0.99, bodyY + s * 0.34);
    crowCtx.lineTo(-s * 0.88, bodyY + s * 0.39);
    crowCtx.lineTo(-s * 0.79, bodyY + s * 0.38);
    crowCtx.lineTo(-s * 0.1, bodyY + s * 0.22);
    crowCtx.closePath();
    crowCtx.fill();

    // Body
    crowCtx.beginPath();
    crowCtx.ellipse(0, bodyY, s * 0.43, s * 0.33, -0.48, 0, Math.PI * 2);
    crowCtx.fill();

    // Wing — folded, or raised while stretching
    if (c.wingRaise > 0.12) {
      crowCtx.save();
      crowCtx.translate(0, bodyY);
      drawCrowWing(s * 0.85, -c.wingRaise * 1.4, 0.06, c.alpha);
      crowCtx.restore();
    }
    crowCtx.fillStyle = isDay() ? `rgba(43, 43, 46, ${c.alpha})` : `rgba(64, 72, 85, ${c.alpha})`;
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.16, bodyY - s * 0.15);
    crowCtx.bezierCurveTo(-s * 0.1, bodyY - s * 0.3, -s * 0.4, bodyY - s * 0.12, -s * 0.62, bodyY + s * 0.25);
    crowCtx.quadraticCurveTo(-s * 0.16, bodyY + s * 0.3, s * 0.16, bodyY + s * 0.06);
    crowCtx.closePath();
    crowCtx.fill();
    featherHighlight(c.alpha);
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.1, bodyY - s * 0.15);
    crowCtx.quadraticCurveTo(-s * 0.17, bodyY - s * 0.2, -s * 0.41, bodyY + s * 0.1);
    crowCtx.moveTo(-s * 0.09, bodyY + s * 0.05);
    crowCtx.lineTo(-s * 0.43, bodyY + s * 0.2);
    crowCtx.moveTo(-s * 0.02, bodyY + s * 0.12);
    crowCtx.lineTo(-s * 0.33, bodyY + s * 0.23);
    crowCtx.stroke();
    fillCrow(c.alpha);

    // Head
    crowCtx.save();
    crowCtx.translate(s * 0.32, bodyY - s * 0.28);
    crowCtx.rotate(c.headAngle);
    crowCtx.beginPath();
    crowCtx.ellipse(0, 0, s * 0.26, s * 0.22, 0.1, 0, Math.PI * 2);
    crowCtx.fill();

    // Heavy, slightly curved bill.
    crowCtx.beginPath();
    crowCtx.moveTo(s * 0.2, -s * 0.04);
    crowCtx.quadraticCurveTo(s * 0.37, -s * 0.075, s * 0.5, s * 0.015);
    crowCtx.lineTo(s * 0.2, s * 0.03);
    crowCtx.closePath();
    crowCtx.fill();
    featherHighlight(c.alpha * 0.65);
    crowCtx.beginPath();
    crowCtx.arc(-s * 0.015, -s * 0.015, s * 0.2, Math.PI * 1.15, Math.PI * 1.75);
    crowCtx.stroke();
    crowCtx.fillStyle = `rgba(14, 17, 22, ${c.alpha})`;
    crowCtx.beginPath();
    crowCtx.arc(s * 0.1, -s * 0.055, s * 0.033, 0, Math.PI * 2);
    crowCtx.fill();
    crowCtx.restore();
    crowCtx.restore();
  }

  function drawCrow(c: Crow) {
    if (c.state === 'landing') {
      crowCtx.save();
      crowCtx.globalAlpha = 1 - c.landingBlend;
      drawFlyingCrow({ ...c, y: c.y - c.size * 1.05 * 0.82 });
      crowCtx.globalAlpha = c.landingBlend;
      drawPerchedCrow(c);
      crowCtx.restore();
    } else if (c.state === 'perched') drawPerchedCrow(c);
    else drawFlyingCrow(c);
  }

  function drawCrows(update = true) {
    crowBackCtx.clearRect(0, 0, logicalW, logicalH);
    crowFrontCtx.clearRect(0, 0, logicalW, logicalH);
    for (const c of crows) {
      if (update) {
        c.motionTime += 1;
        if (c.state === 'flying') updateFlying(c);
        else if (c.state === 'approaching') updateApproaching(c);
        else if (c.state === 'landing') updateLanding(c);
        else if (c.state === 'perched') updatePerched(c);
        else updateTakeoff(c);
      }
      const onLedge = c.state === 'perched' || c.state === 'landing';
      crowCtx = onLedge ? crowFrontCtx : crowBackCtx;
      drawCrow(c);
    }
  }

  /* ── Lightning ── */
  const lightning = document.getElementById('lightning')!;
  const nightSky = document.querySelector('.stack-sky') as HTMLElement;
  function flashSky(ms: number) {
    lightning.classList.add('flash');
    nightSky.classList.add('flash');
    setTimeout(() => {
      lightning.classList.remove('flash');
      nightSky.classList.remove('flash');
    }, ms);
  }
  function scheduleLightning() {
    const delay = 8000 + Math.random() * 18000;
    setTimeout(() => {
      if (!isDay()) {
        flashSky(90);
        if (Math.random() < 0.5) {
          setTimeout(() => flashSky(60), 180);
        }
      }
      scheduleLightning();
    }, delay);
  }

  /* ── Loop ── */
  let lastFrame = 0;
  let crowTime = 0;
  function loop(now: number) {
    const dt = lastFrame ? Math.min((now - lastFrame) / 1000, 0.05) : 0;
    lastFrame = now;
    crowTime += dt * 60;
    const steps = Math.floor(crowTime);
    crowTime -= steps;
    if (isDay()) {
      drawLeaves(dt);
    } else {
      for (let i = 0; i < steps; i++) drawRain();
    }
    drawCrows(steps);
    requestAnimationFrame(loop);
  }

  if (!reduced) {
    initRain();
    resizeLeaves();
    initCrows();
    scheduleLightning();
    window.addEventListener('resize', () => {
      initRain();
      resizeLeaves();
      sizeCrowCanvas();
    });
    requestAnimationFrame(loop);
  }
</script>
