---
// Atmospheric layers: rain, crows, fog, lightning, vignette
---

<canvas id="rain-canvas" aria-hidden="true"></canvas>
<canvas id="crow-canvas" aria-hidden="true"></canvas>
<div class="fog" aria-hidden="true"></div>
<div class="vignette" aria-hidden="true"></div>
<div class="lightning" id="lightning" aria-hidden="true"></div>

<style>
  #rain-canvas,
  #crow-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  #rain-canvas { z-index: 50; opacity: 0.55; }
  #crow-canvas { z-index: 4; }

  .fog {
    position: fixed;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 40% at 20% 90%, rgba(120, 130, 145, 0.06), transparent),
      radial-gradient(ellipse 70% 35% at 80% 85%, rgba(120, 130, 145, 0.05), transparent);
    animation: fog-drift 40s ease-in-out infinite alternate;
  }
  @keyframes fog-drift {
    from { transform: translateX(-2%); }
    to   { transform: translateX(2%); }
  }

  .vignette {
    position: fixed;
    inset: 0;
    z-index: 60;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  }

  .lightning {
    position: fixed;
    inset: 0;
    z-index: 55;
    pointer-events: none;
    background: rgba(200, 215, 235, 0);
    transition: background 0.08s;
  }
  .lightning.flash { background: rgba(200, 215, 235, 0.12); }

  @media (prefers-reduced-motion: reduce) {
    #rain-canvas, #crow-canvas { display: none; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Rain ── */
  const rainCanvas = document.getElementById('rain-canvas') as HTMLCanvasElement;
  const rainCtx = rainCanvas.getContext('2d')!;

  interface Drop { x: number; y: number; len: number; speed: number; drift: number; }
  let drops: Drop[] = [];

  function sizeCanvas(c: HTMLCanvasElement) {
    c.width = window.innerWidth;
    c.height = window.innerHeight;
  }

  function initRain() {
    sizeCanvas(rainCanvas);
    const count = Math.floor((rainCanvas.width * rainCanvas.height) / 9000);
    drops = Array.from({ length: count }, () => ({
      x: Math.random() * rainCanvas.width,
      y: Math.random() * rainCanvas.height,
      len: 8 + Math.random() * 16,
      speed: 9 + Math.random() * 10,
      drift: 1 + Math.random() * 1.5,
    }));
  }

  function drawRain() {
    rainCtx.clearRect(0, 0, rainCanvas.width, rainCanvas.height);
    rainCtx.strokeStyle = 'rgba(170, 190, 210, 0.35)';
    rainCtx.lineWidth = 1;
    for (const d of drops) {
      rainCtx.beginPath();
      rainCtx.moveTo(d.x, d.y);
      rainCtx.lineTo(d.x - d.drift, d.y + d.len);
      rainCtx.stroke();
      d.y += d.speed;
      d.x -= d.drift;
      if (d.y > rainCanvas.height) {
        d.y = -d.len;
        d.x = Math.random() * (rainCanvas.width + 100);
      }
    }
  }

  /* ── Crows ── */
  const crowCanvas = document.getElementById('crow-canvas') as HTMLCanvasElement;
  const crowCtx = crowCanvas.getContext('2d')!;

  interface Crow { x: number; y: number; vx: number; size: number; phase: number; flapSpeed: number; }
  let crows: Crow[] = [];

  function spawnCrow(offscreen = true): Crow {
    const leftward = Math.random() < 0.5;
    const size = 5 + Math.random() * 9;
    return {
      x: offscreen ? (leftward ? crowCanvas.width + 40 : -40) : Math.random() * crowCanvas.width,
      y: 30 + Math.random() * crowCanvas.height * 0.4,
      vx: (leftward ? -1 : 1) * (0.4 + Math.random() * 0.9),
      size,
      phase: Math.random() * Math.PI * 2,
      flapSpeed: 0.12 + Math.random() * 0.1,
    };
  }

  function initCrows() {
    sizeCanvas(crowCanvas);
    crows = Array.from({ length: 7 }, () => spawnCrow(false));
  }

  function drawCrow(c: Crow) {
    const flap = Math.sin(c.phase);
    crowCtx.strokeStyle = 'rgba(10, 10, 12, 0.85)';
    crowCtx.lineWidth = Math.max(1.2, c.size / 5);
    crowCtx.lineCap = 'round';
    crowCtx.beginPath();
    // Left wing
    crowCtx.moveTo(c.x - c.size, c.y - flap * c.size * 0.7);
    crowCtx.quadraticCurveTo(c.x - c.size * 0.4, c.y + flap * c.size * 0.3, c.x, c.y);
    // Right wing
    crowCtx.quadraticCurveTo(c.x + c.size * 0.4, c.y + flap * c.size * 0.3, c.x + c.size, c.y - flap * c.size * 0.7);
    crowCtx.stroke();
  }

  function drawCrows() {
    crowCtx.clearRect(0, 0, crowCanvas.width, crowCanvas.height);
    for (let i = 0; i < crows.length; i++) {
      const c = crows[i]!;
      drawCrow(c);
      c.x += c.vx;
      c.y += Math.sin(c.phase * 0.3) * 0.3;
      c.phase += c.flapSpeed;
      if (c.x < -60 || c.x > crowCanvas.width + 60) crows[i] = spawnCrow();
    }
  }

  /* ── Lightning ── */
  const lightning = document.getElementById('lightning')!;
  function scheduleLightning() {
    const delay = 8000 + Math.random() * 18000;
    setTimeout(() => {
      lightning.classList.add('flash');
      setTimeout(() => lightning.classList.remove('flash'), 90);
      if (Math.random() < 0.5) {
        setTimeout(() => {
          lightning.classList.add('flash');
          setTimeout(() => lightning.classList.remove('flash'), 60);
        }, 180);
      }
      scheduleLightning();
    }, delay);
  }

  /* ── Loop ── */
  function loop() {
    drawRain();
    drawCrows();
    requestAnimationFrame(loop);
  }

  if (!reduced) {
    initRain();
    initCrows();
    scheduleLightning();
    window.addEventListener('resize', () => {
      initRain();
      sizeCanvas(crowCanvas);
    });
    requestAnimationFrame(loop);
  }
</script>
