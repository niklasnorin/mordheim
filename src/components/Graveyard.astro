---
import { warbands } from '../data/warbands';
import Icon from './Icon.astro';

const fallen = warbands
  .flatMap((wb) =>
    wb.members
      .filter((m) => m.dead)
      .map((m) => ({ ...m, warbandName: wb.name }))
  )
  .sort((a, b) => (b.death?.order ?? 0) - (a.death?.order ?? 0));

/* Graves are dug scenario by scenario. Everyone who fell in the same battle
   shares a row; the most recent battle stands in the foreground and older
   scenarios recede toward the horizon. */
const assetBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows: { date: string; graves: typeof fallen }[] = [];
for (const m of fallen) {
  const date = m.death?.date ?? 'Unknown';
  const row = rows.find((r) => r.date === date);
  if (row) row.graves.push(m);
  else rows.push({ date, graves: [m] });
}

/* The nameless dead of Mordheim — stones too weathered to read. The deeper
   into the field, the more of them crowd the ground. */
const wornEpitaphs = [
  '⸖⸎⸏ ⸎⸏⸖⸎',
  '⸏⸖⸎⸏⸖ ⸎⸏',
  '⸎⸖⸏ ⸏⸎⸖⸎⸏',
  '⸏⸎ ⸖⸏⸎⸖',
  '⸖⸎⸏⸖ ⸏⸎',
  '⸎⸏⸖⸎ ⸏⸖',
];
const shapes = ['round', 'cross', 'broken', 'slab'];
const namelessFor = (depth: number, count: number) =>
  Array.from({ length: count }, (_, n) => {
    const seed = depth * 7 + n * 3;
    return {
      key: `${depth}-${n}`,
      text: wornEpitaphs[seed % wornEpitaphs.length],
      shape: shapes[seed % shapes.length],
      tilt: ((seed % 5) - 2) * 1.6,
      crow: seed % 4 === 0,
    };
  });

/* Two extra rows of forgotten graves behind the campaign's own dead. */
const backRows = [rows.length, rows.length + 1];
---

<section
  id="graveyard"
  class="graveyard reveal"
  style={`--stone-hero: url(${assetBase}/tombstone-hero.jpg); --stone-hench: url(${assetBase}/tombstone-henchman.jpg); --stone-nameless: url(${assetBase}/tombstone-nameless.jpg)`}
>
  <div class="memorial-mark" aria-hidden="true">
    <svg viewBox="0 0 100 112" fill="none" stroke="currentColor">
      <path d="M18 100V48Q18 15 50 5q32 10 32 43v52M24 100V49q0-28 26-37 26 9 26 37v51M12 101h76M8 106h84"/>
      <path d="M47 84V35h6v49l-3 10-3-10ZM37 45h26M40 49h20M50 23v7M45 27h10M33 88h7m20 0h7"/>
      <path d="M31 69v14m-3-15q3-9 6 0c0 4-6 4-6 0Zm38 1v14m-3-15q3-9 6 0c0 4-6 4-6 0ZM29 85h4m31 0h4" stroke-width=".8"/>
      <path d="M18 55h6m-6 12h6m-6 12h6m-6 12h6m52-36h6m-6 12h6m-6 12h6m-6 12h6" stroke-width=".6"/>
    </svg>
  </div>
  <p class="memorial-label">In memoriam</p>
  <h2 class="section-title"><span class="ornament" aria-hidden="true"><Icon name="tombstone" /></span> The Graveyard <span class="ornament" aria-hidden="true"><Icon name="tombstone" /></span></h2>
  {fallen.length === 0 ? (
    <div class="graveyard-empty empty-state">
      <p>No graves yet. Mordheim is patient.</p>
      <a href="#warbands">Return to the living</a>
    </div>
  ) : (
  <>
  <p class="section-intro">
    Here lie the fallen of the campaign, row upon row among the nameless dead of Mordheim. The
    freshest graves stand nearest; older battles recede into the fog.
  </p>
  <div class="grave-toolbar">
    <button type="button" class="spread-toggle" id="spread-graves" aria-pressed="false">
      Spread the graves
    </button>
  </div>
  <div class="graveyard-ground" id="graveyard-ground">
    <div class="grave-field">
      {
        backRows
          .slice()
          .reverse()
          .map((depth) => (
            <div class="grave-row grave-row-nameless" style={`--depth: ${depth}`}>
              {namelessFor(depth, 6 + depth).map((s) => (
                <div
                  class={`nameless nameless-${s.shape}`}
                  style={`--tilt: ${s.tilt}deg`}
                  aria-hidden="true"
                >
                  {s.crow && (
                    <span class="crow">
                      <svg viewBox="0 0 40 24" role="presentation">
                        <path d="M6 22c1-6 4-10 9-12 3-1.4 5-3.6 6-6.4.9 2.6 2.6 4.4 5 5.2 4.6 1.6 7.4 5.6 8 13.2-3-3.4-6.4-5.2-10.4-5.4-4.6-.2-8.6 1.6-11.6 5.4z" />
                        <path d="M20 3.6 26.6.6l-1.4 4z" />
                      </svg>
                    </span>
                  )}
                  <span class="nameless-text">{s.text}</span>
                </div>
              ))}
            </div>
          ))
      }
      {
        rows
          .slice()
          .reverse()
          .map((row, idx) => {
            const depth = rows.length - 1 - idx;
            return (
              <div class="grave-row" style={`--depth: ${depth}`}>
                {namelessFor(depth + 11, depth).map((s) => (
                  <div
                    class={`nameless nameless-${s.shape}`}
                    style={`--tilt: ${s.tilt}deg`}
                    aria-hidden="true"
                  >
                    <span class="nameless-text">{s.text}</span>
                  </div>
                ))}
                {row.graves.map((m, gi) => (
                  <figure class={`tombstone tombstone-${m.rank}`}>
                    <button type="button" class="tombstone-stone" aria-pressed="false" aria-label={`Read the grave of ${m.name}`}>
                      {m.rank === 'hero' && (
                        <span class="tombstone-flourish" aria-hidden="true"><i></i><Icon name="cross" size={14} /><i></i></span>
                      )}
                      {(depth + gi) % 3 === 0 && (
                        <span class="crow crow-stone" aria-hidden="true">
                          <svg viewBox="0 0 40 24" role="presentation">
                            <path d="M6 22c1-6 4-10 9-12 3-1.4 5-3.6 6-6.4.9 2.6 2.6 4.4 5 5.2 4.6 1.6 7.4 5.6 8 13.2-3-3.4-6.4-5.2-10.4-5.4-4.6-.2-8.6 1.6-11.6 5.4z" />
                            <path d="M20 3.6 26.6.6l-1.4 4z" />
                          </svg>
                        </span>
                      )}
                      {m.rank === 'henchman' && (
                        <span class="tombstone-cross" aria-hidden="true"><Icon name="cross" size={18} /></span>
                      )}
                      <span class="tombstone-portrait" aria-hidden="true">{m.portrait}</span>
                      <span class="tombstone-name">{m.name}</span>
                      <span class="tombstone-meta">
                        {m.role} of {m.warbandName}
                      </span>
                      {m.death && <span class="tombstone-date"><Icon name="cross" size={11} /> {m.death.date}</span>}
                      {m.death && <span class="tombstone-epitaph">{m.death.epitaph}</span>}
                    </button>
                    <div class="tombstone-mound" aria-hidden="true" />
                  </figure>
                ))}
                {namelessFor(depth + 23, depth).map((s) => (
                  <div
                    class={`nameless nameless-${s.shape}`}
                    style={`--tilt: ${s.tilt}deg`}
                    aria-hidden="true"
                  >
                    {s.crow && (
                      <span class="crow">
                        <svg viewBox="0 0 40 24" role="presentation">
                          <path d="M6 22c1-6 4-10 9-12 3-1.4 5-3.6 6-6.4.9 2.6 2.6 4.4 5 5.2 4.6 1.6 7.4 5.6 8 13.2-3-3.4-6.4-5.2-10.4-5.4-4.6-.2-8.6 1.6-11.6 5.4z" />
                          <path d="M20 3.6 26.6.6l-1.4 4z" />
                        </svg>
                      </span>
                    )}
                    <span class="nameless-text">{s.text}</span>
                  </div>
                ))}
              </div>
            );
          })
      }
    </div>
    <div class="fog fog-1" aria-hidden="true"></div>
    <div class="fog fog-2" aria-hidden="true"></div>
    <div class="fog fog-3" aria-hidden="true"></div>
  </div>
  <p class="memorial-footer">Their names endure where their footsteps do not.</p>
  </>
  )}
</section>

<style>
  .memorial-mark {
    width: 66px;
    margin: 0 auto 0.8rem;
    color: #b69a62;
    opacity: 0.75;
  }
  .memorial-mark svg { display: block; width: 100%; }
  .memorial-label, .memorial-footer {
    text-align: center;
    color: #b69a62;
    font: var(--text-meta)/1.8 var(--font-utility);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .memorial-footer {
    padding: 1.4rem 1rem 0;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0.04em;
    color: #a6aa99;
    font-size: var(--text-body);
  }
  .graveyard .section-intro {
    max-width: 550px;
    margin-left: auto;
    margin-right: auto;
    color: #b8b9a9;
    font-size: var(--text-body);
    line-height: 1.8;
  }
  .grave-toolbar {
    display: flex;
    justify-content: center;
    margin: 1.2rem 0 0.4rem;
  }
  .spread-toggle {
    font: var(--text-ui)/1.5 var(--font-utility);
    min-height: var(--control-size);
    color: var(--gold);
    background: #111915ee;
    border: 1px solid var(--border);
    padding: 0.45rem 1.1rem;
    cursor: pointer;
  }
  .spread-toggle[aria-pressed='true'] {
    color: var(--parchment);
    border-color: var(--gold-dim);
    box-shadow: 0 0 12px rgba(184, 150, 62, 0.28);
  }
  .graveyard-ground {
    position: relative;
    padding: 0.5rem 1rem 1.5rem;
    background:
      radial-gradient(ellipse at 50% 30%, #222920 0%, transparent 65%),
      linear-gradient(to bottom, transparent 0%, #101715 100%);
    border-bottom: 1px solid #444636;
    overflow: hidden;
  }

  /* Packed overlapping field — the whole cemetery fits in ~1.5 viewports. */
  .grave-field {
    position: relative;
    height: 150vh;
    max-height: 1350px;
  }

  .grave-row {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-end;
    gap: 0.35rem;
    width: 100%;
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(4% + var(--depth) * 16%);
    z-index: calc(20 - var(--depth));
    transform-origin: 50% 100%;
    transform: scale(calc(1 - var(--depth) * 0.11));
    pointer-events: none;
  }
  .grave-row .tombstone { pointer-events: auto; }

  .grave-row-nameless {
    gap: 0.15rem;
    opacity: 0.38;
    filter: blur(0.7px);
    pointer-events: none;
  }

  .tombstone {
    position: relative;
    margin: 0 -1.4rem;
    transition: transform 0.28s ease, filter 0.28s ease, z-index 0s;
  }

  .tombstone-stone {
    position: relative;
    display: block;
    appearance: none;
    -webkit-appearance: none;
    width: 200px;
    min-height: 280px;
    padding: 5.2rem 1.15rem 1.4rem;
    text-align: center;
    font: inherit;
    color: inherit;
    cursor: pointer;
    border: none;
    background-color: transparent;
    background-image:
      linear-gradient(to top, rgba(8, 10, 8, 0.78) 0%, rgba(8, 10, 8, 0.35) 42%, transparent 70%),
      var(--stone-hench);
    background-size: cover;
    background-position: center 18%;
    background-repeat: no-repeat;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.75));
  }
  .tombstone-flourish {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    color: rgba(198, 176, 118, 0.55);
    margin-bottom: 0.35rem;
  }
  .tombstone-flourish i { width: 1rem; height: 1px; background: currentColor; }

  .tombstone-hero .tombstone-stone {
    width: 224px;
    min-height: 320px;
    padding: 6.2rem 1.35rem 1.6rem;
    background-image:
      linear-gradient(to top, rgba(8, 10, 8, 0.72) 0%, rgba(8, 10, 8, 0.28) 44%, transparent 68%),
      var(--stone-hero);
    background-position: center 12%;
  }
  .tombstone-hero .tombstone-name {
    font-size: 1.25rem;
    color: #e7dcc5;
    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.7);
  }
  .tombstone-hero .tombstone-portrait {
    border: 1px solid rgba(198, 176, 118, 0.45);
    box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.35);
  }
  .tombstone-hero .tombstone-epitaph {
    border-top: 1px solid rgba(198, 176, 118, 0.3);
  }
  .tombstone-hero .tombstone-mound {
    height: 0.95rem;
  }

  .tombstone-henchman .tombstone-name { font-size: 1rem; }
  .tombstone-henchman .tombstone-portrait {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.35rem;
    border-radius: 4px;
  }
  .tombstone-henchman .tombstone-epitaph { font-size: 0.8rem; }

  .tombstone-cross {
    display: flex;
    justify-content: center;
    color: #b8b9a9;
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .tombstone-portrait {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.1rem;
    height: 3.1rem;
    font-size: 1.7rem;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid #45484e;
    filter: grayscale(1) sepia(0.35);
    margin-bottom: 0.5rem;
  }
  .tombstone-name {
    display: block;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.15rem;
    color: #e7dcc5;
    line-height: 1.35;
  }
  .tombstone-meta {
    display: block;
    font-size: 0.72rem;
    color: #c0c1ae;
    font-variant: small-caps;
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
  }
  .tombstone-date {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    color: #c5aa87;
    margin-top: 0.6rem;
  }
  .tombstone-epitaph {
    font-size: 0.82rem;
    line-height: 1.7;
    font-style: italic;
    color: #c0c1ae;
    margin-top: 0.8rem;
    border-top: 1px solid #4a5042;
    padding-top: 0.8rem;
  }

  .tombstone-mound {
    height: 0.7rem;
    margin: 0 -0.9rem;
    background: radial-gradient(ellipse at 50% 0%, #1b1e19 0%, #101310 70%, transparent 100%);
    border-radius: 50%;
  }

  .tombstone.is-front {
    z-index: 80;
    transform: scale(1.2);
    filter: none;
  }
  .grave-field.is-focusing .tombstone:not(.is-front) {
    opacity: 0.28;
    filter: blur(1px);
  }
  .tombstone-stone:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .grave-field.is-spread {
    height: auto;
    max-height: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.8rem;
    padding: 1.2rem 0 2rem;
  }
  .grave-field.is-spread .grave-row {
    position: relative;
    bottom: auto;
    transform: none;
    flex-wrap: wrap;
    gap: 1.5rem;
    pointer-events: auto;
  }
  .grave-field.is-spread .tombstone { margin: 0; }
  .grave-field.is-spread .nameless { margin: 0; }

  /* ── The nameless dead: stones worn past reading ── */
  .nameless {
    position: relative;
    width: 72px;
    height: 100px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 1rem;
    margin: 0 -0.55rem;
    transform: rotate(var(--tilt, 0deg));
    background-image: var(--stone-nameless);
    background-size: cover;
    background-position: center;
    filter: drop-shadow(0 6px 10px rgba(0, 0, 0, 0.7));
  }
  .nameless-slab { width: 64px; height: 86px; }
  .nameless-cross { width: 56px; height: 92px; }
  .nameless-broken {
    width: 66px;
    height: 70px;
    transform: rotate(calc(var(--tilt, 0deg) + 4deg));
  }

  .nameless-text {
    font-family: 'Pirata One', cursive;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: rgba(214, 210, 194, 0.42);
    filter: blur(1.2px);
    user-select: none;
  }

  .graveyard-empty {
    max-width: 620px;
    margin-inline: auto;
  }

  /* ── Crows perched on the stones ── */
  .crow {
    position: absolute;
    top: -14px;
    right: 12%;
    width: 26px;
    color: #0b0c0f;
    transform-origin: 50% 100%;
    animation: crow-bob 5.5s ease-in-out infinite;
  }
  .crow-stone {
    top: -19px;
    right: 15%;
    width: 30px;
    animation-duration: 7s;
  }
  .crow svg {
    display: block;
    width: 100%;
    height: auto;
    fill: currentColor;
    filter: drop-shadow(0 0 2px rgba(190, 196, 202, 0.45)) drop-shadow(0 2px 3px rgba(0, 0, 0, 0.65));
  }

  @keyframes crow-bob {
    0%, 84%, 100% { transform: none; }
    88% { transform: translateY(-2px) rotate(-4deg); }
    94% { transform: translateY(-1px) rotate(3deg); }
  }

  /* ── Fog among the tombstones ── */
  .fog {
    position: absolute;
    left: -50%;
    width: 200%;
    height: 45%;
    bottom: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse at 50% 100%,
      rgba(178, 190, 195, 0.14) 0%,
      rgba(178, 190, 195, 0.07) 45%,
      transparent 75%
    );
    filter: blur(14px);
    animation: fog-drift 26s ease-in-out infinite alternate;
    z-index: 30;
    opacity: 0.4;
  }
  .fog-2 {
    height: 32%;
    animation-duration: 19s;
    animation-delay: -7s;
    animation-direction: alternate-reverse;
    background: radial-gradient(
      ellipse at 35% 100%,
      rgba(178, 190, 195, 0.11) 0%,
      transparent 70%
    );
  }
  .fog-3 {
    height: 58%;
    z-index: 5; /* behind the front tombstones, among the back rows */
    animation-duration: 33s;
    animation-delay: -14s;
    background: radial-gradient(
      ellipse at 65% 100%,
      rgba(178, 190, 195, 0.1) 0%,
      transparent 70%
    );
  }

  @keyframes fog-drift {
    from { transform: translateX(-6%); }
    to { transform: translateX(6%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .crow, .fog { animation: none; }
  }

  @media (max-width: 700px) {
    .grave-field { height: 170vh; max-height: none; }
    .graveyard-ground { padding: 0.4rem 0.6rem 1rem; }
    .tombstone { margin: 0 -1.8rem; }
    .tombstone-stone,
    .tombstone-hero .tombstone-stone { width: min(200px, 72vw); box-sizing: border-box; }
    .grave-row-nameless { display: none; }
    .grave-row > .nameless { display: none; }
    .tombstone-name, .tombstone-meta { overflow-wrap: anywhere; }
  }
</style>

<script>
  const field = document.querySelector('#graveyard .grave-field') as HTMLElement | null;
  const toggle = document.getElementById('spread-graves') as HTMLButtonElement | null;
  if (field && toggle) {
    const stones = () => [...field.querySelectorAll('.tombstone')];

    function clearFront() {
      field!.classList.remove('is-focusing');
      stones().forEach((el) => {
        el.classList.remove('is-front');
        const btn = el.querySelector('.tombstone-stone') as HTMLButtonElement | null;
        if (btn) btn.setAttribute('aria-pressed', 'false');
      });
    }

    field.addEventListener('click', (event) => {
      const btn = (event.target as HTMLElement).closest('.tombstone-stone');
      if (!btn) {
        clearFront();
        return;
      }
      const stone = btn.closest('.tombstone')!;
      const already = stone.classList.contains('is-front');
      clearFront();
      if (!already) {
        stone.classList.add('is-front');
        btn.setAttribute('aria-pressed', 'true');
        field!.classList.add('is-focusing');
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') clearFront();
    });

    toggle.addEventListener('click', () => {
      const on = toggle.getAttribute('aria-pressed') === 'true';
      toggle.setAttribute('aria-pressed', on ? 'false' : 'true');
      toggle.textContent = on ? 'Spread the graves' : 'Crowd the graves';
      field.classList.toggle('is-spread', !on);
      clearFront();
    });
  }
</script>
