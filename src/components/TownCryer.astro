---
import { news, issue } from '../data/news';
import Icon from './Icon.astro';
import { hasDatabase } from '../server/db/client';
import { recentDispatches, todayFor, type PrintedDispatch } from '../server/curfew/service';
import { bylineFor } from '../curfew/cryer';

// What the Night Watch brought in. Without a database (a local build, say) the broadsheet simply prints the news.
const today = todayFor(null);
let dispatches: PrintedDispatch[] = [];
if (hasDatabase()) {
  try { dispatches = await recentDispatches(today, 8); } catch (e) { console.error('[cryer] dispatches unavailable', e); }
}
const lastNight = dispatches.filter((d) => d.night === today - 1);
const earlier = dispatches.filter((d) => d.night !== today - 1);
const nightLabel = (n: number) => (n === today - 1 ? 'last night' : `night ${n}`);
---

<section id="town-cryer" class="town-cryer reveal">
  <div class="cryer-edition"><span>Dispatches from the ruins</span><span>Mordheim</span></div>
  <div class="cryer-masthead">
    <div class="cryer-price">
      <svg class="cryer-engraving" viewBox="0 0 120 88" fill="none" stroke="currentColor" aria-hidden="true">
        <path d="M8 76h104M15 72h91M39 67h42l-6-8H45l-6 8Zm9-8 3-25q9-17 18 0l3 25M49 39h22M55 24v-7h10v7M60 9v8M44 59h32M54 35v19m5-22v22m6-19v19M56 70h8"/>
        <path d="m23 49-4-14 9 6m-4 14-10-8 12 2m0 11-13-3 14-3m1 12-12 2 13-7m4 10-11 4 9-10M97 49l4-14-9 6m4 14 10-8-12 2m0 11 13-3-14-3m-1 12 12 2-13-7m-4 10 11 4-9-10"/>
        <path d="m35 18 7 7m-14 9 10 2m-9 9 8-1m48-26-7 7m14 9-10 2m9 9-8-1M53 13l-3-5m17 5 3-5M45 74v2m5-2v2m5-2v2m5-2v2m5-2v2m5-2v2m5-2v2" stroke-width=".7"/>
      </svg>
      <span>Price: 2 Shillings</span>
    </div>
    <h2 class="cryer-title">The Town Cryer</h2>
    <div class="cryer-issue">{issue}</div>
  </div>
  <div class="cryer-banner">
    <span><Icon name="cross" size={12} /> HEAR YE! HEAR YE! ALL THE NEWS FROM THE CITY OF THE DAMNED <Icon name="cross" size={12} /></span>
  </div>
  <div class="cryer-columns">
    {
      news.map((article) =>
        article.notice ? (
          <div class="cryer-notice">
            <strong>{article.headline}</strong>
            {article.body}
          </div>
        ) : (
          <article class="cryer-article">
            <h3>{article.headline}</h3>
            {article.byline && <div class="byline">{article.byline}</div>}
            <p>{article.body}</p>
          </article>
        )
      )
    }
  </div>
  {dispatches.length > 0 && (
    <div class="cryer-curfew">
      <h3>From the Night Watch</h3>
      <p class="cryer-curfew-note">
        {lastNight.length ? `What the city saw last night, night ${today - 1}.` : 'What the city has seen after curfew.'}
      </p>
      <div class="cryer-watch">
        {[...lastNight, ...earlier].map((d) =>
          d.kind === 'happening' ? (
            <article class="cryer-article cryer-happening">
              <h3>{d.headline}</h3>
              <div class="byline">{bylineFor(d.warbandId, d.night)}</div>
              <p>{d.body}</p>
              <small class="cryer-stamp">{d.warbandName} · {nightLabel(d.night)}</small>
            </article>
          ) : (
            <div class="cryer-notice cryer-plant">
              <strong>{d.kind === 'notice' ? 'By order of the Watch' : 'Heard in the taverns'}</strong>
              {d.headline}
              <small class="cryer-stamp">{d.warbandName} · {nightLabel(d.night)}</small>
            </div>
          )
        )}
      </div>
    </div>
  )}
  <div class="cryer-footer">
    <em>
      Printed under license of the Grand Theogonist — All heresies reported herein are for the
      entertainment of the faithful only
    </em>
  </div>
</section>

<style>
  .town-cryer {
    background: #d8c8a7;
    background-image:
      radial-gradient(ellipse at 15% 10%, rgba(90, 70, 40, 0.14), transparent 45%),
      radial-gradient(ellipse at 85% 90%, rgba(90, 70, 40, 0.16), transparent 45%),
      radial-gradient(ellipse at 60% 40%, rgba(120, 95, 60, 0.06), transparent 60%),
      repeating-linear-gradient(0deg, transparent 0 3px, rgba(65, 47, 26, 0.018) 3px 4px),
      linear-gradient(#e7dcc5, #d4c4a4);
    color: #292a23;
    padding: 1.2rem 2.5rem 1.4rem;
    border: 1px solid #b69a62;
    box-shadow:
      0 16px 50px rgba(0, 0, 0, 0.22),
      inset 0 0 65px rgba(90, 70, 40, 0.12);
  }
  .cryer-edition {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #776b50;
    font: var(--text-meta)/1.5 var(--font-utility);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .cryer-engraving {
    display: block;
    width: 88px;
    height: 65px;
    margin: 0 auto 0.2rem;
  }

  .cryer-masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 4px double #241b10;
    padding: 1.1rem 0;
    gap: 1rem;
  }
  .cryer-title {
    font-family: 'UnifrakturMaguntia', cursive;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-align: center;
    flex: 1;
    font-weight: normal;
  }
  .cryer-price,
  .cryer-issue {
    font-size: var(--text-meta);
    font-style: italic;
    text-align: center;
    flex: 0 0 108px;
  }

  .cryer-banner {
    text-align: center;
    border-bottom: 1px solid #241b10;
    padding: 0.65rem 0;
    font-size: var(--text-meta);
    line-height: 1.7;
    letter-spacing: 0.14em;
    font-variant: small-caps;
  }

  .cryer-columns {
    columns: 2;
    column-gap: 2.8rem;
    column-rule: 1px solid rgba(36, 27, 16, 0.25);
    padding: 1.9rem 0 0.7rem;
  }

  .cryer-article {
    break-inside: avoid;
    margin-bottom: 1.6rem;
  }
  .cryer-article h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.45rem;
    line-height: 1.2;
    margin-bottom: 0.6rem;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .cryer-article .byline {
    font-size: var(--text-ui);
    font-style: italic;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
    color: #4a3a22;
  }
  .cryer-article p {
    font-size: var(--text-body);
    line-height: 1.8;
    text-align: justify;
    hyphens: auto;
  }
  .cryer-article p::first-letter {
    font-family: 'UnifrakturMaguntia', cursive;
    font-size: 2.2em;
    float: left;
    line-height: 0.8;
    padding-right: 0.12em;
    color: #762e2a;
  }
  .cryer-notice {
    border: 3px double #776b50;
    background: rgba(89, 62, 30, 0.045);
    padding: 1rem;
    text-align: center;
    font-size: var(--text-body);
    margin-bottom: 1.6rem;
    break-inside: avoid;
  }
  .cryer-notice strong {
    display: block;
    font-variant: small-caps;
    letter-spacing: 0.15em;
    font-size: 1rem;
    margin-bottom: 0.3rem;
  }

  .cryer-curfew {
    border-top: 1px solid #241b10;
    padding: 1rem 0 1.2rem;
  }
  .cryer-curfew h3 { font-variant: small-caps; letter-spacing: 0.15em; font-size: 1rem; margin-bottom: 0.3rem; }
  .cryer-curfew-note { font-size: var(--text-meta); font-style: italic; color: #4a3a22; margin-bottom: 0.6rem; }
  .cryer-watch { columns: 2; column-gap: 2.8rem; column-rule: 1px solid rgba(36, 27, 16, 0.25); padding-top: 0.4rem; }
  .cryer-happening h3 { font-size: 1.2rem; }
  .cryer-happening p { font-size: var(--text-ui); line-height: 1.7; }
  .cryer-happening p::first-letter { font-size: 1.9em; }
  .cryer-plant { text-align: left; font-style: italic; }
  .cryer-plant strong { text-align: center; font-style: normal; }
  .cryer-stamp { display: block; margin-top: 0.35rem; font-size: var(--text-meta); font-style: italic; color: #4a3a22; text-align: right; }
  @media (max-width: 700px) { .cryer-watch { columns: 1; } }

  .cryer-footer {
    border-top: 4px double #241b10;
    text-align: center;
    padding-top: 0.8rem;
    font-size: var(--text-meta);
    line-height: 1.7;
  }

  @media (max-width: 700px) {
    .cryer-columns { columns: 1; }
    .town-cryer { padding: 1.4rem 1.2rem 1rem; }
    .cryer-masthead { flex-wrap: wrap; gap: 0.6rem; }
    .cryer-title { flex-basis: 100%; order: -1; }
    .cryer-price, .cryer-issue { flex: 1; }
    .cryer-price { display: flex; align-items: center; gap: 0.5rem; text-align: left; }
    .cryer-engraving { width: 44px; height: 36px; margin: 0; flex-shrink: 0; }
    .cryer-issue { text-align: right; }
    .cryer-edition { letter-spacing: 0.04em; }
    .cryer-article p { text-align: left; }
  }
</style>
