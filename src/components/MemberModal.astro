---
import { warbands } from '../data/warbands';
import { getMemberStory, getScenarioUrl } from '../data/history';
import type { MemberNights } from '../curfew/story';
import Icon from './Icon.astro';
import { asset, base } from '../lib/site';

interface Props {
  /** What the Curfew nights have written about each member, by member id. Empty without a database. */
  nights?: Record<string, MemberNights>;
}
const { nights = {} } = Astro.props;
const SHOWN_NIGHTS = 5;
const outcomeLabel = { boon: 'a good night', fair: 'a fair night', poor: 'a poor night' } as const;

const statKeys = ['M', 'WS', 'BS', 'S', 'T', 'W', 'I', 'A', 'Ld'] as const;
const statNames = {
  M: 'Movement', WS: 'Weapon Skill', BS: 'Ballistic Skill', S: 'Strength',
  T: 'Toughness', W: 'Wounds', I: 'Initiative', A: 'Attacks', Ld: 'Leadership',
};

const resultLabel = { victory: 'Victory', defeat: 'Defeat', draw: 'Draw' } as const;
---

<dialog id="member-dialog" class="member-dialog">
  <div class="dialog-toolbar">
    <button type="button" class="modal-close" id="modal-close">Close <Icon name="close" size={16} /></button>
  </div>
  <div class="dialog-body">
  {
    warbands.map((wb) =>
      wb.members.map((m) => {
        const story = getMemberStory(m.id);
        const openStory = m.rank === 'hero' && story.length > 0;
        const curfew = nights[m.id];
        const recent = curfew?.entries.slice(0, SHOWN_NIGHTS) ?? [];
        return (
        <div class="profile" data-profile={`${wb.id}:${m.id}`} hidden>
          <div class="profile-header">
            <span class="profile-portrait" aria-hidden="true">
              {wb.crest ? (
                <img src={asset(wb.crest)} alt="" width="120" height="140" loading="lazy" />
              ) : wb.sigil}
            </span>
            <div>
              <p class="profile-label">From the campaign archives · {m.rank}</p>
              <h3 id={`profile-title-${wb.id}-${m.id}`} tabindex="-1">{m.name}</h3>
              {m.epithet && <p class="profile-epithet">{m.epithet}</p>}
              <span class="member-role">
                {m.role} — {wb.name}
                {m.dead && <span class="dead-marker"> <Icon name="cross" size={12} /> Fallen</span>}
              </span>
            </div>
          </div>
          <table class="statline">
            <caption class="visually-hidden">{m.name}'s statline</caption>
            <thead>
              <tr>{statKeys.map((k) => (
                <th scope="col">
                  <abbr title={statNames[k]} aria-hidden="true">{k}</abbr>
                  <span class="visually-hidden">{statNames[k]}</span>
                </th>
              ))}</tr>
            </thead>
            <tbody>
              <tr>{statKeys.map((k) => <td>{m.stats[k]}</td>)}</tr>
            </tbody>
          </table>
          <details class="stat-guide">
            <summary>Stat abbreviations</summary>
            <dl>{statKeys.map((k) => <div><dt>{k}</dt><dd>{statNames[k]}</dd></div>)}</dl>
          </details>
          <div class="profile-section">
            {m.experience !== undefined && <p><strong>Experience:</strong> {m.experience}</p>}
            <h4>Equipment</h4>
            <ul>{m.equipment.map((e) => <li>{e}</li>)}</ul>
            {m.skills.length > 0 && (
              <>
                <h4>Skills & Special Rules</h4>
                <ul>{m.skills.map((s) => <li>{s}</li>)}</ul>
              </>
            )}
            {m.prayers && m.prayers.length > 0 && (
              <>
                <h4>Prayers of Taal</h4>
                <ul>{m.prayers.map((p) => <li>{p}</li>)}</ul>
              </>
            )}
            {m.injuries && m.injuries.length > 0 && (
              <>
                <h4>Old Wounds</h4>
                <ul class="injury-list">{m.injuries.map((i) => <li>{i}</li>)}</ul>
              </>
            )}
            {m.lore.trim() && (
              <>
                <h4>Tale</h4>
                <p class="profile-lore">{m.lore}</p>
              </>
            )}
            {curfew && (recent.length > 0 || curfew.epithet) && (
              <div class="nights">
                <h4>Nights in the City</h4>
                <p class="nights-standing">
                  {curfew.epithet && <>The taverns call {m.name.split(' ')[0]} <em>{m.name.split(' ')[0]} {curfew.epithet}</em> now. </>}
                  {curfew.nightsOut > 0 && <>{curfew.nightsOut} {curfew.nightsOut === 1 ? 'night' : 'nights'} out between the battles{curfew.shards > 0 ? `, ${curfew.shards} ${curfew.shards === 1 ? 'shard' : 'shards'} of the green brought home` : ''}.</>}
                </p>
                {recent.length > 0 && (
                  <ol class="nights-list">
                    {recent.map((e) => (
                      <li>
                        <span class="nights-night">Night {e.night}</span>
                        <p>{e.prose}</p>
                        <span class="nights-meta">{e.errandLabel}, {e.standing ? 'on standing orders' : outcomeLabel[e.outcome]}{e.token ? ` · brought back ${e.token}` : ''}{e.rumour ? ' · heard a rumour' : ''}</span>
                      </li>
                    ))}
                  </ol>
                )}
                {curfew.entries.length > SHOWN_NIGHTS && <p class="nights-more">{curfew.entries.length - SHOWN_NIGHTS} earlier {curfew.entries.length - SHOWN_NIGHTS === 1 ? 'night is' : 'nights are'} in <a href={`${base}/curfew/`}>the warband's ledger</a>.</p>}
              </div>
            )}
            {story.length > 0 || (m.dead && m.death) ? (
            <details class="storyline" data-default-open={openStory ? 'true' : 'false'} open={openStory}>
              <summary>
                <span class="storyline-toggle">Follow their story <Icon name="arrow-down" size={14} /></span>
              </summary>
              <ol class="story-timeline">
                {story.map((entry) => (
                  <li
                    class:list={[
                      'story-chapter',
                      { 'story-fell': entry.snapshot.status === 'dead' },
                    ]}
                  >
                    <span class="story-marker" aria-hidden="true">
                      {entry.snapshot.status === 'dead' ? <Icon name="cross" size={14} /> : <Icon name="swords" size={14} />}
                    </span>
                    <h5><a href={getScenarioUrl(entry.scenario.id)}>{entry.scenario.scenario}</a></h5>
                    <span class="story-meta">
                      {entry.scenario.date} —{' '}
                      <span class:list={['story-result', entry.warband.result]}>
                        {resultLabel[entry.warband.result]}
                      </span>
                      {entry.snapshot.status === 'dead' && (
                        <span class="dead-marker"> <Icon name="cross" size={12} /> Fell in battle</span>
                      )}
                    </span>
                    <p class="story-text story-highlight">
                      <strong>Finest moment:</strong> {entry.snapshot.highlight}
                    </p>
                    <p class="story-text story-lowlight">
                      <strong>Darkest moment:</strong> {entry.snapshot.lowlight}
                    </p>
                  </li>
                ))}
                {m.dead && m.death ? (
                  <li class="story-chapter story-grave">
                    <span class="story-marker" aria-hidden="true"><Icon name="cross" size={14} /></span>
                    <h5>The Tale Ends</h5>
                    <span class="story-meta">Laid to rest — {m.death.date}</span>
                    <p class="story-text story-epitaph">{m.death.epitaph}</p>
                  </li>
                ) : (
                  <li class="story-chapter story-alive">
                    <span class="story-marker" aria-hidden="true"><Icon name="diamond" size={12} /></span>
                    <h5>The Tale Continues…</h5>
                    <span class="story-meta">Still walks the streets of Mordheim</span>
                  </li>
                )}
              </ol>
            </details>
            ) : (
              <p class="story-empty">
                {m.dead ? 'Their tale has ended. No battles have yet been recorded.' : 'The tale continues. No battles have yet been recorded.'}
              </p>
            )}
          </div>
        </div>
      ); })
    )
  }
  </div>
</dialog>

<style>
  .member-dialog {
    background: linear-gradient(160deg, var(--bg-panel2), var(--bg-panel));
    border: 1px solid var(--gold-dim);
    box-shadow: 0 0 80px rgba(0, 0, 0, 0.9), 0 0 30px rgba(184, 150, 62, 0.1);
    max-width: 640px;
    margin: auto;
    width: calc(100% - 2rem);
    max-height: 88vh;
    max-height: 88dvh;
    overflow: hidden;
    padding: 0;
    color: var(--ink);
  }
  .dialog-toolbar { display: flex; justify-content: flex-end; flex-shrink: 0; padding: .5rem .75rem; border-bottom: 1px solid var(--border); }
  .dialog-body { min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 1.5rem 2rem 2rem; }
  .profile-label { font: var(--text-meta)/1.6 var(--font-utility); text-transform: uppercase; letter-spacing: .08em; color: var(--gold); margin-bottom: .4rem; }
  .profile-epithet { color: var(--ink-dim); font-size: var(--text-ui); font-style: italic; margin: .25rem 0; }
  .profile-portrait { flex-shrink: 0; }
  .profile-portrait img { display: block; width: 70px; height: auto; }
  @media (max-width: 540px) {
    .dialog-body { padding: 1.25rem 1rem 1.5rem; }
    .profile-portrait img { width: 48px; }
  }
  .member-dialog::backdrop {
    background: rgba(5, 6, 8, 0.85);
    backdrop-filter: blur(3px);
  }
  .member-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: modal-in 0.3s ease;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to   { opacity: 1; transform: none; }
  }

  .modal-close {
    background: none;
    border: 1px solid var(--border);
    color: var(--ink-dim);
    font: var(--text-ui)/1.5 var(--font-utility);
    min-width: var(--control-size);
    min-height: var(--control-size);
    padding: .5rem .75rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
  }
  .modal-close:hover {
    color: var(--blood-bright);
    border-color: var(--blood);
  }

  .profile-header {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    border-bottom: 2px solid var(--gold-dim);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }
  .profile-portrait {
    font: 1.5rem/1 var(--font-utility);
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.7));
  }
  .profile-header > div { min-width: 0; }
  .profile-header h3 {
    font-family: 'Pirata One', cursive;
    font-size: 1.9rem;
    overflow-wrap: anywhere;
    color: var(--parchment);
    font-weight: normal;
  }
  .profile-header .member-role {
    font-size: 0.9rem;
    color: var(--blood-bright);
    font-variant: small-caps;
    letter-spacing: 0.04em;
  }
  .dead-marker { color: var(--blood-bright); }

  .statline {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .statline th,
  .statline td {
    border: 1px solid var(--border);
    text-align: center;
    padding: 0.35rem 0.2rem;
    font: var(--text-ui)/1.6 var(--font-utility);
    font-variant-numeric: tabular-nums;
  }
  .statline th {
    color: var(--gold);
    background: rgba(184, 150, 62, 0.06);
    font-weight: normal;
  }
  .statline abbr { text-decoration: none; }
  .stat-guide { font: var(--text-ui)/1.6 var(--font-utility); }
  .stat-guide summary { cursor: pointer; color: var(--gold); min-height: var(--control-size); padding: .65rem 0; }
  .stat-guide dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .5rem 1rem; margin-bottom: 1rem; }
  .stat-guide dl div { display: flex; gap: .5rem; }
  .stat-guide dt { min-width: 2rem; color: var(--gold); }

  .profile-section h4 {
    font-variant: small-caps;
    letter-spacing: 0.15em;
    color: var(--blood-bright);
    margin: 1rem 0 0.3rem;
    font-size: var(--text-body);
  }
  .profile-section ul { list-style: none; padding: 0; margin: 0; }
  .profile-section li { position: relative; padding-left: 1rem; }
  .profile-section li::before {
    content: '';
    position: absolute;
    left: .2rem;
    top: .65em;
    width: .28rem;
    height: .28rem;
    border: 1px solid var(--gold-dim);
    transform: rotate(45deg);
  }
  .injury-list li { color: var(--ink-dim); }
  .injury-list li::before { border-color: var(--blood-bright); }
  .profile-lore {
    font-style: italic;
    color: var(--ink-dim);
    font-size: var(--text-body);
  }
  .nights { margin-top: 1.5rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .nights-standing { color: var(--ink-dim); font-size: var(--text-body); margin-bottom: .8rem; }
  .nights-standing em { color: var(--parchment); font-style: italic; }
  .nights-list { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; }
  .profile-section .nights-list li { padding-left: 0; }
  .profile-section .nights-list li::before { content: none; }
  .nights-night { display: block; font: var(--text-meta)/1.5 var(--font-utility); text-transform: uppercase; letter-spacing: .12em; color: var(--gold); margin-bottom: .15rem; }
  .nights-list p { font-size: var(--text-body); line-height: 1.65; max-width: 68ch; }
  .nights-meta { display: block; margin-top: .2rem; font-size: var(--text-meta); font-style: italic; color: var(--ink-dim); }
  .nights-more { margin-top: .8rem; font-size: var(--text-ui); color: var(--ink-dim); }
  .nights-more a { color: var(--gold); text-underline-offset: .2em; }
  .story-empty { color: var(--ink-dim); border-top: 1px solid var(--border); margin-top: 1.5rem; padding-top: 1rem; font-size: var(--text-body); }

  .storyline {
    margin-top: 1.4rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .storyline summary {
    list-style: none;
    cursor: pointer;
    display: inline-block;
  }
  .storyline summary::-webkit-details-marker {
    display: none;
  }
  .storyline-toggle {
    font-family: 'Pirata One', cursive;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    border: 1px solid var(--gold-dim);
    padding: 0.45rem 1rem;
    min-height: var(--control-size);
    display: inline-block;
    transition: all 0.25s;
  }
  .storyline-toggle :global(svg) { margin-left: .45rem; }
  .storyline summary:hover .storyline-toggle,
  .storyline summary:focus-visible .storyline-toggle {
    color: var(--parchment);
    border-color: var(--gold);
    background: rgba(184, 150, 62, 0.08);
  }
  .storyline[open] .storyline-toggle {
    background: rgba(184, 150, 62, 0.1);
    color: var(--parchment);
  }

  .story-timeline {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0 0 0 1.9rem;
    position: relative;
  }
  .story-timeline::before {
    content: '';
    position: absolute;
    left: 0.65rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: linear-gradient(var(--gold-dim), var(--border));
  }
  .story-chapter {
    position: relative;
    padding-bottom: 1.5rem;
  }
  .story-chapter:last-child {
    padding-bottom: 0;
  }
  .profile-section .story-chapter::before {
    content: none;
  }
  .story-marker {
    position: absolute;
    left: -1.9rem;
    top: 0;
    width: 1.35rem;
    text-align: center;
    font-size: 0.95rem;
    color: var(--gold);
    background: var(--bg-panel);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7));
  }
  .story-chapter h5 {
    font-family: 'Pirata One', cursive;
    font-size: 1.15rem;
    color: var(--parchment);
    font-weight: normal;
    letter-spacing: 0.04em;
  }
  .story-chapter h5 a { color: inherit; text-underline-offset: .2em; }
  .story-chapter h5 a:hover { color: var(--gold); }
  .story-meta {
    display: block;
    font-size: var(--text-ui);
    font-variant: small-caps;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    margin-bottom: 0.35rem;
  }
  .story-result.victory { color: var(--gold); }
  .story-result.defeat { color: var(--blood-bright); }
  .story-result.draw { color: var(--ink-dim); }
  .story-text {
    font-size: var(--text-body);
    color: var(--ink-dim);
    margin: 0.25rem 0;
  }
  .story-text strong {
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-weight: normal;
  }
  .story-highlight strong { color: var(--gold); }
  .story-lowlight strong { color: var(--blood-bright); }
  .story-fell .story-marker,
  .story-fell h5 {
    color: var(--blood-bright);
  }
  .story-grave .story-marker { filter: grayscale(0.5); }
  .story-epitaph {
    font-style: italic;
    color: var(--parchment);
  }
  .story-alive h5 { color: var(--gold); }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#member-dialog')!;
  const body = dialog.querySelector<HTMLElement>('.dialog-body')!;
  const profiles = [...dialog.querySelectorAll<HTMLElement>('[data-profile]')];
  let opener: HTMLButtonElement | null = null;

  document.querySelectorAll<HTMLButtonElement>('.member-card').forEach((card) => {
    card.addEventListener('click', () => {
      const key = `${card.dataset.warband}:${card.dataset.member}`;
      const profile = profiles.find((p) => p.dataset.profile === key);
      const heading = profile?.querySelector<HTMLElement>('h3');
      if (!profile || !heading) throw new Error(`Missing warrior profile: ${key}`);
      opener = card;
      profiles.forEach((p) => {
        p.hidden = p !== profile;
        p.querySelectorAll<HTMLDetailsElement>('details').forEach(
          (d) => (d.open = d.dataset.defaultOpen === 'true')
        );
      });
      dialog.setAttribute('aria-labelledby', heading.id);
      dialog.showModal();
      heading.focus({ preventScroll: true });
      body.scrollTop = 0;
    });
  });

  document.getElementById('modal-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));
  dialog.addEventListener('click', (e) => {
    const bounds = dialog.getBoundingClientRect();
    if (e.target === dialog && (e.clientX < bounds.left || e.clientX > bounds.right || e.clientY < bounds.top || e.clientY > bounds.bottom)) dialog.close();
  });
</script>
