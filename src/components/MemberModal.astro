---
import { warbands } from '../data/warbands';
import { getMemberStory } from '../data/history';

const statKeys = ['M', 'WS', 'BS', 'S', 'T', 'W', 'I', 'A', 'Ld'] as const;

const resultLabel = { victory: 'Victory', defeat: 'Defeat', draw: 'Draw' } as const;
---

<dialog id="member-dialog" class="member-dialog">
  <button class="modal-close" id="modal-close" aria-label="Close">✕</button>
  {
    warbands.map((wb) =>
      wb.members.map((m) => (
        <div class="profile" data-profile={`${wb.id}:${m.id}`} hidden>
          <div class="profile-header">
            <span class="profile-portrait" aria-hidden="true">{m.portrait}</span>
            <div>
              <h3>{m.name}</h3>
              <span class="member-role">
                {m.role} — {wb.name}
                {m.dead && <span class="dead-marker"> ✝ Fallen</span>}
              </span>
            </div>
          </div>
          <table class="statline">
            <thead>
              <tr>{statKeys.map((k) => <th>{k}</th>)}</tr>
            </thead>
            <tbody>
              <tr>{statKeys.map((k) => <td>{m.stats[k]}</td>)}</tr>
            </tbody>
          </table>
          <div class="profile-section">
            <h4>Equipment</h4>
            <ul>{m.equipment.map((e) => <li>{e}</li>)}</ul>
            {m.skills.length > 0 && (
              <>
                <h4>Skills & Special Rules</h4>
                <ul>{m.skills.map((s) => <li>{s}</li>)}</ul>
              </>
            )}
            <h4>Tale</h4>
            <p class="profile-lore">{m.lore}</p>
            <details class="storyline" data-default-open={m.rank === 'hero' ? 'true' : 'false'} open={m.rank === 'hero'}>
              <summary>
                <span class="storyline-toggle">📜 Follow their story</span>
              </summary>
              <ol class="story-timeline">
                <li class="story-chapter story-backstory">
                  <span class="story-marker" aria-hidden="true">✦</span>
                  <h5>The Tale Begins</h5>
                  <span class="story-meta">{m.epithet} — {wb.name}</span>
                  <p class="story-text">{m.lore}</p>
                </li>
                {getMemberStory(m.id).map((entry) => (
                  <li
                    class:list={[
                      'story-chapter',
                      { 'story-fell': entry.snapshot.status === 'dead' },
                    ]}
                  >
                    <span class="story-marker" aria-hidden="true">
                      {entry.snapshot.status === 'dead' ? '✝' : '⚔'}
                    </span>
                    <h5>{entry.scenario.scenario}</h5>
                    <span class="story-meta">
                      {entry.scenario.date} —{' '}
                      <span class:list={['story-result', entry.warband.result]}>
                        {resultLabel[entry.warband.result]}
                      </span>
                      {entry.snapshot.status === 'dead' && (
                        <span class="dead-marker"> ✝ Fell in battle</span>
                      )}
                    </span>
                    <p class="story-text story-highlight">
                      <strong>Finest moment:</strong> {entry.snapshot.highlight}
                    </p>
                    <p class="story-text story-lowlight">
                      <strong>Darkest moment:</strong> {entry.snapshot.lowlight}
                    </p>
                  </li>
                ))}
                {m.dead && m.death ? (
                  <li class="story-chapter story-grave">
                    <span class="story-marker" aria-hidden="true">🪦</span>
                    <h5>The Tale Ends</h5>
                    <span class="story-meta">Laid to rest — {m.death.date}</span>
                    <p class="story-text story-epitaph">{m.death.epitaph}</p>
                  </li>
                ) : (
                  <li class="story-chapter story-alive">
                    <span class="story-marker" aria-hidden="true">🕯</span>
                    <h5>The Tale Continues…</h5>
                    <span class="story-meta">Still walks the streets of Mordheim</span>
                  </li>
                )}
              </ol>
            </details>
          </div>
        </div>
      ))
    )
  }
</dialog>

<style>
  .member-dialog {
    background: linear-gradient(160deg, var(--bg-panel2), var(--bg-panel));
    border: 1px solid var(--gold-dim);
    box-shadow: 0 0 80px rgba(0, 0, 0, 0.9), 0 0 30px rgba(184, 150, 62, 0.1);
    max-width: 560px;
    width: calc(100% - 2rem);
    max-height: 88vh;
    overflow-y: auto;
    padding: 2rem;
    color: var(--ink);
  }
  .member-dialog::backdrop {
    background: rgba(5, 6, 8, 0.85);
    backdrop-filter: blur(3px);
  }
  .member-dialog[open] {
    animation: modal-in 0.3s ease;
  }
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(20px) scale(0.97); }
    to   { opacity: 1; transform: none; }
  }

  .modal-close {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    background: none;
    border: 1px solid var(--border);
    color: var(--ink-dim);
    font-size: 1rem;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .modal-close:hover {
    color: var(--blood-bright);
    border-color: var(--blood);
  }

  .profile-header {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    border-bottom: 2px solid var(--gold-dim);
    padding-bottom: 1rem;
    margin-bottom: 1rem;
  }
  .profile-portrait {
    font-size: 3.4rem;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.7));
  }
  .profile-header h3 {
    font-family: 'Pirata One', cursive;
    font-size: 1.9rem;
    color: var(--parchment);
    font-weight: normal;
  }
  .profile-header .member-role {
    font-size: 0.9rem;
    color: var(--blood-bright);
    font-variant: small-caps;
    letter-spacing: 0.1em;
  }
  .dead-marker { color: var(--blood-bright); }

  .statline {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }
  .statline th,
  .statline td {
    border: 1px solid var(--border);
    text-align: center;
    padding: 0.35rem 0.2rem;
    font-size: 0.9rem;
  }
  .statline th {
    font-family: 'Pirata One', cursive;
    color: var(--gold);
    background: rgba(184, 150, 62, 0.06);
    letter-spacing: 0.05em;
    font-weight: normal;
  }

  .profile-section h4 {
    font-variant: small-caps;
    letter-spacing: 0.15em;
    color: var(--blood-bright);
    margin: 1rem 0 0.3rem;
    font-size: 0.95rem;
  }
  .profile-section ul { list-style: none; padding: 0; margin: 0; }
  .profile-section li::before { content: '⚔ '; color: var(--gold-dim); }
  .profile-lore {
    font-style: italic;
    color: var(--ink-dim);
    font-size: 0.95rem;
  }

  .storyline {
    margin-top: 1.4rem;
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .storyline summary {
    list-style: none;
    cursor: pointer;
    display: inline-block;
  }
  .storyline summary::-webkit-details-marker {
    display: none;
  }
  .storyline-toggle {
    font-family: 'Pirata One', cursive;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    border: 1px solid var(--gold-dim);
    padding: 0.45rem 1rem;
    display: inline-block;
    transition: all 0.25s;
  }
  .storyline summary:hover .storyline-toggle,
  .storyline summary:focus-visible .storyline-toggle {
    color: var(--parchment);
    border-color: var(--gold);
    background: rgba(184, 150, 62, 0.08);
  }
  .storyline[open] .storyline-toggle {
    background: rgba(184, 150, 62, 0.1);
    color: var(--parchment);
  }

  .story-timeline {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 0 0 0 1.9rem;
    position: relative;
  }
  .story-timeline::before {
    content: '';
    position: absolute;
    left: 0.65rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: linear-gradient(var(--gold-dim), var(--border));
  }
  .story-chapter {
    position: relative;
    padding-bottom: 1.5rem;
  }
  .story-chapter:last-child {
    padding-bottom: 0;
  }
  .story-chapter::before {
    content: none;
  }
  .story-marker {
    position: absolute;
    left: -1.9rem;
    top: 0;
    width: 1.35rem;
    text-align: center;
    font-size: 0.95rem;
    color: var(--gold);
    background: var(--bg-panel);
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.7));
  }
  .story-chapter h5 {
    font-family: 'Pirata One', cursive;
    font-size: 1.15rem;
    color: var(--parchment);
    font-weight: normal;
    letter-spacing: 0.04em;
  }
  .story-meta {
    display: block;
    font-size: 0.78rem;
    font-variant: small-caps;
    letter-spacing: 0.1em;
    color: var(--ink-dim);
    margin-bottom: 0.35rem;
  }
  .story-result.victory { color: var(--gold); }
  .story-result.defeat { color: var(--blood-bright); }
  .story-result.draw { color: var(--ink-dim); }
  .story-text {
    font-size: 0.88rem;
    color: var(--ink-dim);
    margin: 0.25rem 0;
  }
  .story-text strong {
    font-variant: small-caps;
    letter-spacing: 0.08em;
    font-weight: normal;
  }
  .story-highlight strong { color: var(--gold); }
  .story-lowlight strong { color: var(--blood-bright); }
  .story-backstory .story-text {
    font-style: italic;
  }
  .story-fell .story-marker,
  .story-fell h5 {
    color: var(--blood-bright);
  }
  .story-grave .story-marker { filter: grayscale(0.5); }
  .story-epitaph {
    font-style: italic;
    color: var(--parchment);
  }
  .story-alive h5 { color: var(--gold); }
</style>

<script>
  const dialog = document.getElementById('member-dialog') as HTMLDialogElement;
  const profiles = dialog.querySelectorAll<HTMLElement>('[data-profile]');

  document.querySelectorAll<HTMLElement>('.member-card').forEach((card) => {
    card.addEventListener('click', () => {
      const key = `${card.dataset.warband}:${card.dataset.member}`;
      profiles.forEach((p) => {
        p.hidden = p.dataset.profile !== key;
        p.querySelectorAll<HTMLDetailsElement>('.storyline').forEach(
          (d) => (d.open = d.dataset.defaultOpen === 'true')
        );
      });
      dialog.showModal();
    });
  });

  document.getElementById('modal-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>
