---
/**
 * A warrior's story, told the same way wherever it appears: what the taverns call them, what the battles and the
 * nights amount to, and the line itself — every battle and every run of nights in the order they happened, with
 * who they put out of action and who put them out. The home page's dialog and the warband's own page both use it.
 */
import type { Member, Warband } from '../campaign/model';
import type { MemberChapter } from '../server/campaign/scenarios';
import type { MemberNights, NightEntry } from '../curfew/story';
import { dateForNight, locationById } from '../curfew/engine';
import { formatImperial, imperialForDate } from '../lib/calendar';
import Icon from './Icon.astro';
import { base } from '../lib/site';
import '../styles/story.css';

interface Props {
  member: Member;
  /** Their chapters in the played scenarios, oldest first. */
  chapters: MemberChapter[];
  /** What the Curfew nights wrote of them, where a ledger is kept. */
  nights?: MemberNights;
  /** Every warband, so whoever put them out of action can be named. */
  warbands: Warband[];
  /** Whether the line starts unfolded. */
  open?: boolean;
}
const { member: m, chapters, nights: curfew, warbands, open = false } = Astro.props;

const first = m.name.split(' ')[0];
const memberName = (id: string) => warbands.flatMap((w) => w.members).find((x) => x.id === id)?.name ?? id;
const scenarioUrl = (id: string) => `${base}/scenarios/${id}/`;
const imperialOf = (day: string) => formatImperial(imperialForDate(day));
/** A night's date as the Empire writes it, counted on from the first game. */
const imperialDay = (night: number) => formatImperial(imperialForDate(dateForNight(night)), 'day');
const outcomeLabel = { boon: 'a good night', fair: 'a fair night', poor: 'a poor night' } as const;
const resultLabel = { victory: 'Victory', defeat: 'Defeat', draw: 'Draw' } as const;

/** What they did to others in one battle, and what was done to them. Only confirmed results are recorded. */
const tookIn = (c: MemberChapter) => c.scenario.outOfAction.filter((e) => e.attackerId === m.id);
const fellIn = (c: MemberChapter) => c.scenario.outOfAction.filter((e) => e.targetId === m.id);
const took = chapters.flatMap(tookIn);
const fell = chapters.flatMap(fellIn);

/**
 * One line for a warrior's story: the battles from the archives and the nights from the ledger, in the order
 * they happened. Nights between two battles fold into a single row, so the battles carry the eye; the row
 * opens to read them, and one control opens or folds them all.
 */
type Row = { kind: 'battle'; entry: MemberChapter } | { kind: 'nights'; nights: NightEntry[] };
function timeline(): Row[] {
  const items = [
    ...chapters.map((entry) => ({ key: entry.scenario.playedOn, row: { kind: 'battle', entry } as Row })),
    ...(curfew?.entries ?? []).map((e) => ({ key: dateForNight(e.night), row: { kind: 'night', e } as { kind: 'night'; e: NightEntry } })),
  ].sort((a, b) => (a.key < b.key ? -1 : a.key > b.key ? 1 : 0));
  const rows: Row[] = [];
  for (const { row } of items) {
    if (row.kind !== 'night') { rows.push(row); continue; }
    const last = rows.at(-1);
    if (last?.kind === 'nights') last.nights.push(row.e); else rows.push({ kind: 'nights', nights: [row.e] });
  }
  return rows;
}
const rows = timeline();
const nightCount = curfew?.entries.length ?? 0;
const placesOf = (list: NightEntry[]) => [...new Set(list.map((e) => locationById(e.locationId).name))];
const countOf = (n: number, one: string, many: string) => (n === 1 ? `One ${one}` : `${n} ${many}`);
---

{(chapters.length > 0 || took.length > 0 || fell.length > 0) && (
  <p class="story-tally">
    <b>{chapters.length}</b> {chapters.length === 1 ? 'battle' : 'battles'} fought
    {took.length > 0 && <> · <b>{took.length}</b> put out of action</>}
    {fell.length > 0 && <> · out of action <b>{fell.length}</b> {fell.length === 1 ? 'time' : 'times'}</>}
  </p>
)}

{curfew && (curfew.nightsOut > 0 || curfew.epithet || curfew.marks.length > 0) && (
  <div class="nights">
    <h4>Nights in the City</h4>
    <p class="nights-standing">
      {curfew.epithet && <>The taverns call {first} <em>{first} {curfew.epithet}</em> now. </>}
      {curfew.nightsOut > 0 && <>{curfew.nightsOut} {curfew.nightsOut === 1 ? 'night' : 'nights'} out between the battles{curfew.shards > 0 ? `, ${curfew.shards} ${curfew.shards === 1 ? 'shard' : 'shards'} of the green brought home` : ''}. Each is on the line below, folded between the battles; the whole ledger is at <a href={`${base}/curfew/`}>the Curfew</a>.</>}
      {curfew.marks.length > 0 && <> Known for what {first} did at a crossroads: <em>{curfew.marks.map((k) => k.name).join('; ')}</em>.</>}
    </p>
  </div>
)}

{rows.length > 0 || (m.dead && m.death) ? (
  <details class="storyline" data-story data-default-open={open ? 'true' : 'false'} open={open}>
    <summary>
      <span class="storyline-toggle">Follow their story <Icon name="arrow-down" size={14} /></span>
    </summary>
    {nightCount > 0 && (
      <div class="story-tools">
        <button type="button" class="story-fold" data-fold-nights aria-pressed="false">Show the nights</button>
        <span class="story-tools-note">{countOf(nightCount, 'night is', 'nights are')} folded between the battles.</span>
      </div>
    )}
    <ol class="story-timeline">
      {rows.map((row) => row.kind === 'battle' ? (
        <li class:list={['story-chapter', { 'story-fell': row.entry.snapshot.status === 'dead' }]}>
          <span class="story-marker" aria-hidden="true">
            {row.entry.snapshot.status === 'dead' ? <Icon name="cross" size={14} /> : <Icon name="swords" size={14} />}
          </span>
          <h5><a href={scenarioUrl(row.entry.scenario.id)}>{row.entry.scenario.title}</a></h5>
          <span class="story-meta">
            {imperialOf(row.entry.scenario.playedOn)} —{' '}
            <span class:list={['story-result', row.entry.warband.result ?? 'draw']}>
              {row.entry.warband.result ? resultLabel[row.entry.warband.result] : 'Fought'}
            </span>
            {row.entry.snapshot.status === 'dead' && <span class="dead-marker"> <Icon name="cross" size={12} /> Fell in battle</span>}
          </span>
          {row.entry.snapshot.highlight.trim() && <p class="story-text story-highlight"><strong>Finest moment:</strong> {row.entry.snapshot.highlight}</p>}
          {row.entry.snapshot.lowlight.trim() && <p class="story-text story-lowlight"><strong>Darkest moment:</strong> {row.entry.snapshot.lowlight}</p>}
          {tookIn(row.entry).length > 0 && (
            <p class="story-text story-took">
              <strong>Put out of action:</strong>{' '}
              {tookIn(row.entry).map((e, i) => <>{i > 0 ? '; ' : ''}{e.targetId ? <a href={`${scenarioUrl(row.entry.scenario.id)}#member-${e.targetId}`}>{e.target}</a> : e.target}{e.detail ? ` — ${e.detail}` : ''}</>)}
            </p>
          )}
          {fellIn(row.entry).length > 0 && (
            <p class="story-text story-lowlight">
              <strong>Taken out by:</strong>{' '}
              {fellIn(row.entry).map((e, i) => <>{i > 0 ? '; ' : ''}{memberName(e.attackerId)}{e.detail ? ` — ${e.detail}` : ''}</>)}
            </p>
          )}
        </li>
      ) : (
        <li class="story-chapter story-nights-row">
          <span class="story-marker story-marker-night" aria-hidden="true"><Icon name="moon" size={13} /></span>
          <details class="story-nights" data-nights data-default-open="false">
            <summary>
              <span class="story-nights-title">{countOf(row.nights.length, 'night', 'nights')} in {placesOf(row.nights).join(' and ')}</span>
              <span class="story-meta">{row.nights.length === 1 ? imperialDay(row.nights[0].night) : `${imperialDay(row.nights[0].night)} to ${imperialDay(row.nights[row.nights.length - 1].night)}`}</span>
            </summary>
            <ol class="nights-list">
              {row.nights.map((e) => (
                <li>
                  <span class="nights-night">Night {e.night} · {imperialDay(e.night)}</span>
                  <p>{e.prose}{e.choice ? ` ${e.choice.setup}` : ''}</p>
                  {e.choice && <p class="nights-choice"><span class="nights-choice-label">What {first} did</span> <em>{e.choice.label}</em> {e.choice.outcome}</p>}
                  <span class="nights-meta">{e.errandLabel}, {e.standing ? 'on standing orders' : outcomeLabel[e.outcome]}{e.token ? ` · brought back ${e.token}` : ''}{e.rumour ? ' · heard a rumour' : ''}{e.choice?.defaulted ? ' · decided alone' : ''}</span>
                </li>
              ))}
            </ol>
          </details>
        </li>
      ))}
      {m.dead && m.death ? (
        <li class="story-chapter story-grave">
          <span class="story-marker" aria-hidden="true"><Icon name="cross" size={14} /></span>
          <h5>The Tale Ends</h5>
          <span class="story-meta">Laid to rest{m.death.date ? ` — ${m.death.date}` : ''}</span>
          {m.death.epitaph && <p class="story-text story-epitaph">{m.death.epitaph}</p>}
        </li>
      ) : (
        <li class="story-chapter story-alive">
          <span class="story-marker" aria-hidden="true"><Icon name="diamond" size={12} /></span>
          <h5>The Tale Continues…</h5>
          <span class="story-meta">Still out after curfew</span>
        </li>
      )}
    </ol>
  </details>
) : (
  <p class="story-empty">
    {m.dead ? 'Their tale has ended. No battles or nights have yet been recorded.' : 'The tale continues. No battles or nights have yet been recorded.'}
  </p>
)}

<style>
  .story-tally { margin-top: 1.2rem; padding-top: .9rem; border-top: 1px solid var(--border); color: var(--ink-dim); font: var(--text-ui)/1.6 var(--font-utility); font-variant: small-caps; letter-spacing: .06em; }
  .story-tally b { color: var(--gold); font-weight: normal; font-variant-numeric: tabular-nums; }
  .nights { margin-top: 1.2rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .nights h4 { color: var(--gold); font-size: 1rem; margin-bottom: .4rem; font-variant: small-caps; letter-spacing: .06em; font-weight: normal; }
  .nights-standing { color: var(--ink-dim); font-size: var(--text-body); margin-bottom: .8rem; }
  .nights-standing em { color: var(--parchment); font-style: italic; }
  .nights-standing a { color: var(--gold); text-underline-offset: .2em; }
  .story-empty { color: var(--ink-dim); border-top: 1px solid var(--border); margin-top: 1.5rem; padding-top: 1rem; font-size: var(--text-body); }
  .storyline { margin-top: 1.4rem; border-top: 1px solid var(--border); padding-top: 1rem; }
  .storyline summary { list-style: none; cursor: pointer; display: inline-block; }
  .storyline summary::-webkit-details-marker { display: none; }
  .storyline-toggle {
    font-family: 'Pirata One', cursive;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: var(--gold);
    border: 1px solid var(--gold-dim);
    padding: 0.45rem 1rem;
    min-height: var(--control-size);
    display: inline-block;
    transition: all 0.25s;
  }
  .storyline-toggle :global(svg) { margin-left: .45rem; }
  .storyline summary:hover .storyline-toggle,
  .storyline summary:focus-visible .storyline-toggle { color: var(--parchment); border-color: var(--gold); background: rgba(184, 150, 62, 0.08); }
  .storyline[open] .storyline-toggle { background: rgba(184, 150, 62, 0.1); color: var(--parchment); }
  .dead-marker { color: var(--blood-bright); }
</style>

<script>
  import { wireNightFolds } from '../lib/story';
  wireNightFolds();
</script>
