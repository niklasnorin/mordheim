---
import type { Warband } from '../data/warbands';
import Icon from './Icon.astro';

interface Props {
  warband: Warband;
}

const { warband } = Astro.props;
---

<article class="warband-card reveal" class:list={{ 'warband-ostland': warband.type === 'Ostlanders' }}>
  <div class="warband-header">
    <span class="warband-sigil" aria-hidden="true">
      {warband.crest ? <img src={`${import.meta.env.BASE_URL}/${warband.crest}`} width="120" height="140" alt="" loading="lazy" /> : warband.sigil}
    </span>
    <div class="warband-title">
      <span class="warband-register">Registered company · {warband.members.length} souls</span>
      <h3>{warband.name}</h3>
      <span class="warband-type">{warband.type}{warband.player && ` — led by ${warband.player}`}</span>
    </div>
    <div class="warband-stats">
      <span class="rating">{warband.rating}</span>
      Warband Rating
    </div>
  </div>
  {warband.lore.trim() && <div class="warband-lore"><p>{warband.lore}</p></div>}
  <div class="roster-heading"><span>The muster roll</span><span>Select a warrior to uncover their tale</span></div>
  <div class="member-grid">
    {
      warband.members.map((m, index) => (
        <button
          class:list={['member-card', { 'member-dead': m.dead }]}
          data-warband={warband.id}
          data-member={m.id}
          type="button"
          aria-haspopup="dialog"
          aria-controls="member-dialog"
        >
          <span class="member-portrait" aria-hidden="true">
            <span class="member-number">{(index + 1).toString().padStart(2, '0')}</span>
            {m.dead ? <Icon name="cross" size={16} /> : <Icon name="diamond" size={14} />}
          </span>
          <span class="member-name">{m.name}</span>
          <span class="member-role">{m.role}</span>
          <span class="member-tag">
            {m.epithet}
            {m.dead && <span class="dead-marker"> <Icon name="cross" size={11} /> Fallen</span>}
          </span>
          <span class="member-open" aria-hidden="true"><span>Read the record</span> <Icon name="arrow-up-right" size={16} /></span>
        </button>
      ))
    }
  </div>
</article>

<style>
  .warband-card {
    position: relative;
    background: linear-gradient(160deg, var(--bg-panel2), var(--bg-panel));
    border: 1px solid #79623c70;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .warband-card::before { content: ''; position: absolute; top: 0; left: 1.5rem; right: 1.5rem; height: 2px; background: linear-gradient(90deg, transparent, var(--gold-dim), transparent); }
  .warband-register { display: block; font: var(--text-meta)/1.6 var(--font-utility); color: var(--ink-dim); text-transform: uppercase; letter-spacing: .08em; margin-bottom: .45rem; }
  .warband-title { min-width: 0; }

  .warband-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.8rem 2rem;
    border-bottom: 1px solid var(--border);
    background: repeating-linear-gradient(120deg, transparent 0 5px, #b69a6203 5px 6px), linear-gradient(90deg, #68744b18, transparent 70%);
  }
  .warband-ostland .warband-header { background-color: #773a2714; }
  .warband-sigil img { display: block; width: 76px; height: auto; }
  .warband-sigil {
    font: 1.5rem/1 var(--font-utility);
    line-height: 1;
    flex-shrink: 0;
    filter: drop-shadow(0 5px 8px #0007);
  }
  .warband-title h3 {
    font-family: 'Pirata One', cursive;
    font-size: 2rem;
    letter-spacing: 0.05em;
    color: var(--parchment);
    font-weight: normal;
    overflow-wrap: anywhere;
  }
  .warband-title .warband-type {
    font-size: var(--text-ui);
    color: var(--gold);
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }
  .warband-stats {
    margin-left: auto;
    text-align: right;
    font: var(--text-ui)/1.5 var(--font-utility);
    color: var(--ink-dim);
    white-space: nowrap;
  }
  .warband-stats .rating {
    display: block;
    font-family: var(--font-utility);
    font-size: 2.5rem;
    line-height: 1.3;
    color: var(--gold);
  }

  .warband-lore {
    padding: 1.5rem 2rem;
    font-style: italic;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-body);
  }
  .warband-lore p { max-width: 72ch; }
  .roster-heading { padding: .75rem 2rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .25rem 1rem; color: var(--gold); font: var(--text-ui)/1.5 var(--font-utility); border-bottom: 1px solid var(--border); }
  .roster-heading span:last-child { color: var(--ink-dim); }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    background: var(--bg-panel);
  }

  .member-card {
    position: relative;
    background: var(--bg-panel);
    padding: 1.3rem 1.5rem;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
    border: none;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    text-align: left;
    font-family: inherit;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
    display: block;
    width: 100%;
    overflow-wrap: anywhere;
  }
  .member-card:focus-visible { outline-offset: -3px; }
  .member-card:hover,
  .member-card:focus-visible {
    background: #20271f;
    transform: translateY(-2px);
  }
  .member-card:hover .member-name,
  .member-card:focus-visible .member-name {
    color: var(--gold);
  }
  .member-card .member-portrait {
    font-size: 1.2rem;
    float: right;
    color: var(--gold-dim);
    margin-left: .7rem;
    text-align: center;
  }
  .member-number { display: block; font: var(--text-meta)/1.8 var(--font-utility); color: var(--ink-dim); }
  .member-open { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: 1rem; border-top: 1px solid #343b2e80; padding-top: .55rem; color: var(--gold); font: var(--text-ui)/1.5 var(--font-utility); }
  .member-open :global(svg) { flex-shrink: 0; }
  .member-name {
    display: block;
    font-family: 'Pirata One', cursive;
    font-size: 1.15rem;
    color: var(--parchment);
    transition: color 0.25s;
  }
  .member-role {
    display: block;
    font-size: var(--text-ui);
    color: var(--blood-bright);
    font-variant: small-caps;
    letter-spacing: 0.04em;
  }
  .member-tag {
    font-size: var(--text-ui);
    color: var(--ink-dim);
    font-style: italic;
    margin-top: 0.35rem;
    display: block;
  }
  .member-dead { background: #101411; }
  .member-dead .member-name { text-decoration: line-through; }
  .dead-marker { color: var(--blood-bright); font-style: normal; }

  @media (max-width: 700px) {
    .warband-header { flex-wrap: wrap; }
    .warband-stats { margin-left: 0; text-align: left; }
  }
  @media (max-width: 540px) {
    .warband-header { padding: 1.4rem 1rem; gap: 1rem; }
    .warband-sigil img { width: 56px; }
    .warband-title { flex: 1; min-width: 0; }
    .warband-title h3 { font-size: 1.6rem; }
    .warband-stats { width: 100%; border-top: 1px solid var(--border); padding-top: .6rem; display: flex; align-items: center; gap: .7rem; }
    .warband-stats .rating { font-size: 1.5rem; }
    .warband-lore { padding: 1rem; }
    .roster-heading { padding-inline: 1rem; }
    .member-grid { grid-template-columns: 1fr; }
    .member-card { padding: .9rem 3rem .9rem 1rem; border-right: 0; }
    .member-card .member-portrait { display: none; }
    .member-open { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); padding: 0; border: 0; margin: 0; }
    .member-open > span { display: none; }
    .member-tag { margin-top: .2rem; }
  }
</style>
