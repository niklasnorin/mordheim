---
import { leaderOf, type Warband } from '../campaign/model';
import Icon from './Icon.astro';
import { asset, base } from '../lib/site';

interface Props {
  warband: Warband;
}

const { warband } = Astro.props;
// The home page shows who leads them; the rest of the roll is on the warband's own page.
const leader = leaderOf(warband);
const rest = warband.members.length - (leader ? 1 : 0);
const href = `${base}/warbands/${warband.id}/`;
---

<article class="warband-card reveal" class:list={{ 'warband-ostland': warband.type === 'Ostlanders' }}>
  <div class="warband-header">
    <span class="warband-sigil" aria-hidden="true">
      {warband.crest ? <img src={asset(warband.crest)} width="120" height="140" alt="" loading="lazy" /> : warband.sigil}
    </span>
    <div class="warband-title">
      <h3>{warband.name}</h3>
      <span class="warband-type">{warband.type}{warband.player && ` — led by ${warband.player}`}</span>
    </div>
  </div>
  {warband.lore.trim()
    ? <div class="warband-lore"><p>{warband.lore}</p></div>
    : <div class="warband-lore warband-lore-empty"><p>Their overview is not written yet. <a href={`${base}/warbands/${warband.id}/#record`}>Write the overview <Icon name="arrow-up-right" size={14} /></a></p></div>}
  {leader && (
    <button
      class:list={['member-card', { 'member-dead': leader.dead }]}
      data-warband={warband.id}
      data-member={leader.id}
      type="button"
      aria-haspopup="dialog"
      aria-controls="member-dialog"
    >
      <span class="member-portrait" aria-hidden="true">
        {leader.dead ? <Icon name="cross" size={16} /> : <Icon name="diamond" size={14} />}
      </span>
      <span class="member-name">{leader.name}</span>
      <span class="member-role">{leader.role}</span>
      <span class="member-tag">
        {leader.epithet}
        {leader.dead && <span class="dead-marker"> <Icon name="cross" size={11} /> Fallen</span>}
      </span>
      <span class="member-open" aria-hidden="true"><span>Read the record</span> <Icon name="arrow-up-right" size={16} /></span>
    </button>
  )}
  <a class="warband-more" href={href}>
    <span>{rest > 0 ? `The whole warband: ${rest} more ${rest === 1 ? 'warrior' : 'warriors'} and their chronicle` : 'The warband’s page and their chronicle'}</span>
    <Icon name="arrow-right" size={16} />
  </a>
</article>

<style>
  .warband-card {
    position: relative;
    background: linear-gradient(160deg, var(--bg-panel2), var(--bg-panel));
    border: 1px solid #79623c70;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    /* in a row of cards the leader and the link sit at the foot of each, whatever the length of the backstory */
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .warband-lore { flex: 1; }
  .warband-card::before { content: ''; position: absolute; top: 0; left: 1.5rem; right: 1.5rem; height: 2px; background: linear-gradient(90deg, transparent, var(--gold-dim), transparent); }
  .warband-title { min-width: 0; }

  .warband-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.5rem;
    border-bottom: 1px solid var(--border);
    background: repeating-linear-gradient(120deg, transparent 0 5px, #b69a6203 5px 6px), linear-gradient(90deg, #68744b18, transparent 70%);
  }
  .warband-ostland .warband-header { background-color: #773a2714; }
  .warband-sigil img { display: block; width: 76px; height: auto; }
  .warband-sigil {
    font: 1.5rem/1 var(--font-utility);
    line-height: 1;
    flex-shrink: 0;
    filter: drop-shadow(0 5px 8px #0007);
  }
  .warband-title h3 {
    font-family: 'Pirata One', cursive;
    font-size: 1.8rem;
    letter-spacing: 0.05em;
    color: var(--parchment);
    font-weight: normal;
    overflow-wrap: anywhere;
  }
  .warband-title .warband-type {
    font-size: var(--text-ui);
    color: var(--gold);
    font-variant: small-caps;
    letter-spacing: 0.06em;
  }
  .warband-lore {
    padding: 1.25rem 1.5rem;
    font-style: italic;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-body);
  }
  .warband-lore p { max-width: 72ch; }
  .warband-lore-empty p { display: flex; align-items: center; gap: .5rem 1rem; flex-wrap: wrap; }
  .warband-lore-empty a { display: inline-flex; align-items: center; gap: .35rem; min-height: 2.25rem; font-style: normal; color: var(--gold); font: var(--text-ui)/1.5 var(--font-utility); text-underline-offset: .2em; }
  .warband-lore-empty a:hover { color: var(--parchment); }

  .warband-more { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.25rem; padding: .8rem 1.5rem; color: var(--gold); background: #141b17; font: var(--text-ui)/1.5 var(--font-utility); text-transform: uppercase; letter-spacing: .08em; text-decoration: none; transition: background .2s, color .2s; }
  .warband-more :global(svg) { flex-shrink: 0; transition: transform .2s; }
  .warband-more:hover, .warband-more:focus-visible { background: #1f2823; color: var(--parchment); }
  .warband-more:hover :global(svg) { transform: translateX(3px); }
  .warband-more:focus-visible { outline-offset: -3px; }

  .member-card {
    position: relative;
    background: var(--bg-panel);
    padding: 1.2rem 1.5rem;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
    border: none;
    border-bottom: 1px solid var(--border);
    text-align: left;
    font-family: inherit;
    color: inherit;
    font-size: inherit;
    line-height: inherit;
    display: block;
    width: 100%;
    overflow-wrap: anywhere;
  }
  .member-card:focus-visible { outline-offset: -3px; }
  .member-card:hover,
  .member-card:focus-visible {
    background: #20271f;
    transform: translateY(-2px);
  }
  .member-card:hover .member-name,
  .member-card:focus-visible .member-name {
    color: var(--gold);
  }
  .member-card .member-portrait {
    font-size: 1.2rem;
    float: right;
    color: var(--gold-dim);
    margin-left: .7rem;
    text-align: center;
  }
  .member-open { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-top: 1rem; border-top: 1px solid #343b2e80; padding-top: .55rem; color: var(--gold); font: var(--text-ui)/1.5 var(--font-utility); }
  .member-open :global(svg) { flex-shrink: 0; }
  .member-name {
    display: block;
    font-family: 'Pirata One', cursive;
    font-size: 1.15rem;
    color: var(--parchment);
    transition: color 0.25s;
  }
  .member-role {
    display: block;
    font-size: var(--text-ui);
    color: var(--blood-bright);
    font-variant: small-caps;
    letter-spacing: 0.04em;
  }
  .member-tag {
    font-size: var(--text-ui);
    color: var(--ink-dim);
    font-style: italic;
    margin-top: 0.35rem;
    display: block;
  }
  .member-dead { background: #101411; }
  .member-dead .member-name { text-decoration: line-through; }
  .dead-marker { color: var(--blood-bright); font-style: normal; }

  @media (max-width: 700px) {
    .warband-header { flex-wrap: wrap; }
  }
  @media (max-width: 540px) {
    .warband-header { padding: 1.4rem 1rem; gap: 1rem; }
    .warband-sigil img { width: 56px; }
    .warband-title { flex: 1; min-width: 0; }
    .warband-title h3 { font-size: 1.6rem; }
    .warband-lore { padding: 1rem; }
    .warband-more { padding-inline: 1rem; }
    .member-card { padding: .9rem 3rem .9rem 1rem; }
    .member-card .member-portrait { display: none; }
    .member-open { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); padding: 0; border: 0; margin: 0; }
    .member-open > span { display: none; }
    .member-tag { margin-top: .2rem; }
  }
</style>
