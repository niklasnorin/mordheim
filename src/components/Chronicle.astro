---
import { chronicle } from '../data/chronicle';
import { getScenarioUrl } from '../data/history';
import Icon from './Icon.astro';
---

<section id="chronicle" class="chronicle reveal">
  <p class="chronicle-label">An account of blood &amp; wyrdstone</p>
  <h2 class="section-title"><span class="ornament"><Icon name="cross" /></span> The Chronicle <span class="ornament"><Icon name="cross" /></span></h2>
  <div class="timeline">
    {
      chronicle.map((entry, index) => (
        <div class="timeline-entry">
          <span class="timeline-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="timeline-date">{entry.date}</span>
          <h3><a href={getScenarioUrl(entry.scenarioId)}>{entry.title}</a></h3>
          <p>{entry.body}</p>
          <a class="report-link" href={getScenarioUrl(entry.scenarioId)} aria-label={`Read battle report: ${entry.title}`}>
            Read battle report <Icon name="arrow-right" size={14} />
          </a>
        </div>
      ))
    }
  </div>
</section>

<style>
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--gold); text-decoration: underline; }
  .report-link { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1rem; color: var(--gold); text-underline-offset: .25em; }
  .chronicle-label {
    text-align: center;
    margin-bottom: 0.8rem;
    color: #b69a62;
    font: 0.62rem/1.6 Georgia, serif;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .timeline {
    position: relative;
    max-width: 860px;
    margin: 0 auto;
    padding-left: 3.4rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 1rem;
    top: 1rem;
    bottom: 0;
    width: 1px;
    background: linear-gradient(#b69a62, #514936 80%, transparent);
  }
  .timeline-entry {
    position: relative;
    margin-bottom: 1.4rem;
    background: linear-gradient(110deg, rgba(182, 154, 98, 0.045), transparent 70%);
    border-top: 1px solid #444636;
    border-bottom: 1px solid rgba(182, 154, 98, 0.1);
    padding: 1.6rem 4rem 1.8rem 1.6rem;
  }
  .timeline-entry::before {
    content: '';
    position: absolute;
    left: -2.68rem;
    top: 1.85rem;
    width: 0.55rem;
    height: 0.55rem;
    background: #101715;
    border: 1px solid #b69a62;
    transform: rotate(45deg);
    box-shadow: 0 0 0 5px #101715;
  }
  .timeline-entry:first-child::before { background: #b69a62; }
  .timeline-number {
    position: absolute;
    right: 1.2rem;
    top: 1.2rem;
    color: #8e8060;
    font: 1.8rem/1 Georgia, serif;
    font-style: italic;
  }
  .timeline-date {
    font-size: 0.68rem;
    color: #b69a62;
    font-variant: small-caps;
    letter-spacing: 0.12em;
  }
  .timeline-entry h3 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.25rem, 2.4vw, 1.6rem);
    line-height: 1.3;
    color: #e7dcc5;
    margin: 0.6rem 0 0.7rem;
    font-weight: normal;
  }
  .timeline-entry p {
    font-size: 0.94rem;
    line-height: 1.85;
    color: #b8b9a9;
  }
  .timeline-entry:first-child p::first-letter {
    float: left;
    margin: 0.1rem 0.5rem 0 0;
    padding: 0.2rem 0.4rem;
    border: 1px solid #695737;
    color: #c5aa78;
    background: #3b2421;
    font: 2.2rem/1 'UnifrakturMaguntia', Georgia, serif;
  }
  @media (max-width: 700px) {
    .timeline { padding-left: 1.5rem; }
    .timeline::before { left: 0.3rem; }
    .timeline-entry { padding: 1.2rem 1rem; }
    .timeline-entry::before { left: -1.48rem; top: 1.5rem; }
    .timeline-number { position: static; float: right; font-size: 1.2rem; margin-left: 0.6rem; }
    .timeline-date { font-size: 0.62rem; letter-spacing: 0.08em; }
    .chronicle-label { font-size: 0.55rem; letter-spacing: 0.1em; }
  }
</style>
