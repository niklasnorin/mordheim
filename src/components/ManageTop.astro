---
/** The thin bar above every management page: the way back, the crumbs, who is signed in. */
import { base } from '../lib/site';
import type { Actor } from '../server/roles';

interface Props { crumbs: { label: string; href?: string }[]; viewer: Actor | null }
const { crumbs, viewer } = Astro.props;
---

<header class="mg-top">
  <nav class="mg-crumbs" aria-label="Breadcrumb">
    <a href={`${base}/`}>Mordheim</a>
    {crumbs.map((c) => (<><span aria-hidden="true">/</span>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page" style="color:var(--parchment)">{c.label}</span>}</>))}
  </nav>
  <span class="mg-who">{viewer ? <>{viewer.name}{viewer.role !== 'player' && <> · {viewer.role === 'admin' ? 'Admin' : 'Game Master'}</>}</> : <a href={`${base}/curfew/`}>Sign in at the Curfew</a>}</span>
</header>
