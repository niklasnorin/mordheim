---
// One warband's reckoning at the Fountain Post (campaign/jobs.ts), as the Watch House shows it: what is owed, the
// ceiling it is held under, the jobs drawn and what each pays. Every warband is offered the usual work; one behind the
// pace is offered its owed jobs on top. Each roll is the post's, or the table's typed in its box: a D66 for which notice,
// 2D6 for the gold, a D6 for the experience (part of the page's reckon form, carried in the address). The post
// is a dry run for now: nothing here takes the jobs.
import { diceKey, type Offer } from '../server/campaign/jobs';
import type { PointOfInterest } from '../campaign/model';
import { DICE_HIGH, DICE_LOW, EXPERIENCE_ROLL, USUAL_EXPERIENCE, JOB_LEAN_LABEL, ratingOf, totalExperience } from '../campaign/jobs';

interface Props { offer: Offer; points: PointOfInterest[]; places: Record<string, string>; names: Record<string, string>; /** Reckoned with the game master's own figures for this warband's books. */ whatIf?: boolean }
const { offer: o, points, places, names, whatIf = false } = Astro.props;
const r = o.reckoning;
const pay = r.payout;
const pointName = (id: number | null) => (id == null ? null : points.find((p) => p.id === id)?.name ?? null);
const s = o.standing;
const logged = s.rating > 0;
const xpNow = totalExperience(s);
const key = diceKey(o.warbandId, o.scenario?.id);
const has = (list: readonly number[], d6: number) => list.includes(d6);
const experienceWord = (owed: boolean, d6: number) => (owed
  ? (has(EXPERIENCE_ROLL.double, d6) ? 'twice the floor' : has(EXPERIENCE_ROLL.more, d6) ? 'a point over the floor' : 'the floor')
  : (has(USUAL_EXPERIENCE.two, d6) ? 'two points' : has(USUAL_EXPERIENCE.one, d6) ? 'a point' : 'none'));
---

<article class="wh-post-offer" data-shut={o.shut ? 'true' : undefined}>
  <header class="wh-post-head">
    <h3 class="wh-h2">{o.name}</h3>
    <span class="wh-meta">
      {o.scenario ? <span class:list={['wh-chip', { on: !o.shut && !!pay }]}>{o.shut ? 'Shut' : pay ? 'Open' : 'Bare'}</span> : <span class="wh-chip">Dry run</span>}
      {o.locationId && <span class="wh-chip">{places[o.locationId] ?? o.locationId}</span>}
    </span>
  </header>

  <dl class="wh-dl">
    <dt>Games</dt><dd><b>{s.played}</b> played{s.jobs ? <>, <b>{s.jobs}</b> owed {s.jobs === 1 ? 'job' : 'jobs'} taken before</> : null}; the pace is <b>{r.pace}</b></dd>
    <dt>Owed</dt><dd><b>{r.owed}</b> {r.owed === 1 ? 'job' : 'jobs'} on top of the usual work{!r.ceiling ? '; nobody is ahead of them' : ''}</dd>
    <dt>Strength</dt><dd>rating <b>{ratingOf(s)}</b> {whatIf ? '(your figure)' : logged ? '(logged)' : '(reckoned from the roster)'} + <b>{s.gold}</b> gc unspent = <b>{r.power}</b>{r.ceiling ? <>; the ceiling is <b>{r.ceiling.power}</b></> : null}</dd>
    <dt>Experience</dt><dd><b>{xpNow}</b> together{r.ceiling ? <>; the ceiling is <b>{r.ceiling.experience}</b>, and no hero past <b>{r.ceiling.warrior.hero ?? 0}</b>, no henchman past <b>{r.ceiling.warrior.henchman ?? 0}</b></> : null}</dd>
    {r.ceiling && <><dt>Held under</dt><dd>{r.ceiling.ahead.map((id) => names[id] ?? id).join(', ')}</dd></>}
  </dl>

  {pay ? (
    <>
      <h4 class="wh-h3">{o.scenario ? `What the post would pay before ${o.scenario.title}` : 'What the post would pay now'}</h4>
      <ol class="wh-post-jobs">
        {pay.jobs.map((p, i) => (
          <li>
            <b>{p.job.title}</b>{pointName(p.job.pointId) && <span class="wh-post-at"> · {pointName(p.job.pointId)}</span>}{p.owed && <span class="wh-post-lean"> · {JOB_LEAN_LABEL[p.job.lean]}</span>}<span class:list={['wh-chip', { on: p.owed }]}>{p.owed ? 'Owed' : 'The usual work'}</span>
            <p>{p.job.text}</p>
            <div class="wh-post-dice">
              <label title="Which notice: D66 on the board's numbers">Notice D66 <input type="number" form="reckon" name={`pick.${key}.${i}`} min="11" max="66" step="1" inputmode="numeric" value={p.slot?.byHand ? p.slot.number ?? '' : ''} placeholder={p.slot?.number != null ? String(p.slot.number) : '—'} /></label>
              <label title="The gold: 2D6">Gold 2D6 <input type="number" form="reckon" name={`dice.${key}.${i}`} min={DICE_LOW} max={DICE_HIGH} step="1" inputmode="numeric" value={p.byHand ? p.dice : ''} placeholder={String(p.dice)} /></label>
              <label title={p.owed ? 'The experience: D6, never below the floor' : 'The experience: D6, a chance of a point or two'}>Experience D6 <input type="number" form="reckon" name={`exp.${key}.${i}`} min="1" max="6" step="1" inputmode="numeric" value={p.experienceByHand ? p.experienceDie : ''} placeholder={String(p.experienceDie)} /></label>
              <span class="wh-post-who">{[
                p.slot?.byHand ? 'notice rolled at the table' : 'notice drawn by the post',
                p.byHand ? 'gold rolled at the table' : `the post rolled ${p.dice} for the gold`,
                p.experienceByHand ? `experience rolled at the table (${experienceWord(p.owed, p.experienceDie)})` : `the post rolled ${p.experienceDie} for the experience (${experienceWord(p.owed, p.experienceDie)})`,
              ].join(' · ')}</span>
              {p.slot?.refused && <span class="wh-chip warn">{p.slot.refused} Roll again</span>}
            </div>
            <p class="wh-post-pay"><b>{p.gold}</b> gc{p.gold < p.rolled && <span class="dim"> (rolled {p.rolled})</span>}{p.grants.map((g) => <> · {g.name} +{g.experience}{g.advance && <span class="wh-chip on">Advance</span>}</>)}{p.cut && <span class="wh-chip warn">Cut to the ceiling</span>}</p>
          </li>
        ))}
      </ol>
      <div class="wh-actions wh-post-reckon"><button type="submit" form="reckon" class="cf-btn cf-btn-ghost sm">Reckon with these rolls</button></div>
      <p class="wh-post-sum">In all <b>{pay.gold}</b> gc and <b>{pay.experience}</b> experience; strength after <b>{pay.after.power}</b>{r.ceiling ? <> of <b>{r.ceiling.power}</b></> : null}.</p>
      {o.shut && <p class="wh-post-shut">{o.shut}</p>}
    </>
  ) : (
    <p class="wh-post-shut">The post is bare: no job there is open to them.{o.shut && o.scenario ? ` ${o.shut}` : ''}</p>
  )}
</article>
