---
/**
 * A warrior's portrait, framed by their keeper, wherever it is shown: always the same shape (`PORTRAIT_RATIO`), its
 * width set by the place that shows it (`--portrait-width` from a parent, or `width`). Nothing when they have none.
 * `framed` hangs it in a gilt frame with studded corners, for where it is shown large; a fallen warrior's frame is
 * iron, with a line of blood in the rebate. Small, it keeps a plain gilt edge.
 */
import type { Member } from '../campaign/model';
import { PORTRAIT_SIZE } from '../campaign/portrait';
import { base } from '../lib/site';

interface Props {
  member: Member;
  /** Said to a screen reader; empty where the name is beside it already. */
  alt?: string;
  width?: string;
  framed?: boolean;
  class?: string;
}
const { member, alt = '', width, framed = false, class: className } = Astro.props;
---

{member.picture && (
  <span class:list={['portrait', className, { framed, fallen: member.dead }]} style={width ? `--portrait-width: ${width}` : undefined}>
    <span class="portrait-pane">
      <img src={`${base}/images/${member.picture.image}`} width={PORTRAIT_SIZE.width} height={PORTRAIT_SIZE.height} alt={alt} loading="lazy" decoding="async" />
    </span>
    {framed && ['tl', 'tr', 'bl', 'br'].map((c) => <span class:list={['portrait-stud', c]} aria-hidden="true" />)}
  </span>
)}

<style>
  .portrait {
    position: relative;
    display: block;
    flex: none;
    width: var(--portrait-width, 6rem);
    border: 1px solid var(--gold-dim);
    background: #0d1210;
    box-shadow: 0 6px 14px -6px #000c;
  }
  .portrait-pane { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; background: #0d1210; }
  .portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .portrait.fallen { border-color: var(--blood); }
  .portrait.fallen img { filter: grayscale(.85) sepia(.25) brightness(.85); }

  /* the frame: a gilt moulding, a dark rebate and a fine gold fillet round the picture, a stud at each corner */
  .portrait.framed {
    --frame: var(--portrait-frame, 12px);
    border: 0;
    padding: var(--frame);
    background:
      linear-gradient(90deg, #0004, transparent 18%, transparent 82%, #0004),
      linear-gradient(145deg, #3a2c12, #c9a55a 16%, #6d5424 34%, #e3c77f 50%, #5e4720 68%, #b8963e 84%, #33270f);
    box-shadow: 0 16px 30px -12px #000, 0 0 0 1px #0009, inset 0 0 0 1px #f3dc9a50, inset 0 0 calc(var(--frame) * .6) #0007;
  }
  .portrait.framed::before {
    content: '';
    position: absolute;
    inset: calc(var(--frame) * .38);
    border: 1px solid #2a1f0b90;
    box-shadow: 0 0 0 1px #f3dc9a28;
    pointer-events: none;
  }
  .portrait.framed .portrait-pane { box-shadow: 0 0 0 1px #000, 0 0 0 2px #e6c77a70, 0 0 0 3px #1a1208; }
  .portrait.framed .portrait-pane::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 22px #000b; pointer-events: none; }
  .portrait-stud {
    position: absolute;
    width: calc(var(--frame) * 1.15);
    aspect-ratio: 1;
    background: radial-gradient(circle at 35% 30%, #fbecbb, #c9a55a 40%, #5a4520 85%);
    border: 1px solid #2a1f0b;
    box-shadow: 0 1px 2px #000a;
    transform: translate(-50%, -50%) rotate(45deg);
    pointer-events: none;
  }
  .portrait-stud.tl { left: calc(var(--frame) / 2); top: calc(var(--frame) / 2); }
  .portrait-stud.tr { left: calc(100% - var(--frame) / 2); top: calc(var(--frame) / 2); }
  .portrait-stud.bl { left: calc(var(--frame) / 2); top: calc(100% - var(--frame) / 2); }
  .portrait-stud.br { left: calc(100% - var(--frame) / 2); top: calc(100% - var(--frame) / 2); }
  .portrait.framed.fallen {
    background:
      linear-gradient(90deg, #0005, transparent 18%, transparent 82%, #0005),
      linear-gradient(145deg, #161917, #5f635e 18%, #262a28 36%, #858880 52%, #262927 70%, #545752 86%, #141615);
  }
  .portrait.framed.fallen .portrait-pane { box-shadow: 0 0 0 1px #000, 0 0 0 2px #8a2a2299, 0 0 0 3px #0c0d0c; }
  .portrait.framed.fallen .portrait-stud { background: radial-gradient(circle at 35% 30%, #d8dad2, #73766f 40%, #2a2d2b 85%); }
</style>
