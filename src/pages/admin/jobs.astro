---
import Base from '../../layouts/Base.astro';
import PostOffer from '../../components/PostOffer.astro';
import '../../styles/curfew.css';
import '../../styles/admin.css';
import { base } from '../../lib/site';
import { hasDatabase } from '../../server/db/client';
import { admission } from '../../server/admin/guard';
import { currentLocation, todayFor } from '../../server/curfew/service';
import { diceKey, listJobs, offer, postOverview, type Books, type Offer, type PostRecord } from '../../server/campaign/jobs';
import { numberBoard, type TableRolls } from '../../campaign/jobs';
import { listLocations } from '../../server/campaign/locations';
import { ERRAND_SHARE, GOLD_PER_RATING, JOB_GOLD, JOB_LEANS, JOB_LEAN_LABEL, JOB_SCOPES, JOB_SCOPE_LABEL, JOB_SCOPE_PLURAL, LEAN_SPLIT, MATCH_TARGET, RATING_PER_WARRIOR, SCOPE_FROM, dieFor, powerOf, ratingOf, totalExperience, type Job, type Standing } from '../../campaign/jobs';
import type { CampaignLocation } from '../../campaign/model';
import { formatImperial, imperialForDate } from '../../lib/calendar';

// The Fountain Post, the campaign's catch-up rule, as a draft for game masters alone and only as a dry run: where every
// warband stands, what the post would offer before each scheduled game, a dry run for any warband at
// any place, and the boards themselves. Nothing here writes to a warband: the rating and treasury typed into the table
// are figures to reckon with, carried in the address, and the boards are the only thing saved.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const ready = hasDatabase();
const { viewer, gm } = ready ? await admission(Astro.request) : { viewer: null, gm: false };
if (ready && !gm) Astro.response.status = viewer ? 403 : 401;
// the post reckons from the record, never the steered clock
const today = todayFor(null);

let record: PostRecord | null = null, logged: Standing[] = [], offers: Offer[] = [], dry: Offer | null = null, places: CampaignLocation[] = [], board: Job[] = [], here = '';
let trouble = false;
let against: string | null = null;
const q = Astro.url.searchParams;
// the game master's own figures for the books, `rating.<warband>` and `gold.<warband>`: reckoned with, never saved
const books: Books = {};
for (const [key, value] of q) {
  const m = /^(rating|gold)\.([\w-]{1,64})$/.exec(key);
  const n = Number(value);
  if (m && value !== '' && Number.isFinite(n)) (books[m[2]] ??= {})[m[1] as 'rating' | 'gold'] = n;
}
// the table's own rolls, `pick|dice|exp.<warband>:<game or dry>.<place>`, typed where they were rolled by hand: a D66 for
// which notice, 2D6 for the gold, a D6 for the experience. The rule ignores what no such roll shows, and says so.
const ROLL: Record<string, keyof TableRolls> = { pick: 'picks', dice: 'dice', exp: 'experience' };
const rolls: Record<string, TableRolls> = {};
for (const [key, value] of q) {
  const m = /^(pick|dice|exp)\.([\w-]{1,64}:[\w-]{1,160})\.(\d)$/.exec(key);
  if (m && value !== '') ((rolls[m[2]] ??= {})[ROLL[m[1]]] ??= [])[Number(m[3])] = Number(value);
}
if (gm && viewer) {
  try {
    here = (await currentLocation(today)).id;
    [places, board] = await Promise.all([listLocations(), listJobs()]);
    const o = await postOverview(viewer, here, books, rolls);
    record = o.record; logged = o.logged; offers = o.offers;
    // the dry run's match: as chosen, or the weakest warband against the strongest
    const byStrength = record.standings.slice().sort((a, b) => powerOf(a) - powerOf(b));
    const known = (id: string | null) => (id && record!.standings.some((x) => x.warbandId === id) ? id : null);
    const warbandId = known(q.get('warband')) ?? byStrength[0]?.warbandId;
    against = q.has('against') ? known(q.get('against')) : (byStrength.at(-1)?.warbandId !== warbandId ? byStrength.at(-1)?.warbandId ?? null : null);
    const place = places.find((l) => l.id === q.get('place'))?.id ?? here;
    if (warbandId) dry = await offer(viewer, { warbandId, locationId: place, against: against && against !== warbandId ? [against] : [], rolls: rolls[diceKey(warbandId)] }, record);
  } catch (e) { console.error('[fountain-post] unavailable', e); trouble = true; }
}

// a warband is reckoned "what if" only where a figure differs from what is logged
const whatIf = new Set((record?.standings ?? []).filter((s) => { const l = logged.find((x) => x.warbandId === s.warbandId); return !!l && (l.rating !== s.rating || l.gold !== s.gold); }).map((s) => s.warbandId));
const names = Object.fromEntries((record?.standings ?? []).map((s) => [s.warbandId, s.name]));
const placeNames = Object.fromEntries(places.map((l) => [l.id, l.name]));
const allPoints = places.flatMap((l) => l.points);
// each notice's D66 number on its own board
const numbers = new Map(places.flatMap((l) => [...numberBoard(board.filter((j) => j.locationId === l.id))]));
const upcoming = (record?.scenarios ?? []).filter((s) => s.status === 'upcoming');
const imperial = (iso: string) => { try { return formatImperial(imperialForDate(iso), 'short'); } catch { return iso; } };
const signInHref = `${base}/signin/?next=${encodeURIComponent(`${base}/admin/jobs/`)}`;
const dryPlace = places.find((l) => l.id === (q.get('place') ?? here)) ?? places.find((l) => l.id === here);
---

<Base title="The Fountain Post — The Watch House" description="The campaign's catch-up rule laid out for the game master: where every warband stands, what the post offers before each game, and a dry run.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Barlow+Condensed:wght@600&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#0e0d0c" />
    <meta name="robots" content="noindex" />
  </Fragment>

  <main class="curfew wh" id="main-content" data-base={base}>
    <header class="wh-top">
      <a class="cf-back" href={`${base}/admin/`}>← The Watch House</a>
      <a class="wh-wordmark" href={`${base}/admin/jobs/`}>The Fountain Post</a>
      <div class="wh-top-right">
        <span class="cf-nightline">A draft, for the Watch alone</span>
      </div>
    </header>

    {!ready && <div class="wh-gate"><h1>The ledgers are not open</h1><p>This deployment has no database yet. See the README for the Vercel setup.</p></div>}
    {ready && !viewer && <div class="wh-gate"><h1>Who goes there?</h1><p>The Fountain Post is for the game master. <a href={signInHref}>Sign in</a>, and you are brought back here.</p></div>}
    {ready && viewer && !gm && <div class="wh-gate"><h1>No admittance</h1><p>You are signed in as {viewer.name}, and that name is neither an admin's nor a game master's.</p></div>}
    {trouble && <div class="wh-gate"><h1>The city did not answer</h1><p>The post could not be read just now. Try again in a moment.</p></div>}

    {record && (
      <>
        <nav class="wh-nav" aria-label="Sections">
          <a href="#rule">The rule</a>
          <a href="#standing">Where they stand</a>
          <a href="#games">Before the games</a>
          <a href="#dry">Dry run</a>
          <a href="#boards">The boards</a>
          <a class="wh-nav-page" href={`${base}/admin/odds/`}>The Odds →</a>
        </nav>

        <section class="wh-section" id="rule" aria-labelledby="rule-title">
          <h1 class="wh-h1" id="rule-title">Notices on the fountain post</h1>
          <p class="wh-muted">Between games every warband takes one of the place's jobs, the notices nailed to the fountain's post in the square. Its purpose is the game ahead: to make the matchup as good a fight as it can be, however many games each warband has played. For most it is an errand and a few crowns. A warband weaker than the side it is about to meet takes a bigger job, and brings that pay to the table. For now this is a dry run for the Watch alone: nothing here pays a warband, and the players do not see it. One day they will run it themselves, before their games.</p>
          <ul class="wh-tarot-rules">
            <li>Every warband on a scheduled game takes <b>one job</b>, of the scope its match asks for: an <b>errand</b>, a <b>commission</b> or an <b>undertaking</b>. The bigger the job, the more there is to it, and the more it pays.</li>
            <li>The <b>match</b>: each warband is set against the strongest other warband on its game, the <b>stronger side</b>. Strength is the rating (logged, or reckoned at {RATING_PER_WARRIOR} a warrior plus their experience) with the unspent treasury at {GOLD_PER_RATING} gc a point. The <b>target</b> is {Math.round(MATCH_TARGET * 100)} parts in a hundred of the stronger side's strength.</li>
            <li>The <b>scope</b>: an undertaking for a warband {SCOPE_FROM.undertaking} points or more short of the target, a commission for one {SCOPE_FROM.commission} to {SCOPE_FROM.undertaking - 1} short, an errand otherwise, the stronger side's own included.</li>
            <li>An <b>errand</b> is the usual work: one part in {Math.round(1 / ERRAND_SHARE)} of a job's gold, at least 5 gc, and a chance of experience on its own D6: 1–3 none, 4–5 a point to the least experienced warrior it names, 6 a point each to the two least experienced (two to the one, if it names one). Even the strongest warband of the game takes it, for the telling.</li>
            <li>The post <b>opens</b> when a game is scheduled with the warband on its muster, and <b>shuts</b> at that game's first turn. The job comes from the board of the place the game is fought in, or where the campaign is when the game names none; when the board has no open notice of the scope, the nearest scope stands in.</li>
            <li>The <b>limits</b>: never level with the stronger side, nor past it. A commission or an undertaking stops at the target, an errand short of the stronger side's strength, and no warrior passes the stronger side's best of the same rank. Every grant is cut to fit. With every roll at its best the weaker side reaches the target; with ordinary rolls, a good way towards it.</li>
            <li>The <b>draw</b> is seeded by the warband and the game: the same game, the same job. Withheld jobs are never drawn, nor a job at a point of interest where a game is scheduled. Jobs the warband has not done lately come first.</li>
            <li>The <b>rolls</b>: which notice (a D6 for a scope of six notices or fewer, a D66 for more, on the board's numbers), the gold ({JOB_GOLD.dice}D6) and the experience (D6). The post rolls each, or the table rolls its own and types it in the job's box; an empty box is the post's roll. A notice the table may not have (withheld, where a game is set, or no notice at that number) is a roll again. Either way the limits hold.</li>
            <li>The <b>pay</b> of a commission or an undertaking: the gap, split by its lean between gold and experience ({JOB_LEANS.map((l) => `${JOB_LEAN_LABEL[l].toLowerCase()}: ${Math.round(LEAN_SPLIT[l] * 100)} in a hundred gold`).join('; ')}). The gold is paid at its {JOB_GOLD.dice}D6 out of 12, at {GOLD_PER_RATING} gc a point of strength; the experience at its D6 out of 6, never below the floor of a third (1–2 the floor); a six on the experience die, on any job, always pays at least a point, past the target if need be, though never level with the stronger side, shared out a point at a time among those the lean names, least experienced first: every warrior, every hero, the leader, or the least experienced hero. An advance reached is marked, to be rolled at the table.</li>
            <li>Every offer is reckoned from the record as it stands, against the warbands on the game's muster. The dials are code, in <code>src/campaign/jobs.ts</code>.</li>
          </ul>
        </section>

        <section class="wh-section" id="standing" aria-labelledby="standing-title">
          <h2 class="wh-h2" id="standing-title">Where they stand</h2>
          <p class="wh-muted">The books the match reads. Players do not log their rating and treasury on the site yet, so try figures of your own here and <b>Reckon</b>: every offer on the page is reckoned with them, and nothing is saved. A rating of <b>0</b> is reckoned from the roster. Experience is the warriors' own, from the muster roll.</p>
          {whatIf.size > 0 && <p class="wh-post-whatif">Reckoned with your figures for {[...whatIf].map((id) => names[id] ?? id).join(', ')}. <a href={`${base}/admin/jobs/`}>Back to the logged books</a>.</p>}
          <p class="wh-table-hint" aria-hidden="true">Scroll sideways for the rest of the table</p>
          <div class="wh-table-wrap" tabindex="0" role="region" aria-label="Where the warbands stand">
            <table class="wh-table">
              <thead><tr><th scope="col">Warband</th><th scope="col" class="num">Experience</th><th scope="col" class="num">Strength</th><th scope="col">Rating and treasury, to reckon with</th></tr></thead>
              <tbody>
                {record.standings.map((s) => (
                  <tr class="wh-row">
                    <th scope="row" class="wh-keeper">{s.name}</th>
                    <td class="num">{totalExperience(s)}</td>
                    <td class="num">{powerOf(s)}</td>
                    <td>
                      <div class="wh-form-inline wh-post-books">
                        <label>Rating<input type="number" form="reckon" name={`rating.${s.warbandId}`} min="0" max="10000" value={s.rating} /></label>
                        <label>Gold<input type="number" form="reckon" name={`gold.${s.warbandId}`} min="0" max="100000" value={s.gold} /></label>
                        {s.rating === 0 && <small class="dim">reckoned {ratingOf(s)}</small>}
                        {whatIf.has(s.warbandId) && <span class="wh-chip on">What if</span>}
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="wh-actions wh-post-reckon"><button type="submit" form="reckon" class="cf-btn sm">Reckon</button></div>
        </section>

        <section class="wh-section" id="games" aria-labelledby="games-title">
          <h2 class="wh-h2" id="games-title">Before the games</h2>
          <p class="wh-muted">Every scheduled game and what the post would offer each warband on its muster: an errand for the stronger side and anyone close to it, a commission or an undertaking for those further short. Reckoned afresh at every look, with the game's own seed, so these are the jobs the game would draw; nothing is taken.</p>
          {upcoming.length ? upcoming.map((s) => (
            <div class="wh-post-game">
              <h3 class="wh-h3"><a href={`${base}/scenarios/${s.id}/`}>{s.title}</a> · {imperial(s.playedOn)} · {s.locationId ? placeNames[s.locationId] ?? s.locationId : `${placeNames[here] ?? here}, where the campaign is`}{s.turn > 0 && ` · turn ${s.turn}`}</h3>
              {s.warbands.length ? (
                <div class="wh-post-offers">
                  {offers.filter((o) => o.scenario?.id === s.id).map((o) => <PostOffer offer={o} points={allPoints} places={placeNames} names={names} whatIf={whatIf.has(o.warbandId)} />)}
                </div>
              ) : <p class="wh-empty">Nobody is on the muster yet.</p>}
            </div>
          )) : <p class="wh-empty">No game is scheduled. The post opens when one is; the dry run below reckons without one.</p>}
        </section>

        <section class="wh-section" id="dry" aria-labelledby="dry-title">
          <h2 class="wh-h2" id="dry-title">Dry run</h2>
          <p class="wh-muted">What the post would pay a warband now, against another, at any place, as if a game were scheduled there today. Nothing is written. The draw is seeded by the place instead of a game, so a real game's jobs may differ; their pay is reckoned the same way.</p>
          <form class="wh-form-inline" id="reckon" method="get" action={`${base}/admin/jobs/#dry`}>
            <label>Warband <select name="warband">{record.standings.map((s) => <option value={s.warbandId} selected={s.warbandId === dry?.warbandId}>{s.name} ({powerOf(s)})</option>)}</select></label>
            <label>Against <select name="against"><option value="">Nobody</option>{record.standings.map((s) => <option value={s.warbandId} selected={s.warbandId === against}>{s.name} ({powerOf(s)})</option>)}</select></label>
            <label>Place <select name="place">{places.map((l) => <option value={l.id} selected={l.id === dryPlace?.id}>{l.name}{l.id === here ? ' (where the campaign is)' : ''}</option>)}</select></label>
            <button type="submit" class="cf-btn cf-btn-ghost sm">Reckon</button>
          </form>
          {dry ? <PostOffer offer={dry} points={allPoints} places={placeNames} names={names} whatIf={whatIf.has(dry.warbandId)} /> : <p class="wh-empty">No warband to reckon.</p>}
        </section>

        <section class="wh-section" id="boards" aria-labelledby="boards-title">
          <h2 class="wh-h2" id="boards-title">The boards</h2>
          <p class="wh-muted">Each place's jobs. A job may touch the place's story as far as the Curfew's pack does: it may see what the pack's rumours and details already say, and never contradicts them, resolves a thread or adds a fact to one. <b>Withhold</b> a job when the story moves past it. The boards are the one thing this page saves: they are what the dry runs draw from.</p>
          {places.map((l) => (
            <div class="wh-post-board">
              <h3 class="wh-h3">{l.name}</h3>
              {JOB_SCOPES.map((scope) => { const mine = board.filter((j) => j.locationId === l.id && j.scope === scope); const die = dieFor(board.filter((j) => j.locationId === l.id), scope); return (<>
              <h4 class="wh-post-scope">{JOB_SCOPE_PLURAL[scope]} <small>{mine.length} {mine.length === 1 ? 'notice' : 'notices'}, rolled for on a {die}</small></h4>
              <ul class="wh-dispatches">
                {mine.length === 0 && <li class="wh-empty">None nailed up. A warband this scope is for takes the nearest scope instead.</li>}
                {mine.map((j) => (
                  <li class="wh-dispatch wh-article">
                    <span class="wh-meta">{numbers.get(j.id) != null && <span class="wh-post-number" title={`Its number on the ${die}`}>{numbers.get(j.id)}</span>}<span>{JOB_LEAN_LABEL[j.lean]}</span>{j.pointId != null && <span class="wh-chip">{l.points.find((p) => p.id === j.pointId)?.name ?? 'a point'}</span>}{j.withheld && <span class="wh-chip warn">Withheld</span>}</span>
                    <details class="wh-text wh-article-edit">
                      <summary><p>{j.title}</p><small>{j.text}</small></summary>
                      <form class="wh-article-form" data-api="admin/job-update" data-json={JSON.stringify({ jobId: j.id })}>
                        <label class="wh-field">Name<input name="patch.title" required maxlength="80" value={j.title} /></label>
                        <label class="wh-field">What came of it<textarea name="patch.text" maxlength="1000">{j.text}</textarea></label>
                        <div class="wh-field-row">
                          <label class="wh-field">Scope<select name="patch.scope">{JOB_SCOPES.map((x) => <option value={x} selected={x === j.scope}>{JOB_SCOPE_LABEL[x]}</option>)}</select></label>
                          <label class="wh-field">Pays<select name="patch.lean">{JOB_LEANS.map((x) => <option value={x} selected={x === j.lean}>{JOB_LEAN_LABEL[x]}</option>)}</select></label>
                          <label class="wh-field">Where<select name="patch.pointId" data-nullable><option value="">Nowhere on the map</option>{l.points.map((p) => <option value={p.id} selected={p.id === j.pointId}>{p.name}</option>)}</select></label>
                          <label class="wh-check"><input type="checkbox" name="patch.withheld" checked={j.withheld} /> Withheld</label>
                        </div>
                        <div class="wh-actions"><button type="button" class="cf-btn cf-btn-blood sm" data-act="admin/job-remove" data-body={JSON.stringify({ jobId: j.id })} data-confirm="Tear this notice down? One of your own goes for good; one of the seed’s is withheld instead, so the seed does not nail it up again. Those who took it keep it in their record.">Tear down</button><button type="submit" class="cf-btn sm">Rewrite</button></div>
                      </form>
                    </details>
                  </li>
                ))}
              </ul>
              </>); })}
              <details class="wh-post-add">
                <summary class="cf-btn cf-btn-ghost sm">Nail up a new job in {l.name}</summary>
                <form class="wh-notice wh-article-form" data-api="admin/job-add" data-json={JSON.stringify({ locationId: l.id })}>
                  <label class="wh-field">Name<input name="job.title" required maxlength="80" placeholder="Clearing the eel-weirs" /></label>
                  <label class="wh-field">What came of it<textarea name="job.text" maxlength="1000" placeholder="Past tense: what they did, and what was noticed. An errand a sentence or two; an undertaking four or five, with more to it."></textarea></label>
                  <div class="wh-field-row">
                    <label class="wh-field">Scope<select name="job.scope">{JOB_SCOPES.map((x) => <option value={x} selected={x === 'errand'}>{JOB_SCOPE_LABEL[x]}</option>)}</select></label>
                    <label class="wh-field">Pays<select name="job.lean">{JOB_LEANS.map((x) => <option value={x} selected={x === 'even'}>{JOB_LEAN_LABEL[x]}</option>)}</select></label>
                    <label class="wh-field">Where<select name="job.pointId" data-nullable><option value="">Nowhere on the map</option>{l.points.map((p) => <option value={p.id}>{p.name}</option>)}</select></label>
                  </div>
                  <div class="wh-notice-foot"><span></span><button type="submit" class="cf-btn">Nail it up</button></div>
                </form>
              </details>
            </div>
          ))}
        </section>
      </>
    )}
  </main>
</Base>

<script>
  import { wireManage } from '../../lib/manage';

  document.body.classList.add('curfew-body');
  const root = document.getElementById('main-content')!;
  // buttons with data-act and forms with data-api post and reload; refusals are shown as written
  wireManage(root, root.dataset.base ?? '');
</script>
