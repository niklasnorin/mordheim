---
import Base from '../../layouts/Base.astro';
import '../../styles/curfew.css';
import '../../styles/admin.css';
import { base } from '../../lib/site';
import { hasDatabase } from '../../server/db/client';
import { admission } from '../../server/admin/guard';
import { overview, type Overview } from '../../server/admin/service';
import { todayFor } from '../../server/curfew/service';
import { listArticles } from '../../server/campaign/news';
import type { NewsArticle } from '../../campaign/model';
import { CAMPAIGN, ERRAND_LABEL, HAND_SIZE, TOKEN_TYPES, dateForNight, moonForNight, tokenById } from '../../curfew/engine';
import { sealSvg } from '../../curfew/glyphs';
import { formatImperial, imperialForDate } from '../../lib/calendar';

// The game master's console. Personal, current, never cached.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const ready = hasDatabase();
// The console reads and acts on every ledger, so its clock is never steered: a debug date here would write other players' nights.
const today = todayFor(null);
const { viewer, gm, admin } = ready ? await admission(Astro.request) : { viewer: null, gm: false, admin: false };
let data: Overview | null = null;
let articles: NewsArticle[] = [];
let trouble = false;
if (gm) {
  try { [data, articles] = await Promise.all([overview(today), listArticles()]); } catch (e) { console.error('[watch-house] overview unavailable', e); trouble = true; }
}
if (ready && !gm) Astro.response.status = viewer ? 403 : 401;
const ROLE: Record<string, string> = { admin: 'Admin', gm: 'Game Master', player: 'Player' };

const ledgerHref = `${base}/curfew/`;
const tz = CAMPAIGN.timezone;
const when = (d: Date) => new Intl.DateTimeFormat('en-GB', { timeZone: tz, day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(d);
const day = (d: Date) => new Intl.DateTimeFormat('en-GB', { timeZone: tz, day: 'numeric', month: 'short', year: 'numeric' }).format(d);
const nightDate = (n: number) => new Intl.DateTimeFormat('en-GB', { timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long' }).format(new Date(dateForNight(n) + 'T12:00:00Z'));
const imperialDate = (n: number) => formatImperial(imperialForDate(dateForNight(n)));
const plural = (n: number, one: string, many = one + 's') => `${n} ${n === 1 ? one : many}`;
const TONIGHT: Record<string, string> = { given: 'Orders given', barred: 'Door barred', standing: 'Standing orders', nothing: '—' };
const KIND: Record<string, string> = { headline: 'Heard', happening: 'Happening', notice: 'Notice' };
const lastRun = data?.runs[0];
---

<Base title="The Watch House — Mordheim" description="The game master's console for the Mordheim campaign: ledgers, players, the Town Cryer and midnight.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Barlow+Condensed:wght@600&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#0e0d0c" />
    <meta name="robots" content="noindex" />
  </Fragment>

  <main class="curfew wh" id="main-content" data-base={base}>
    <header class="wh-top">
      <a class="cf-back" href={`${base}/`}>← Mordheim</a>
      <a class="wh-wordmark" href={`${base}/admin/`}>The Watch House</a>
      <div class="wh-top-right">
        <span class="cf-nightline">{today < 1 ? <>The city sleeps until <strong>{nightDate(1)}</strong></> : <>Night <strong>{today}</strong> · {moonForNight(today).name}{data ? <> · {data.location.name}</> : null}</>}</span>
        {viewer && <span class="wh-who">{viewer.name}<button type="button" class="cf-linkbtn" id="signout">Sign out</button></span>}
      </div>
    </header>

    {!ready && <div class="wh-gate"><h1>The ledgers are not open</h1><p>This deployment has no database yet. See the README for the Vercel setup.</p></div>}
    {ready && !viewer && <div class="wh-gate"><h1>Who goes there?</h1><p>The Watch House is for the game master. <a href={ledgerHref}>Sign in at the Ledger</a>, then come back.</p></div>}
    {ready && viewer && !gm && <div class="wh-gate"><h1>No admittance</h1><p>You are signed in as {viewer.name}, and that name is neither a game master's nor an admin's.</p><p>An admin grants the game master's role here; admins are named in <code>ADMIN_EMAILS</code>. <a href={ledgerHref}>Back to the Ledger</a>.</p></div>}
    {trouble && <div class="wh-gate"><h1>The city did not answer</h1><p>The overview could not be read just now. Try again in a moment.</p></div>}

    {data && (
      <>
        <nav class="wh-nav" aria-label="Console sections">
          <a href="#night">Tonight</a>
          <a href="#ledgers">Ledgers</a>
          <a href="#cryer">Town Cryer</a>
          <a href="#articles">Articles</a>
          {admin && <a href="#players">Players</a>}
          {admin && <a href="#midnight">Midnight</a>}
          <a class="wh-nav-page" href={`${base}/scenarios/`}>Scenarios →</a>
          <a class="wh-nav-page" href={`${base}/admin/content/`}>Content →</a>
          <a class="wh-nav-page" href={`${base}/admin/odds/`}>The Odds →</a>
        </nav>

        <section class="wh-section" id="night" aria-labelledby="tonight-title">
          <h1 class="wh-h1" id="tonight-title">{today < 1 ? 'Before the first night' : `Night ${today}`}</h1>
          <div class="wh-tonight">
            <figure class="wh-omen">
              <img src={`${base}${data.omen.image}`} alt="" width="1050" height="1800" />
              <figcaption>
                <b>{data.omen.title}</b>
                {data.omen.reading}
                <small>{data.moon.name} favours {ERRAND_LABEL[data.moon.boost]}</small>
              </figcaption>
            </figure>
            <div class="wh-city">
              <p class="wh-lede">{today < 1 ? `The first night is ${nightDate(1)}, ${imperialDate(1)}.` : `${nightDate(today)}, which the Empire writes as ${imperialDate(today)}. Dawn is written at midnight, ${tz.replace('_', ' ')}.`}</p>
              <ul class="wh-facts">
                <li><b>{data.counts.ledgers}</b> of <b>{data.counts.warbands}</b> warbands have a keeper{data.ledgers.some((l) => l.behind > 0) ? <>; <b>{data.ledgers.filter((l) => l.behind > 0).length}</b> {data.ledgers.filter((l) => l.behind > 0).length === 1 ? 'is' : 'are'} behind on their dawns.</> : '.'}</li>
                <li><b>{data.counts.players}</b> {data.counts.players === 1 ? 'player has' : 'players have'} signed in; <b>{data.counts.sessions}</b> {data.counts.sessions === 1 ? 'session is' : 'sessions are'} open now.</li>
                <li><b>{data.counts.dispatches}</b> {data.counts.dispatches === 1 ? 'dispatch has' : 'dispatches have'} gone to the Town Cryer.</li>
                <li class:list={{ bad: !lastRun }}>{lastRun ? <>Midnight last ran <b>{when(lastRun.ranAt)}</b> by {lastRun.source === 'cron' ? 'the cron' : 'hand'}, writing <b>{lastRun.nights}</b> {lastRun.nights === 1 ? 'night' : 'nights'}.</> : <>Midnight has <b>never</b> run.</>}</li>
              </ul>
              <div class="wh-place" id="place">
                <h3 class="wh-h3">Where the campaign is</h3>
                <p>The warbands are in <b>{data.location.name}</b>{data.moves[0] ? <>, since night {data.moves[0].fromNight}</> : null}. {data.location.kind === 'village' ? `A ${data.location.kind}: the Curfew offers ${data.location.errands.map((e) => ERRAND_LABEL[e]).join(', ')}, and the Cryer prints from the docks.` : `The city: every errand is open, and the Cryer prints from the ruins.`}</p>
                <div class="wh-actions">
                  {data.locations.filter((l) => l.id !== data!.location.id).map((l) => (
                    <button type="button" class="cf-btn cf-btn-ghost sm" data-act="admin/move-campaign" data-body={JSON.stringify({ locationId: l.id })} data-confirm={`Move the campaign to ${l.name} from tonight, night ${Math.max(1, today)}? Nights already written stay where they were. From tonight the Curfew offers ${l.name}'s errands (${l.errands.map((e) => ERRAND_LABEL[e]).join(', ')}) and the Town Cryer prints from there.`}>Move to {l.name}</button>
                  ))}
                </div>
                {data.moves.length > 0 && <p class="wh-moves">{data.moves.slice(0, 4).map((m, i) => <span>{i > 0 ? ' · ' : ''}{data!.locations.find((l) => l.id === m.locationId)?.name ?? m.locationId} from night {m.fromNight}</span>)}{data.moves.length > 4 ? ' · …' : ''}</p>}
              </div>
            </div>
            {admin && <ul class="wh-health" aria-label="Health">
              {data.health.map((h) => <li class:list={[h.ok === true ? 'ok' : h.ok === false ? 'bad' : 'note']}><span class="wh-dot" aria-hidden="true"></span><b>{h.label}</b><span>{h.detail}</span></li>)}
            </ul>}
          </div>
        </section>

        <section class="wh-section" id="ledgers" aria-labelledby="ledgers-title">
          <h2 class="wh-h2" id="ledgers-title">Ledgers</h2>
          <p class="wh-muted">One keeper per warband; the ledger follows the warband's owner. {admin ? <><b>Burn</b> starts a ledger afresh tonight and the keeper keeps the warband. <b>Release</b> takes the warband from its keeper, ledger and all, so anyone may take it up.</> : <>Warbands are handed out and tended from <a href={`${base}/warbands/`}>their own pages</a>.</>}</p>
          <p class="wh-table-hint" aria-hidden="true">Scroll sideways for the rest of the table</p>
          <div class="wh-table-wrap" tabindex="0" role="region" aria-label="Ledgers">
            <table class="wh-table">
              <thead><tr><th scope="col">Warband</th><th scope="col">Keeper</th><th scope="col">Favour</th><th scope="col" class="num">Shards</th><th scope="col" class="num">Renown</th><th scope="col">Hand</th><th scope="col">Last dawn</th><th scope="col">Tonight</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
              <tbody>
                {data.ledgers.map((l) => {
                  const s = l.state;
                  const last = s?.nights.at(-1);
                  return (
                    <>
                      <tr class="wh-row">
                        <th scope="row"><span class="wh-cell-name"><span class:list={['wh-sigil', { 'is-empty': !s }]} aria-hidden="true">{l.sigil}</span><span>{l.name}<small>{l.type} · {l.title}</small></span></span></th>
                        {s && l.keeper ? (
                          <>
                            <td class="wh-keeper">{l.keeper.name}<small>{l.keeper.email}</small></td>
                            <td><span class="wh-favour"><span class="wh-num">{s.favour}</span><span class="wh-bar" role="img" aria-label={`Favour ${s.favour} of 100`}><i style={`width:${s.favour}%`}></i><b style={`left:${CAMPAIGN.favourSoftCap}%`}></b></span></span></td>
                            <td class="num">{s.shards}</td>
                            <td class="num">{s.renown}</td>
                            <td><span class="wh-hand" aria-label={s.hand.length ? s.hand.map((h) => tokenById(h.id).name).join(', ') : 'an empty Hand'}>{s.hand.map((h) => { const t = tokenById(h.id); return <span class="wh-seal" style={`--seal:${TOKEN_TYPES[t.type].seal}`} title={t.name} set:html={sealSvg(t.type)} />; })}{Array.from({ length: HAND_SIZE - s.hand.length }).map(() => <span class="wh-seal is-empty" aria-hidden="true"></span>)}</span></td>
                            <td class:list={{ bad: l.behind > 0, dim: !last }}>{l.behind > 0 ? `${plural(l.behind, 'night')} behind` : last ? `Night ${last.night}` : 'None yet'}</td>
                            <td class:list={{ dim: l.tonight === 'standing' || l.tonight === 'nothing' }}>{TONIGHT[l.tonight]}{s.eve ? <> <span class="wh-chip on">Eve laid</span></> : null}{s.offers.length ? <> <span class="wh-chip">{plural(s.offers.length, 'offer')} pending</span></> : null}{l.waiting ? <> <span class="wh-chip on">Crossroads waiting</span></> : null}</td>
                            <td><div class="wh-actions">
                              <button type="button" class="cf-btn cf-btn-ghost sm" data-inspect={l.warbandId} aria-expanded="false" aria-controls={`detail-${l.warbandId}`}>Inspect</button>
                              <a class="cf-btn cf-btn-ghost sm" href={`${base}/warbands/${l.warbandId}/`}>Roster</a>
                              {admin && <button type="button" class="cf-btn cf-btn-ghost sm" data-act="admin/burn" data-body={JSON.stringify({ warbandId: l.warbandId })} data-confirm={`Burn ${l.name}'s ledger? Every night, charm and rumour goes with it. ${l.keeper.name} keeps the warband.`}>Burn</button>}
                              {admin && <button type="button" class="cf-btn cf-btn-blood sm" data-act="admin/release" data-body={JSON.stringify({ warbandId: l.warbandId })} data-confirm={`Take ${l.name} from ${l.keeper.name}? The ledger is destroyed and anyone may take the warband up.`}>Release</button>}
                            </div></td>
                          </>
                        ) : (
                          <td class="dim" colspan="8">No ledger yet. The warband waits at the Ledger for its keeper to take it up. <a href={`${base}/warbands/${l.warbandId}/`}>Its page</a>.</td>
                        )}
                      </tr>
                      {s && (
                        <tr class="wh-detail" id={`detail-${l.warbandId}`} hidden>
                          <td colspan="9">
                            <div class="wh-detail-grid">
                              <div class="wh-night">
                                <h4>Last night</h4>
                                {last ? (
                                  <>
                                    <p><b>{last.header}</b></p>
                                    {last.results.map((r) => <p>{r.prose}</p>)}
                                    <p>{last.detail}</p>
                                    {last.closer && <p>{last.closer}</p>}
                                    {last.ledger.length > 0 && <div class="cf-ledger">Ledger: {last.ledger.map((x, i) => <><strong>{x}</strong>{i < last.ledger.length - 1 ? <span class="cf-sep"> · </span> : null}</>)}</div>}
                                  </>
                                ) : <p class="dim">No dawn has been written for this ledger yet.</p>}
                              </div>
                              <div>
                                <h4>The ledger</h4>
                                <dl>
                                  <dt>Opened</dt><dd>Night {s.firstSeen}</dd>
                                  <dt>Nights</dt><dd>{s.nights.length} written, {Object.keys(s.orders).length} with orders given</dd>
                                  <dt>Tonight</dt><dd>{s.orders[today]?.length ? s.orders[today].map((o) => `${o.memberId} · ${ERRAND_LABEL[o.errand]}`).join(', ') : TONIGHT[l.tonight]}</dd>
                                  <dt>Hand</dt><dd>{s.hand.length ? s.hand.map((h) => tokenById(h.id).name).join(', ') : 'empty'}</dd>
                                  <dt>Offers</dt><dd>{s.offers.length ? s.offers.map((o) => `${tokenById(o.incoming).name} against ${tokenById(o.held).name}`).join('; ') : 'none pending'}</dd>
                                  <dt>Rumours</dt><dd>{plural(s.rumours.length, 'rumour')} warm</dd>
                                  <dt>Epithets</dt><dd>{Object.keys(s.epithets).length ? Object.entries(s.epithets).map(([m, e]) => `${m} ${e}`).join(', ') : 'none yet'}</dd>
                                  <dt>Healed</dt><dd>{s.healed.length ? s.healed.join(', ') : 'nobody marked'}</dd>
                                  <dt>Crossroads</dt><dd>{s.nights.some((n) => n.crossroads) ? s.nights.filter((n) => n.crossroads).map((n) => `night ${n.night}, ${n.crossroads!.memberId}: ${n.crossroads!.decided ? `${n.crossroads!.decided.label}${n.crossroads!.decided.defaulted ? ' (decided alone)' : ''}` : 'waiting'}`).join('; ') : 'none met'}</dd>
                                  <dt>Marks</dt><dd>{Object.keys(s.marks ?? {}).length ? Object.entries(s.marks).map(([m, list]) => `${m}: ${list.map((k) => k.name).join(', ')}`).join('; ') : 'none'}</dd>
                                  <dt>Afflictions</dt><dd>{s.afflictions?.length ? s.afflictions.map((a) => `${a.memberId}: ${a.curseId} until night ${a.fromNight + a.nights - 1}`).join('; ') : 'none standing'}</dd>
                                  <dt>The Eve</dt><dd>{s.eve ? `laid on night ${s.eve.night}, ${plural(s.eve.tokens.length, 'charm')}, ticket ${s.eve.ticket}` : `not laid; ${plural(s.fights.length, 'fight')} recorded`}</dd>
                                  <dt>Saved</dt><dd>{l.updatedAt ? when(l.updatedAt) : '—'}</dd>
                                </dl>
                              </div>
                              <details><summary>Raw ledger</summary><pre>{JSON.stringify(s, null, 2)}</pre></details>
                            </div>
                          </td>
                        </tr>
                      )}
                    </>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        <section class="wh-section" id="cryer" aria-labelledby="cryer-title">
          <h2 class="wh-h2" id="cryer-title">Town Cryer</h2>
          <p class="wh-muted">What the broadsheet will print. A pulled dispatch is gone for good; a notice from the Watch prints tonight under its own heading.</p>
          <div class="wh-cryer">
            <form class="wh-notice" id="notice-form" data-api="admin/post-notice">
              <label class="wh-h3" for="notice-text">Post a notice</label>
              <textarea id="notice-text" name="text" maxlength="200" required placeholder="Curfew falls an hour earlier tonight. The Watch will not say why."></textarea>
              <div class="wh-notice-foot"><span class="wh-count" id="notice-count">0 / 200</span><button type="submit" class="cf-btn">Print in the Cryer</button></div>
            </form>
            <div>
              <h3 class="wh-h3">Recent dispatches</h3>
              {data.dispatches.length ? (
                <ul class="wh-dispatches">
                  {data.dispatches.map((d) => (
                    <li class="wh-dispatch">
                      <span class="wh-meta"><span>Night <b>{d.night}</b></span><span>{d.warbandName}</span></span>
                      <span class="wh-text"><p>{d.headline}<span class:list={['wh-chip', { on: d.kind === 'notice' }]}>{KIND[d.kind]}</span></p>{d.body && <small>{d.body}</small>}</span>
                      <button type="button" class="cf-btn cf-btn-ghost sm" data-act="admin/delete-dispatch" data-body={JSON.stringify({ id: d.id })} data-confirm="Pull this dispatch from the broadsheet? It does not come back.">Pull</button>
                    </li>
                  ))}
                </ul>
              ) : <p class="wh-empty">Nothing has reached the Cryer yet. The first dawn will change that.</p>}
            </div>
          </div>
        </section>

        <section class="wh-section" id="articles" aria-labelledby="articles-title">
          <h2 class="wh-h2" id="articles-title">Articles</h2>
          <p class="wh-muted">The broadsheet's own articles and notices, printed for the place they carry. Deadpan, exact, one paragraph; the voice is in <code>docs/agents/writing.md</code>. An unpublished article is kept but not printed.</p>
          <div class="wh-articles">
            <form class="wh-notice wh-article-form" data-api="admin/article-create">
              <span class="wh-h3">Set a new article in type</span>
              <label class="wh-field">Headline<input name="headline" required maxlength="200" placeholder="Bell Heard Beneath the Ash; Nobody Claims It" /></label>
              <label class="wh-field">Byline<input name="byline" maxlength="200" placeholder="By our correspondent at the ferry stair, who was counting too" /></label>
              <label class="wh-field">Body<textarea name="body" required maxlength="4000" placeholder="One paragraph, eighty to a hundred and fifty words."></textarea></label>
              <div class="wh-field-row">
                <label class="wh-field">Place<select name="locationId">{data.locations.map((l) => <option value={l.id} selected={l.id === data!.location.id}>{l.name}</option>)}</select></label>
                <label class="wh-check"><input type="checkbox" name="notice" /> A notice (capitals, no byline)</label>
                <label class="wh-check"><input type="checkbox" name="published" checked /> Published</label>
              </div>
              <div class="wh-notice-foot"><span></span><button type="submit" class="cf-btn">Set in type</button></div>
            </form>
            <div>
              <h3 class="wh-h3">In the Cryer</h3>
              {articles.length ? (
                <ul class="wh-dispatches">
                  {articles.map((a) => (
                    <li class="wh-dispatch wh-article">
                      <span class="wh-meta"><span>{data!.locations.find((l) => l.id === a.locationId)?.name ?? a.locationId}</span>{a.notice && <span class="wh-chip on">Notice</span>}{!a.published && <span class="wh-chip warn">Unpublished</span>}</span>
                      <details class="wh-text wh-article-edit">
                        <summary><p>{a.headline}</p>{a.byline && <small>{a.byline}</small>}</summary>
                        <form class="wh-article-form" data-api="admin/article-update" data-json={JSON.stringify({ id: a.id })}>
                          <label class="wh-field">Headline<input name="patch.headline" required maxlength="200" value={a.headline} /></label>
                          <label class="wh-field">Byline<input name="patch.byline" maxlength="200" value={a.byline} /></label>
                          <label class="wh-field">Body<textarea name="patch.body" required maxlength="4000">{a.body}</textarea></label>
                          <div class="wh-field-row">
                            <label class="wh-field">Place<select name="patch.locationId">{data!.locations.map((l) => <option value={l.id} selected={l.id === a.locationId}>{l.name}</option>)}</select></label>
                            <label class="wh-field">Order<input name="patch.sort" type="number" min="0" max="9999" value={a.sort} /></label>
                            <label class="wh-check"><input type="checkbox" name="patch.notice" checked={a.notice} /> Notice</label>
                            <label class="wh-check"><input type="checkbox" name="patch.published" checked={a.published} /> Published</label>
                          </div>
                          <div class="wh-actions"><button type="button" class="cf-btn cf-btn-blood sm" data-act="admin/article-delete" data-body={JSON.stringify({ id: a.id })} data-confirm="Pull this article from the Cryer for good?">Pull</button><button type="submit" class="cf-btn sm">Correct it</button></div>
                        </form>
                      </details>
                    </li>
                  ))}
                </ul>
              ) : <p class="wh-empty">The Cryer has no articles of its own yet.</p>}
            </div>
          </div>
        </section>

        {admin && <section class="wh-section" id="players" aria-labelledby="players-title">
          <h2 class="wh-h2" id="players-title">Players</h2>
          <p class="wh-muted">Everyone who has signed in. A player who forgets their password asks you for a <b>reset word</b>: issue it here, pass it on, and they trade it for a new password under "Forgotten your password?" at the Ledger. It is good for two days and spent on use. Signing a player out everywhere ends their sessions; they sign in again as before.</p>
          <p class="wh-table-hint" aria-hidden="true">Scroll sideways for the rest of the table</p>
          <div class="wh-table-wrap" tabindex="0" role="region" aria-label="Players">
            <table class="wh-table">
              <thead><tr><th scope="col">Player</th><th scope="col">Role</th><th scope="col">Warband</th><th scope="col" class="num">Sessions</th><th scope="col">Last seen</th><th scope="col">Joined</th><th scope="col">Reset word</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
              <tbody>
                {data.players.map((p) => (
                  <tr class="wh-row">
                    <th scope="row" class="wh-keeper">{p.name}<small>{p.email}</small></th>
                    <td><span class:list={['wh-chip', { on: p.role !== 'player' }]}>{ROLE[p.role]}</span></td>
                    <td class:list={{ dim: !p.warband }}>{p.warband ? <a href={`${base}/warbands/${p.warband.id}/`}>{p.warband.name}</a> : 'none'}</td>
                    <td class="num">{p.sessions}</td>
                    <td class:list={{ dim: !p.lastSeen }}>{p.lastSeen ? when(p.lastSeen) : 'never'}</td>
                    <td class="dim">{day(p.createdAt)}</td>
                    <td class:list={{ dim: !p.resetUntil }} data-reset-cell={p.id}>{p.resetUntil ? `Issued, unspent, good until ${when(p.resetUntil)}` : '—'}</td>
                    <td><div class="wh-actions">
                      <button type="button" class="cf-btn cf-btn-ghost sm" data-issue={p.id} data-name={p.name} data-confirm={`Issue ${p.name} a reset word? Any earlier word stops working. You will see it once, to pass on.`}>Issue reset word</button>
                      <button type="button" class="cf-btn cf-btn-ghost sm" data-act="admin/revoke-sessions" data-body={JSON.stringify({ userId: p.id })} data-confirm={`Sign ${p.name} out everywhere?`} disabled={p.sessions === 0}>Sign out everywhere</button>
                      {p.role === 'player' && <button type="button" class="cf-btn cf-btn-ghost sm" data-act="admin/set-role" data-body={JSON.stringify({ userId: p.id, role: 'gm' })} data-confirm={`Make ${p.name} a game master? They may set up scenarios, tend every warband, edit the Curfew's content and write for the Cryer.`}>Make game master</button>}
                      {p.role === 'gm' && <button type="button" class="cf-btn cf-btn-ghost sm" data-act="admin/set-role" data-body={JSON.stringify({ userId: p.id, role: 'player' })} data-confirm={`Take the game master's role from ${p.name}?`}>Make player</button>}
                    </div></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>}

        {admin && <section class="wh-section" id="midnight" aria-labelledby="midnight-title">
          <h2 class="wh-h2" id="midnight-title">Midnight</h2>
          <p class="wh-muted">The cron writes every ledger's dawn once a night; a visit to a ledger writes what is still due. Running it by hand is harmless: a current ledger has nothing to write.</p>
          <div class="wh-midnight">
            <div class="wh-run">
              <h3 class="wh-h3">By hand</h3>
              <p>Writes every dawn due before night {today} and sends the Town Cryer its dispatches. The same dawns the cron would write.</p>
              <button type="button" class="cf-btn" data-act="admin/run-midnight" data-body="{}">Run midnight now</button>
            </div>
            <div>
              <h3 class="wh-h3">Runs</h3>
              {data.runs.length ? (
                <div class="wh-table-wrap" tabindex="0" role="region" aria-label="Midnight runs">
                  <table class="wh-table">
                    <thead><tr><th scope="col">When</th><th scope="col">By</th><th scope="col" class="num">Night</th><th scope="col" class="num">Ledgers</th><th scope="col" class="num">Nights written</th><th scope="col" class="num">Dispatches</th><th scope="col" class="num">Took</th></tr></thead>
                    <tbody>{data.runs.map((r) => <tr class="wh-row"><td>{when(r.ranAt)}</td><td class="dim">{r.source === 'cron' ? 'cron' : 'hand'}</td><td class="num">{r.night}</td><td class="num">{r.ledgers}</td><td class="num">{r.nights}</td><td class="num">{r.dispatches}</td><td class="num dim">{r.durationMs < 1000 ? `${r.durationMs} ms` : `${(r.durationMs / 1000).toFixed(1)} s`}</td></tr>)}</tbody>
                  </table>
                </div>
              ) : <p class="wh-empty">Midnight has not run yet. The cron runs at 23:15 UTC; a ledger visit writes its own dawns meanwhile.</p>}
            </div>
          </div>
        </section>}
      </>
    )}
  </main>
  <div class="cf-toast" id="toast" hidden role="status"></div>
</Base>

<script>
  import { createAuthClient } from 'better-auth/client';
  import { wireManage } from '../../lib/manage';

  document.body.classList.add('curfew-body');
  const root = document.getElementById('main-content')!;
  const base = root.dataset.base ?? '';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  // buttons with data-act and forms with data-api post and reload; refusals are shown as written
  wireManage(root, base);

  function toast(text: string) {
    const el = $('toast'); el.textContent = text; el.hidden = false;
    clearTimeout((el as any)._t); (el as any)._t = setTimeout(() => (el.hidden = true), 4200);
  }

  async function order(action: string, body: unknown): Promise<{ message?: string }> {
    const url = new URL(`${base}/api/admin/${action}`, location.href);
    const res = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body), credentials: 'same-origin' });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error ?? 'The city did not answer. Try again.');
    return data;
  }
  // a reset word for a player: shown once, in their row, to pass on
  async function issueReset(button: HTMLButtonElement) {
    if (button.dataset.confirm && !confirm(button.dataset.confirm)) return;
    button.setAttribute('aria-busy', 'true'); button.disabled = true;
    try {
      const data = await order('issue-reset', { userId: button.dataset.issue }) as { word?: string; message?: string };
      const cell = document.querySelector<HTMLElement>(`[data-reset-cell="${button.dataset.issue}"]`);
      const esc = (t: string) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
      if (cell && data.word) { cell.classList.remove('dim'); cell.innerHTML = `<code class="wh-phrase">${esc(data.word)}</code><small class="wh-phrase-note">Shown once. Pass it to ${esc(button.dataset.name ?? 'the player')}; good for two days.</small>`; }
      toast(data.message ?? 'Issued.');
      button.removeAttribute('aria-busy'); button.disabled = false;
    } catch (e) {
      button.removeAttribute('aria-busy'); button.disabled = false;
      toast((e as Error).message);
    }
  }
  root.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const issue = target.closest<HTMLButtonElement>('button[data-issue]');
    if (issue) { void issueReset(issue); return; }
    const inspect = target.closest<HTMLButtonElement>('button[data-inspect]');
    if (inspect) {
      const row = document.getElementById(`detail-${inspect.dataset.inspect}`);
      if (!row) return;
      const open = row.hidden;
      row.hidden = !open;
      inspect.setAttribute('aria-expanded', String(open));
      inspect.textContent = open ? 'Close' : 'Inspect';
    }
  });

  // the notice's counter; the form itself posts through data-api
  const form = document.getElementById('notice-form') as HTMLFormElement | null;
  if (form) {
    const text = form.querySelector('textarea')!, count = $('notice-count');
    const update = () => { count.textContent = `${text.value.trim().length} / 200`; count.classList.toggle('over', text.value.trim().length > 200); };
    text.addEventListener('input', update); update();
  }

  // which section is in view
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.wh-nav a')];
  const sections = links.map((a) => document.querySelector<HTMLElement>(a.hash)).filter((s): s is HTMLElement => !!s);
  if (sections.length && 'IntersectionObserver' in window) {
    let current: string | null = null;
    const mark = () => {
      const offset = 120;
      const active = sections.filter((s) => s.getBoundingClientRect().top <= offset).at(-1) ?? sections[0];
      if (active.id === current) return;
      current = active.id;
      for (const a of links) { if (a.hash === `#${current}`) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); }
    };
    addEventListener('scroll', mark, { passive: true }); mark();
  }

  document.getElementById('signout')?.addEventListener('click', async () => {
    const authClient = createAuthClient({ baseURL: location.origin, basePath: `${base}/api/auth` });
    await authClient.signOut();
    location.href = `${base}/curfew/`;
  });
</script>
