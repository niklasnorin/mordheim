---
import Base from '../../layouts/Base.astro';
import '../../styles/curfew.css';
import campaign from '../../data/curfew/campaign.json';
import { base } from '../../lib/site';
import { hasDatabase } from '../../server/db/client';
import { env } from '../../server/env';
import { getViewer } from '../../server/session';
import PlaceBand from '../../components/PlaceBand.astro';
import { LedgerError, actions, currentLocation, todayFor, type LedgerView } from '../../server/curfew/service';
import { DEFAULT_LOCATION, locationById, type Location } from '../../curfew/engine';
import { isDryRun } from '../../server/curfew/dry';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const ready = hasDatabase();
const viewer = ready ? await getViewer(Astro.request) : null;
const today = todayFor(Astro.url, viewer);
let view: LedgerView | null = null;
let trouble = false;
const dry = !!viewer && isDryRun(Astro.request, viewer);
// Where the campaign is tonight, so the band is the same letterhead the Ledger carries, database or no.
let place: Location = DEFAULT_LOCATION;
if (ready) {
  try { place = await currentLocation(today); } catch (e) { console.error('[curfew] location unavailable', e); }
}
if (viewer) {
  // Arriving at the Eve with an empty Hand, the City Provides one charm. Nothing else changes on a visit. In a dry run, nothing at all does.
  try { view = await actions.eveOpen(viewer.id, today, dry ? {} : undefined); } catch (e) { if (!(e instanceof LedgerError && e.status === 404)) { console.error('[curfew] eve unavailable', e); trouble = true; } }
}
if (view) place = locationById(view.locationId);
const boot = { today, debug: env.CURFEW_DEBUG, dry, view };
const ledgerHref = `${base}/curfew/`;
---

<Base title="The Eve of Battle — Curfew" description="Lay your Hand on the table the night before a fight. Choose which charms to bring and spend the city's regard on one flourish.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Barlow+Condensed:wght@600&family=Cinzel:wght@700&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#0e0d0c" />
  </Fragment>

  <main class="curfew cf-wrap" id="main-content" data-base={base} data-cost={campaign.flourishCost}>
    <header class="cf-top">
      <a class="cf-back" href={ledgerHref}>← The Ledger</a>
      <a class="cf-wordmark" href={ledgerHref}>Curfew</a>
      <div class="cf-nightline" id="nightline">The Eve</div>
    </header>

    <PlaceBand place={place} />

    <section class="cf-section cf-section-first">
      <h1 class="cf-h2">The Eve of Battle</h1>
      <p class="cf-lede">The night before a fight, nothing keeps.</p>
      <p class="cf-muted">Lay your Hand on the table. Choose what to bring. Spend the city's regard on one flourish. Then show the rival your ticket: how many charms, not which.</p>
      <div class="cf-table" id="table">
        {!ready && <p class="cf-empty">The ledgers are not open on this deployment.</p>}
        {ready && !viewer && <p class="cf-empty">Nobody is signed in. <a href={ledgerHref}>Open the Ledger</a> and sign in first.</p>}
        {viewer && !view && !trouble && <p class="cf-empty">You keep no ledger yet. <a href={ledgerHref}>Open the Ledger</a> and take up your warband first.</p>}
        {trouble && <p class="cf-empty">The table could not be read just now. Try again in a moment.</p>}
      </div>
    </section>
    <div class="cf-debug" id="debug-bar" hidden></div>
  </main>
  <div class="cf-toast" id="toast" hidden role="status"></div>
  <script is:inline type="application/json" id="boot" set:html={JSON.stringify(boot).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { warbands } from '../../data/warbands';
  import { CAMPAIGN, HAND_SIZE, TOKEN_TYPES, cityProvidesLine, curseById, dateForNight, locationById, readTicket, tokenById, omenForNight } from '../../curfew/engine';
  import { afflictionsAt } from '../../curfew/ledger';
  import { formatImperial, imperialForDate } from '../../lib/calendar';
  import type { Flourish, WarbandState } from '../../curfew/ledger';
  import { sealSvg } from '../../curfew/glyphs';
  import { carryDate, debugEnabled, loadSandbox, renderDebugBar, saveSandbox } from '../../curfew/debug';

  interface View { warbandId: string; state: WarbandState; today: number; recovering: string[]; fresh: boolean; locationId: string; dry?: boolean }
  interface Boot { today: number; debug: boolean; dry: boolean; view: View | null }

  document.body.classList.add('curfew-body');
  const root = document.getElementById('main-content')!;
  const base = root.dataset.base ?? '';
  const boot: Boot = JSON.parse(document.getElementById('boot')!.textContent || '{}');
  const cost = CAMPAIGN.flourishCost;
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  function toast(text: string) { const el = $('toast'); el.textContent = text; el.hidden = false; clearTimeout((el as any)._t); (el as any)._t = setTimeout(() => (el.hidden = true), 3600); }

  const today = boot.today;
  const table = $('table');
  // a dry run: the sandbox the Ledger stepped is the base here too, and nothing is saved
  const dryRun = boot.dry && debugEnabled();
  const realLastResolved = boot.view?.state.lastResolved ?? 0;
  if (boot.debug && debugEnabled()) {
    renderDebugBar($('debug-bar'), today, dryRun && boot.view ? { sandbox: loadSandbox(boot.view.warbandId), wouldPrint: [], onReset: () => { location.href = `${base}/curfew/`; } } : undefined);
    carryDate(document.querySelector<HTMLAnchorElement>('.cf-back')); carryDate(document.querySelector<HTMLAnchorElement>('.cf-wordmark'));
  }

  async function api(action: string, body: Record<string, unknown> = {}): Promise<View> {
    const url = new URL(`${base}/api/curfew/${action}`, location.href);
    const date = new URLSearchParams(location.search).get('date');
    if (date) url.searchParams.set('date', date);
    if (dryRun && boot.view) body = { ...body, dry: { base: loadSandbox(boot.view.warbandId)?.state } };
    const res = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body), credentials: 'same-origin' });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error ?? 'The city did not answer. Try again.');
    const next: View = data.view;
    if (dryRun && next?.dry) saveSandbox(next.warbandId, next.state, realLastResolved);
    return next;
  }

  if (boot.view) {
    let state: WarbandState = boot.view.state;
    const warband = warbands.find((w) => w.id === boot.view!.warbandId)!;
    const place = locationById(boot.view.locationId);
    $('nightline').innerHTML = `Night <strong>${today}</strong> · ${esc(place.name)} · ${esc(formatImperial(imperialForDate(dateForNight(today)), 'day'))} · ${esc(warband.name)}`;
    const dead = warband.members.filter((m) => m.dead);

    function tokenHtml(id: string, pick = false) {
      const t = tokenById(id); const type = TOKEN_TYPES[t.type];
      const inner = `<span class="cf-cord" aria-hidden="true"></span><span class="cf-seal" style="--seal:${type.seal}">${sealSvg(t.type)}</span><span class="cf-type">${esc(type.name)}</span><span class="cf-token-name">${esc(t.name)}</span><span class="cf-effect">${esc(t.effect)}</span>`;
      return pick
        ? `<label class="cf-token cf-token-pick"><input type="checkbox" class="visually-hidden" checked data-bring="${esc(id)}" />${inner}<span class="cf-token-state" aria-hidden="true"></span></label>`
        : `<div class="cf-token">${inner}</div>`;
    }
    const emptySlot = (text: string) => `<div class="cf-token is-empty"><span class="cf-cord" aria-hidden="true"></span><span class="cf-seal cf-seal-empty" aria-hidden="true"></span><span class="cf-effect">${text}</span></div>`;
    function padSlots(tiles: string[], text: string) { const out = tiles.slice(); while (out.length < HAND_SIZE) out.push(emptySlot(text)); return out.join(''); }
    function charms(n: number) { return `<div class="cf-charms" aria-label="${n} charms">${[0, 1, 2].map((i) => `<span class="cf-charm ${i < n ? '' : 'dim'}"></span>`).join('')}</div>`; }

    function renderLaying() {
      let provided = '';
      if (state.provided && state.provided.night === today) {
        const token = tokenById(state.provided.tokenId);
        provided = `<div class="cf-offer"><h3 class="cf-offer-title">${place.kind === 'village' ? 'The Village Provides' : 'The City Provides'}</h3><p class="cf-italic">${esc(cityProvidesLine(warband.id, today, place))}</p><p>An empty Hand at the Eve is dealt one charm: <b>${esc(token.name)}</b>.</p></div>`;
      }
      const canFlourish = state.favour >= cost;
      // curses still standing on the warband: the table should know
      const standing = afflictionsAt(state, today);
      const afflicted = standing.length
        ? `<p class="cf-note cf-afflictions">Standing on the warband tonight: ${standing.map((a) => { const left = a.fromNight + a.nights - today; return `<b>${esc(warband.members.find((m) => m.id === a.memberId)?.name.split(' ')[0] ?? a.memberId)}: ${esc(curseById(a.curseId)?.name ?? a.curseId)}</b> (${esc(curseById(a.curseId)?.effect ?? '')} ${left} ${left === 1 ? 'night' : 'nights'} more.)`; }).join(' ')} Tell the table.</p>`
        : '';
      table.innerHTML = `
        <h2 class="cf-h2">${esc(warband.name)}</h2>
        <p class="cf-muted">Under ${esc(omenForNight(today).title)}, night ${today}.</p>
        ${provided}${afflicted}
        <h3 class="cf-h3">Bring to the fight</h3>
        <p class="cf-note">One per type, three at most. Tap a charm to leave it behind. Whatever is not brought is lost; the night before a fight, nothing keeps.</p>
        <div class="cf-hand" id="bring">${padSlots(state.hand.map((h) => tokenHtml(h.id, true)), 'an empty palm')}</div>
        <div class="cf-rule"></div>
        <h3 class="cf-h3">One flourish</h3>
        <p class="cf-note">Costs ${cost} Favour. You hold ${state.favour}.</p>
        <div class="cf-flourish">
          <select id="fl-kind" ${canFlourish ? '' : 'disabled'}>
            <option value="">No flourish${canFlourish ? '' : ` (needs ${cost} Favour)`}</option>
            <option value="field">Name the field</option>
            <option value="headline">Plant a headline in the Town Cryer</option>
            <option value="weather">Add a weather line to the scenario</option>
            ${dead.length ? '<option value="dedication">Dedicate the fight to one of the dead</option>' : ''}
          </select>
          <input id="fl-text" type="text" maxlength="120" placeholder="" hidden />
          <select id="fl-dead" hidden>${dead.map((m) => `<option value="${esc(m.name)}">${esc(m.name)}</option>`).join('')}</select>
        </div>
        <div class="cf-rule"></div>
        <button type="button" class="cf-btn" id="lay">Lay the table</button>`;
      const kind = $<HTMLSelectElement>('fl-kind'), text = $<HTMLInputElement>('fl-text'), deadSel = $<HTMLSelectElement>('fl-dead');
      const placeholders: Record<string, string> = { field: 'e.g. Hanna’s Corner', headline: 'e.g. Nordost Kin Seen Buying Candles by the Crate', weather: 'e.g. Sleet from the east; visibility 12"' };
      kind.addEventListener('change', () => { text.hidden = !placeholders[kind.value]; text.placeholder = placeholders[kind.value] ?? ''; deadSel.hidden = kind.value !== 'dedication'; });
      $('lay').addEventListener('click', async () => {
        const bring = [...table.querySelectorAll<HTMLInputElement>('[data-bring]')].filter((c) => c.checked).map((c) => c.dataset.bring!);
        let flourish: Flourish | undefined;
        if (kind.value) {
          const t = kind.value === 'dedication' ? deadSel.value : text.value.trim();
          if (!t) { toast('The flourish needs words.'); return; }
          flourish = { kind: kind.value as Flourish['kind'], text: t };
        }
        $<HTMLButtonElement>('lay').disabled = true;
        try { state = (await api('eve-lay', { bring, flourish })).state; renderLaid(); }
        catch (e) { $<HTMLButtonElement>('lay').disabled = false; toast((e as Error).message); }
      });
    }

    function flourishLine(f: Flourish) {
      return { field: `The field is named <b>${esc(f.text)}</b>.`, headline: `The Town Cryer will print: <b>${esc(f.text)}</b>`, weather: `Weather for the scenario: <b>${esc(f.text)}</b>`, dedication: `This fight is for <b>${esc(f.text)}</b>.` }[f.kind];
    }
    function renderLaid() {
      const eve = state.eve!;
      table.innerHTML = `
        <h2 class="cf-h2">Brought to the fight</h2>
        <p class="cf-muted">${esc(warband.name)}, night ${eve.night}.</p>
        <div class="cf-ticket" id="ticket">${esc(eve.ticket)}</div>
        <p class="cf-note">Show this to the rival. It says how many charms you carry, not which.</p>
        <div class="cf-hand" style="margin-top:1rem">${padSlots(eve.tokens.map((id) => tokenHtml(id)), eve.tokens.length ? 'left behind' : 'nothing brought')}</div>
        ${eve.flourish ? `<p style="margin-top:1rem">${flourishLine(eve.flourish)}</p>` : '<p class="cf-note" style="margin-top:1rem">No flourish.</p>'}
        <div class="cf-rule"></div>
        <h3 class="cf-h3">A dim glimpse of the rival's table</h3>
        <div class="cf-glimpse"><input id="rival-ticket" type="text" placeholder="Their ticket, e.g. EVE-2-K7Q1P" aria-label="Rival ticket" /><button type="button" class="cf-btn cf-btn-ghost" id="glimpse">Look</button></div>
        <div class="cf-glimpse-out" id="glimpse-out"></div>
        <div class="cf-rule"></div>
        <p class="cf-note">Play the game with these on the table. When it is recorded, mark them spent; they are consumed whether used or not.</p>
        <div class="cf-watch-foot"><button type="button" class="cf-btn cf-btn-blood" id="done">The fight is done</button><button type="button" class="cf-btn cf-btn-ghost" id="undo">Put the charms back</button></div>`;
      $('glimpse').addEventListener('click', () => {
        const n = readTicket($<HTMLInputElement>('rival-ticket').value);
        $('glimpse-out').innerHTML = n === null ? 'That is not a ticket.' : `Candles on the far side of the room. ${n === 0 ? 'Their palm is empty.' : `${n} ${n === 1 ? 'charm' : 'charms'} on their table.`}${charms(n)}`;
      });
      $('done').addEventListener('click', async () => {
        if (!confirm('Mark the charms spent and close the Eve?')) return;
        try { await api('eve-done'); toast('Spent. The Hand is empty again.'); location.href = `${base}/curfew/`; }
        catch (e) { toast((e as Error).message); }
      });
      $('undo').addEventListener('click', async () => {
        if (!confirm('Put the charms back in the Hand and reopen the table? Spent Favour does not return.')) return;
        try { state = (await api('eve-undo')).state; renderLaying(); }
        catch (e) { toast((e as Error).message); }
      });
    }

    if (dryRun && loadSandbox(warband.id)) {
      // the page was rendered from the real ledger; the sandbox is the base of this dry run
      api('eve-open').then((v) => { state = v.state; if (state.eve) renderLaid(); else renderLaying(); }).catch((e) => toast((e as Error).message));
    } else if (state.eve) renderLaid(); else renderLaying();
  }
</script>
