---
import Base from '../../layouts/Base.astro';
import '../../styles/curfew.css';
import { warbands } from '../../data/warbands';
import campaign from '../../data/curfew/campaign.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Curfew — Nights in the City of the Damned" description="Every real day is one night in Mordheim. Give your warband its orders at dusk; read what it cost them at dawn.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Barlow+Condensed:wght@600&family=Cinzel:wght@700&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#0e0d0c" />
  </Fragment>

  <main class="curfew cf-wrap" id="main-content" data-base={base} data-start={campaign.start}>
    <header class="cf-top">
      <a class="cf-back" href={`${base}/`}>← Mordheim</a>
      <a class="cf-wordmark" href={`${base}/curfew/`}>Curfew</a>
      <div class="cf-nightline" id="nightline">Night <strong>—</strong></div>
    </header>

    <!-- Once a ledger is chosen the picker folds into this one line, so the daily scroll starts at last night. -->
    <div class="cf-identity" id="identity" hidden>
      <h1 class="cf-identity-name" id="identity-name"></h1>
      <span class="cf-identity-meta" id="identity-meta"></span>
      <button type="button" class="cf-linkbtn" id="change-warband">Change ledger</button>
    </div>

    <section class="cf-section cf-section-first" id="warband-section">
      <h1 class="cf-h2">Whose ledger is this?</h1>
      <p class="cf-muted">Every real day is one night in Mordheim. At dusk you give your warband its orders. At midnight the city answers. At dawn you read what it cost them. Two minutes a day. The city takes nothing from those who stay away.</p>
      <div class="cf-pick" id="warband-pick">
        {warbands.map((wb) => (
          <button type="button" data-warband={wb.id} aria-pressed="false">
            <span class="cf-sigil" aria-hidden="true">{wb.sigil}</span>
            <span>{wb.name}<small>{wb.type}{wb.player ? ` · ${wb.player}` : ''}</small></span>
          </button>
        ))}
      </div>
    </section>

    <div id="ledger" hidden>
      <!-- 1. Wrap up last night -->
      <section class="cf-section cf-section-first" id="dawn" aria-labelledby="dawn-title">
        <h2 class="cf-h2" id="dawn-title">Last night</h2>
        <div class="cf-panel cf-dawn" id="dawn-report"></div>
      </section>

      <!-- 2. Learn about and plan tonight -->
      <section class="cf-section" id="tonight" aria-labelledby="tonight-title">
        <h2 class="cf-h2" id="tonight-title">Tonight</h2>
        <div class="cf-omen">
          <div class="cf-card" id="omen-card">
            <div class="cf-card-inner">
              <img class="cf-back-img" src={`${base}/curfew/omens/back.png`} alt="" width="1050" height="1800" />
              <img class="cf-face" id="omen-img" src={`${base}/curfew/omens/back.png`} alt="" width="1050" height="1800" />
            </div>
          </div>
          <div class="cf-omen-text" id="omen-text"></div>
        </div>

        <div class="cf-watch" id="watch">
          <h3 class="cf-h3">Who goes out?</h3>
          <p class="cf-muted">Send up to <span id="per-night">{campaign.membersPerNight}</span>. The dead and the wounded stay home. The dice decide at midnight; nothing you choose here can curse anyone.</p>
          <div class="cf-orders-given" id="orders-given" hidden></div>
          <div class="cf-watch-list" id="watch-list"></div>
          <div class="cf-watch-foot">
            <span class="cf-small" id="watch-count"></span>
            <button type="button" class="cf-btn" id="give-orders">Give orders</button>
          </div>
          <details class="cf-details cf-details-quiet">
            <summary>What each errand brings</summary>
            <div class="cf-inner cf-errand-help" id="errand-help"></div>
          </details>
        </div>
      </section>

      <!-- 3. What you carry -->
      <section class="cf-section" id="hand" aria-labelledby="hand-title">
        <h2 class="cf-h2" id="hand-title">The Hand</h2>
        <div class="cf-hand-grid">
          <div>
            <div class="cf-hand" id="hand-list"></div>
            <p class="cf-note" style="margin-top:.8rem">Three charms, one palm. They are spent at the next game whether used or not. <a id="eve-link" href={`${base}/curfew/eve/`}>Lay the table for the Eve of Battle →</a></p>
          </div>
          <div class="cf-meters" id="meters"></div>
        </div>
      </section>

      <!-- 4. The longer memory -->
      <section class="cf-section" id="rumours-section" aria-labelledby="rumours-title">
        <h2 class="cf-h2" id="rumours-title">Rumours</h2>
        <p class="cf-muted">Warm for seven nights, then cold.</p>
        <ul class="cf-rumours" id="rumours"></ul>
      </section>

      <section class="cf-section" id="chronicle-section" aria-labelledby="chronicle-title">
        <h2 class="cf-h2" id="chronicle-title">The Chronicle</h2>
        <p class="cf-muted">What the earlier nights have written.</p>
        <ol class="cf-chron" id="chronicle"></ol>
        <button type="button" class="cf-btn cf-btn-ghost cf-more" id="chron-more" hidden>Older nights</button>
      </section>

      <section class="cf-section">
        <details class="cf-details" id="standing">
          <summary>Standing orders · what runs when you do not log in</summary>
          <div class="cf-inner">
            <p class="cf-note">On a night without orders, these members go out on their usual errand at half yield. No charms, no risk. The Chronicle still writes. Stay away longer than {campaign.returnAfterNights} nights and the city simply waits: one vignette on your return, Favour primed to 20, nothing to catch up on.</p>
            <div class="cf-watch-list" id="standing-list"></div>
          </div>
        </details>
      </section>

      <footer class="cf-foot">
        <span>Nights turn at local midnight. This ledger lives on this device.</span>
        <button type="button" class="cf-linkbtn" id="reset">Burn this ledger</button>
      </footer>
    </div>
  </main>
  <div class="cf-toast" id="toast" hidden role="status"></div>
</Base>

<script>
  import { warbands } from '../../data/warbands';
  import { history } from '../../data/history';
  import {
    CAMPAIGN, ERRANDS, ERRAND_LABEL, ERRAND_BLURB, TOKEN_TYPES, HAND_SIZE, availability, moonForNight, omenForNight, tiltFor, titleFor, nextTitle, tokenById, dateForNight,
    type Errand, type NightResult, type Order,
  } from '../../curfew/engine';
  import { chooseWarband, chosenWarband, giveOrders, loadState, reconcile, recoveringMembers, resetState, saveState, settleOffer, todayNight, type WarbandState } from '../../curfew/state';
  import { sealSvg } from '../../curfew/glyphs';

  document.body.classList.add('curfew-body');
  const root = document.getElementById('main-content')!;
  const base = root.dataset.base ?? '';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const today = todayNight();
  let warband = warbands.find((w) => w.id === chosenWarband()) ?? null;
  let state: WarbandState | null = null;
  let chronShown = 6;

  function toast(text: string) {
    const el = $('toast'); el.textContent = text; el.hidden = false;
    clearTimeout((el as any)._t); (el as any)._t = setTimeout(() => (el.hidden = true), 3600);
  }
  function injuredLastBattle(id: string): string[] {
    const record = history.slice().sort((a, b) => a.sequence - b.sequence).at(-1);
    return record?.warbands.find((w) => w.warbandId === id)?.members.filter((m) => m.status === 'injured').map((m) => m.memberId) ?? [];
  }
  function recovering(): string[] { return state && warband ? recoveringMembers(state, injuredLastBattle(warband.id)) : []; }
  function rivalOf(id: string) { return warbands.find((w) => w.id !== id); }
  function memberName(id: string) { return warband?.members.find((m) => m.id === id)?.name ?? id; }
  function firstName(id: string) { return memberName(id).split(' ')[0]; }
  function prettyDate(night: number) {
    const d = new Date(dateForNight(night) + 'T12:00:00Z');
    return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', timeZone: 'UTC' });
  }

  // ── warband ──
  function select(id: string) {
    warband = warbands.find((w) => w.id === id) ?? null;
    if (!warband) return;
    chooseWarband(id);
    state = loadState(warband, today);
    const written = reconcile(state, warband, today, recovering(), rivalOf(warband.id));
    for (const b of root.querySelectorAll<HTMLButtonElement>('#warband-pick button')) b.setAttribute('aria-pressed', String(b.dataset.warband === id));
    showPicker(false);
    $('ledger').hidden = false;
    renderAll(written.length > 0);
  }
  function showPicker(show: boolean) {
    $('warband-section').hidden = !show;
    $('identity').hidden = show || !warband;
    if (warband) {
      $('identity-name').textContent = warband.name;
      $('identity-meta').textContent = warband.type + (warband.player ? ` · ${warband.player}` : '');
    }
  }
  root.querySelector('#warband-pick')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-warband]');
    if (b) select(b.dataset.warband!);
  });
  $('change-warband').addEventListener('click', () => { showPicker(true); $('warband-section').scrollIntoView({ block: 'start' }); });

  // ── render ──
  function renderAll(fresh = false) {
    if (!warband || !state) return;
    renderNightline(); renderDawn(fresh); renderOmen(); renderWatch(); renderHand(); renderRumours(); renderChronicle(); renderStanding();
  }
  function renderNightline() {
    const moon = moonForNight(today);
    $('nightline').innerHTML = today < 1
      ? `The city sleeps until <strong>${esc(prettyDate(1))}</strong>`
      : `Night <strong>${today}</strong> · ${esc(moon.name)} · ${esc(prettyDate(today))}`;
  }

  // 1. Last night
  function nightHtml(n: NightResult, ink: boolean, headingTag: 'h3' | 'h4' = 'h3') {
    const lines: string[] = [];
    lines.push(...n.results.map((r) => r.prose));
    lines.push(n.detail);
    if (n.closer) lines.push(n.closer);
    const paras = lines.map((l, i) => `<p class="${ink ? 'cf-ink' : ''}" style="animation-delay:${0.15 + i * 0.45}s">${esc(l)}</p>`).join('');
    const ledger = n.ledger.length ? `<div class="cf-ledger">Ledger: ${n.ledger.map((l) => `<strong>${esc(l)}</strong>`).join(' · ')}</div>` : '';
    return `<${headingTag} class="cf-dawn-head">${esc(n.header)}</${headingTag}>${paras}${ledger}`;
  }
  function renderDawn(fresh: boolean) {
    const el = $('dawn-report');
    const last = state!.nights.at(-1);
    if (!last) {
      el.innerHTML = `<h3 class="cf-dawn-head">No dawn yet.</h3><p>Your first night is below. Give the orders; the city answers at midnight, and tomorrow the report is written here.</p>`;
      return;
    }
    let html = nightHtml(last, fresh && !reduced);
    for (const offer of state!.offers) html += offerHtml(offer, last);
    el.innerHTML = html;
  }
  // Which charm the player has marked to keep, per offer, before confirming. Never saved: a reload clears it.
  const offerPicks = new Map<string, 'incoming' | 'held'>();
  const offerKey = (o: { night: number; incoming: string; held: string }) => `${o.night}:${o.incoming}:${o.held}`;
  function offerHtml(offer: { night: number; incoming: string; held: string }, last: NightResult) {
    const inc = tokenById(offer.incoming), held = tokenById(offer.held);
    const who = last.results.find((r) => r.token?.id === offer.incoming)?.memberId;
    const pick = offerPicks.get(offerKey(offer));
    const keep = pick === 'incoming' ? inc : pick === 'held' ? held : null;
    const lose = pick === 'incoming' ? held : pick === 'held' ? inc : null;
    const footer = keep && lose
      ? `<div class="cf-offer-confirm" role="group" aria-label="Confirm your choice">
          <p><b>${esc(keep.name)}</b> stays in the Hand. <b>${esc(lose.name)}</b> goes in the river, and does not come back.</p>
          <div class="cf-offer-actions"><button type="button" class="cf-btn cf-btn-blood" data-confirm="${pick}">Let ${esc(lose.name)} go</button><button type="button" class="cf-btn cf-btn-ghost" data-unpick>Not yet</button></div>
        </div>`
      : `<p class="cf-note cf-offer-hint">Choose the charm to keep. Nothing is decided until you confirm.</p>`;
    return `<div class="cf-offer" data-night="${offer.night}" data-incoming="${esc(offer.incoming)}" data-held="${esc(offer.held)}">
      <h4 class="cf-offer-title">The Hand is full</h4>
      <p>${who ? esc(firstName(who)) + ' brought back' : 'The night brought'} <b>${esc(inc.name)}</b>. Keep it, or keep <b>${esc(held.name)}</b>. Over a month the Hand does not grow; it gets curated.</p>
      <div class="cf-hand" role="group" aria-label="Charm to keep">
        ${tokenHtml(inc.id, 'button', `data-keep="incoming" aria-pressed="${pick === 'incoming'}" aria-label="Keep ${esc(inc.name)}"`)}
        ${tokenHtml(held.id, 'button', `data-keep="held" aria-pressed="${pick === 'held'}" aria-label="Keep ${esc(held.name)}"`)}
      </div>
      ${footer}
    </div>`;
  }
  function tokenHtml(id: string, tag: 'div' | 'button' = 'div', attrs = '', earnedNight?: number) {
    const t = tokenById(id); const type = TOKEN_TYPES[t.type];
    const typeAttr = tag === 'button' ? ' type="button"' : '';
    const since = earnedNight ? `<span class="cf-token-since">Found night ${earnedNight}</span>` : '';
    return `<${tag}${typeAttr} class="cf-token" ${attrs}><span class="cf-cord" aria-hidden="true"></span><span class="cf-seal" style="--seal:${type.seal}">${sealSvg(t.type)}</span><span class="cf-type">${esc(type.name)}</span><span class="cf-token-name">${esc(t.name)}</span><span class="cf-effect">${esc(t.effect)}</span>${since}</${tag}>`;
  }
  $('dawn-report').addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const box = target.closest<HTMLElement>('.cf-offer'); if (!box || !state) return;
    const offer = state.offers.find((o) => String(o.night) === box.dataset.night && o.incoming === box.dataset.incoming && o.held === box.dataset.held);
    if (!offer) return;
    const last = state.nights.at(-1)!;
    const pickBtn = target.closest<HTMLElement>('[data-keep]');
    const confirmBtn = target.closest<HTMLElement>('[data-confirm]');
    const unpick = target.closest<HTMLElement>('[data-unpick]');
    if (pickBtn) {
      // Step one: mark the charm to keep. Tapping it again unmarks it.
      const choice = pickBtn.dataset.keep as 'incoming' | 'held';
      if (offerPicks.get(offerKey(offer)) === choice) offerPicks.delete(offerKey(offer)); else offerPicks.set(offerKey(offer), choice);
      box.outerHTML = offerHtml(offer, last);
      const fresh = $('dawn-report').querySelector<HTMLElement>(`.cf-offer[data-incoming="${offer.incoming}"]`);
      (fresh?.querySelector<HTMLElement>('[data-confirm]') ?? fresh?.querySelector<HTMLElement>(`[data-keep="${choice}"]`))?.focus();
    } else if (unpick) {
      offerPicks.delete(offerKey(offer));
      box.outerHTML = offerHtml(offer, last);
    } else if (confirmBtn) {
      // Step two: the decision.
      const choice = confirmBtn.dataset.confirm as 'incoming' | 'held';
      offerPicks.delete(offerKey(offer));
      settleOffer(state, offer, choice);
      toast(choice === 'incoming' ? `${tokenById(offer.held).name} goes in the river.` : `${tokenById(offer.incoming).name} goes in the river.`);
      renderDawn(false); renderHand();
    }
  });

  // 2. Tonight
  function renderOmen() {
    const omen = omenForNight(today), moon = moonForNight(today);
    const img = $<HTMLImageElement>('omen-img');
    img.src = `${base}${omen.image}`; img.alt = `${omen.title}. ${omen.reading}`;
    const tilts = ERRANDS.map((e) => ({ e, t: tiltFor(e, omen, moon) })).filter((x) => x.t !== 0);
    $('omen-text').innerHTML = `
      <h3 class="cf-omen-title"><span class="cf-numeral">${esc(omen.numeral)}</span> ${esc(omen.title)}</h3>
      <p class="cf-reading">“${esc(omen.reading)}”</p>
      <p class="cf-muted">${esc(omen.notes)}</p>
      <div class="cf-moon"><strong>${esc(moon.name)}</strong><span class="cf-italic">${esc(moon.reading)}</span>${moon.flatOmen ? '<div class="cf-note">The Omen’s tilt does not apply this Moon.</div>' : ''}</div>
      <ul class="cf-tilts" aria-label="Tonight's odds">${tilts.length ? tilts.map(({ e, t }) => `<li class="cf-tilt ${t > 0 ? 'up' : 'down'}"><span>${esc(ERRAND_LABEL[e])}</span><span aria-label="${t > 0 ? 'favoured' : 'perilous'} ${Math.abs(t)}">${t > 0 ? '▲'.repeat(t) : '▼'.repeat(-t)}</span></li>`).join('') : '<li class="cf-tilt flat">A flat night</li>'}</ul>`;
    const card = $('omen-card');
    const key = `curfew:flipped:${warband!.id}:${today}`;
    let seen = false; try { seen = sessionStorage.getItem(key) === '1'; } catch {}
    card.classList.toggle('is-flipped', seen || reduced);
    if (!seen && !reduced) setTimeout(() => { card.classList.add('is-flipped'); try { sessionStorage.setItem(key, '1'); } catch {} }, 500);
  }

  function renderWatch() {
    const w = warband!, s = state!;
    const rec = recovering();
    const av = availability(w, rec);
    const given = s.orders[today] ?? [];
    const errandOptions = (sel: Errand) => ERRANDS.map((e) => `<option value="${e}" ${e === sel ? 'selected' : ''}>${ERRAND_LABEL[e]}</option>`).join('');
    $('watch-list').innerHTML = w.members.map((m) => {
      const a = av.find((x) => x.memberId === m.id)!;
      const order = given.find((o) => o.memberId === m.id);
      const ep = s.epithets[m.id] ? ` <span class="cf-epithet">${esc(m.name.split(' ')[0])} ${esc(s.epithets[m.id])}</span>` : '';
      if (!a.available) {
        const status = a.reason === 'dead'
          ? '<span class="cf-status dead">Dead · stays home</span>'
          : `<span class="cf-status-wrap"><span class="cf-status">Recovering · stays home</span><button type="button" class="cf-btn cf-btn-ghost cf-heal" data-heal="${esc(m.id)}">Back on their feet</button></span>`;
        return `<div class="cf-member is-out"><span class="cf-check-space" aria-hidden="true"></span><span><span class="cf-name">${esc(m.name)}</span>${ep}<span class="cf-role">${esc(m.role)}</span></span>${status}</div>`;
      }
      return `<div class="cf-member" data-member="${esc(m.id)}">
        <label class="cf-member-pick"><input type="checkbox" ${order ? 'checked' : ''} /><span><span class="cf-name">${esc(m.name)}</span>${ep}<span class="cf-role">${esc(m.role)}</span></span></label>
        <select aria-label="Errand for ${esc(m.name)}">${errandOptions(order?.errand ?? s.standing.errands[m.id] ?? 'carouse')}</select>
      </div>`;
    }).join('');
    $('errand-help').innerHTML = ERRANDS.map((e) => `<div><b>${ERRAND_LABEL[e]}</b>${esc(ERRAND_BLURB[e])}</div>`).join('');
    const summary = $('orders-given');
    if (given.length) {
      summary.hidden = false;
      summary.innerHTML = `<b>Orders given.</b> ${given.map((o) => `${esc(firstName(o.memberId))} will ${ERRAND_LABEL[o.errand].toLowerCase()}`).join('; ')}. The city answers at midnight. You can change your mind until then.`;
    } else summary.hidden = true;
    updateWatchCount();
    const btn = $<HTMLButtonElement>('give-orders');
    btn.textContent = given.length ? 'Change orders' : 'Give orders';
    btn.disabled = today < 1;
    if (today < 1) $('watch-count').textContent = `The first night is ${prettyDate(1)}.`;
  }
  function checkedOrders(): Order[] {
    return [...root.querySelectorAll<HTMLElement>('#watch-list .cf-member[data-member]')]
      .filter((row) => row.querySelector<HTMLInputElement>('input')!.checked)
      .map((row) => ({ memberId: row.dataset.member!, errand: row.querySelector<HTMLSelectElement>('select')!.value as Errand }));
  }
  function updateWatchCount() {
    if (today < 1) return;
    const n = checkedOrders().length, max = CAMPAIGN.membersPerNight;
    $('watch-count').textContent = `${n} of ${max} chosen`;
    for (const row of root.querySelectorAll<HTMLElement>('#watch-list .cf-member[data-member]')) {
      const cb = row.querySelector<HTMLInputElement>('input')!;
      cb.disabled = !cb.checked && n >= max;
      row.classList.toggle('is-chosen', cb.checked);
    }
  }
  $('watch-list').addEventListener('change', updateWatchCount);
  $('watch-list').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-heal]'); if (!b || !state) return;
    state.healed.push(b.dataset.heal!); saveState(state);
    toast(`${memberName(b.dataset.heal!)} is back on their feet.`); renderWatch(); renderStanding();
  });
  $('give-orders').addEventListener('click', () => {
    if (!state) return;
    const orders = checkedOrders();
    giveOrders(state, today, orders); saveState(state);
    renderWatch();
    toast(orders.length ? 'Orders given. The city answers at midnight.' : 'Nobody chosen. The door stays barred tonight.');
  });

  // 3. The Hand
  function renderHand() {
    const s = state!;
    const slots = s.hand.slice().sort((a, b) => a.earnedNight - b.earnedNight).map((h) => tokenHtml(h.id, 'div', '', h.earnedNight));
    while (slots.length < HAND_SIZE) slots.push('<div class="cf-token is-empty"><span class="cf-cord" aria-hidden="true"></span><span class="cf-seal cf-seal-empty" aria-hidden="true"></span><span class="cf-effect">an empty palm</span></div>');
    $('hand-list').innerHTML = slots.join('');
    const title = titleFor(s.renown), next = nextTitle(s.renown);
    $('meters').innerHTML = `
      <div class="cf-meter"><div class="cf-meter-label"><span>Favour</span><strong>${s.favour}<small> / 100</small></strong></div><div class="cf-bar" role="img" aria-label="Favour ${s.favour} of 100, soft cap ${CAMPAIGN.favourSoftCap}"><span style="transform:scaleX(${s.favour / 100})"></span><i class="cf-cap" style="left:${CAMPAIGN.favourSoftCap}%"></i></div><div class="cf-note">The city forgets quickly. Past ${CAMPAIGN.favourSoftCap} the surplus becomes a name. Spend it at the Eve.</div></div>
      <div class="cf-stats">
        <div class="cf-stat"><span>Shards</span><b class="wyrd">${s.shards}</b><small>${s.shards >= 5 ? 'Five make a Market chit at Trade' : 'Never rot'}</small></div>
        <div class="cf-stat"><span>Renown</span><b>${s.renown}</b><small>${next ? `${esc(next.title)} at ${next.renown}` : 'A name that will keep'}</small></div>
      </div>
      <div class="cf-title-line">${esc(warband!.name)} are called <b>${esc(title)}</b>.</div>`;
  }

  // 4. Memory
  function renderRumours() {
    const list = state!.rumours.slice().reverse();
    $('rumours').innerHTML = list.length ? list.map((r) => `<li>${esc(r.text)}<small>night ${r.night}</small></li>`).join('') : '<li class="cf-muted">Nobody has heard anything worth repeating. Send someone to listen.</li>';
  }
  function renderChronicle() {
    // The newest night is already open above as Last night; the Chronicle starts with the one before.
    const nights = state!.nights.slice(0, -1).reverse();
    $('chronicle').innerHTML = nights.length ? nights.slice(0, chronShown).map((n) => `<li>${nightHtml(n, false)}</li>`).join('') : `<li class="cf-empty">${state!.nights.length ? 'One night so far. The rest of the page is still to be written.' : 'The first page is blank. The ink is waiting.'}</li>`;
    $('chron-more').hidden = nights.length <= chronShown;
  }
  $('chron-more').addEventListener('click', () => { chronShown += 10; renderChronicle(); });

  function renderStanding() {
    const w = warband!, s = state!;
    const rec = recovering();
    $('standing-list').innerHTML = w.members.filter((m) => !m.dead).map((m) => {
      const on = s.standing.members.includes(m.id);
      const options = ERRANDS.map((e) => `<option value="${e}" ${e === (s.standing.errands[m.id] ?? 'carouse') ? 'selected' : ''}>${ERRAND_LABEL[e]}</option>`).join('');
      return `<div class="cf-member ${rec.includes(m.id) ? 'is-out' : ''}" data-standing="${esc(m.id)}">
        <label class="cf-member-pick"><input type="checkbox" ${on ? 'checked' : ''} /><span><span class="cf-name">${esc(m.name)}</span><span class="cf-role">${esc(m.role)}${rec.includes(m.id) ? ' · recovering' : ''}</span></span></label>
        <select aria-label="Usual errand for ${esc(m.name)}">${options}</select>
      </div>`;
    }).join('');
  }
  $('standing-list').addEventListener('change', () => {
    if (!state) return;
    const rows = [...root.querySelectorAll<HTMLElement>('#standing-list [data-standing]')];
    const members = rows.filter((r) => r.querySelector<HTMLInputElement>('input')!.checked).map((r) => r.dataset.standing!).slice(0, CAMPAIGN.membersPerNight);
    for (const r of rows) {
      const cb = r.querySelector<HTMLInputElement>('input')!;
      cb.disabled = !cb.checked && members.length >= CAMPAIGN.membersPerNight;
      state.standing.errands[r.dataset.standing!] = r.querySelector<HTMLSelectElement>('select')!.value as Errand;
    }
    state.standing.members = members; saveState(state);
  });

  $('reset').addEventListener('click', () => {
    if (!warband) return;
    if (confirm(`Burn ${warband.name}'s ledger on this device? Every night, charm and rumour goes with it.`)) { resetState(warband.id); select(warband.id); toast('The ledger is ash.'); }
  });

  if (warband) select(warband.id); else showPicker(true);
</script>
