---
import Base from '../../layouts/Base.astro';
import '../../styles/curfew.css';
import { warbands } from '../../data/warbands';
import campaign from '../../data/curfew/campaign.json';
import { base } from '../../lib/site';
import { hasDatabase } from '../../server/db/client';
import { DEV_LOGIN_PASSWORD, env, isAdminEmail } from '../../server/env';
import { getViewer } from '../../server/session';
import PlaceBand from '../../components/PlaceBand.astro';
import { currentLocation, listClaims, loadOwnLedger, todayFor, type Claim, type LedgerView } from '../../server/curfew/service';
import { isDryRun } from '../../server/curfew/dry';
import { DEFAULT_LOCATION, type Location } from '../../curfew/engine';

// The Ledger is personal: rendered on request, never cached.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const ready = hasDatabase();
const viewer = ready ? await getViewer(Astro.request) : null;
// a game master may look at another night; a player always sees tonight
const today = todayFor(Astro.url, viewer);
let view: LedgerView | null = null;
let claims: Claim[] = [];
let trouble = false;
// Where the campaign is colours the page before anyone signs in; without a database it is Mordheim.
let location: Location = DEFAULT_LOCATION;
if (ready) {
  try { location = await currentLocation(today); } catch (e) { console.error('[curfew] location unavailable', e); }
}
// With the Debug strip on, a game master's visit is a dry run: nothing this request computes is saved.
const dry = !!viewer && isDryRun(Astro.request, viewer);
if (viewer) {
  try { [view, claims] = await Promise.all([loadOwnLedger(viewer.id, today, dry ? {} : undefined), listClaims()]); } catch (e) { console.error('[curfew] ledger unavailable', e); trouble = true; }
}
const boot = {
  today, debug: env.CURFEW_DEBUG, dry, viewer: viewer ? { name: viewer.name, admin: isAdminEmail(viewer.email) } : null, view, locationId: location.id,
  claims: claims.map((c) => ({ warbandId: c.warbandId, ownerName: c.ownerName })),
};
---

<Base title={`Curfew — ${location.title}`} description={`${location.tagline} Give your warband its orders at dusk; read what it cost them at dawn.`}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Grenze+Gotisch:wght@700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Barlow+Condensed:wght@600&family=Cinzel:wght@700&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#0e0d0c" />
  </Fragment>

  <main class="curfew cf-wrap" id="main-content" data-base={base} data-start={campaign.start}>
    <header class="cf-top">
      <a class="cf-back" href={`${base}/`}>← Mordheim</a>
      <a class="cf-wordmark" href={`${base}/curfew/`}>Curfew</a>
      <div class="cf-nightline" id="nightline">Night <strong>—</strong></div>
    </header>

    <PlaceBand place={location} />

    {!ready && (
      <section class="cf-section cf-section-first">
        <h1 class="cf-h2">The ledgers are not open</h1>
        <p class="cf-muted">This deployment has no database yet. See the README for the Vercel setup.</p>
      </section>
    )}

    {ready && !viewer && (
      <section class="cf-section cf-section-first" id="signin">
        <h1 class="cf-h2">Whose ledger is this?</h1>
        <p class="cf-muted">{location.tagline} At dusk you give your warband its orders. At midnight {location.settlement} answers. At dawn you read what it cost them. Two minutes a day. {location.settlement.charAt(0).toUpperCase() + location.settlement.slice(1)} takes nothing from those who stay away.</p>
        <p>Sign in, so the ledger is yours from any device and the Town Cryer knows whose night it prints.</p>
        <form class="cf-auth" id="auth-form" data-mode="in" data-invite={env.INVITE_CODE ? 'required' : 'open'} novalidate>
          <div class="cf-auth-tabs" role="tablist" aria-label="Sign in or sign up">
            <button type="button" role="tab" id="tab-in" aria-selected="true" aria-controls="auth-form" data-mode="in">Sign in</button>
            <button type="button" role="tab" id="tab-up" aria-selected="false" aria-controls="auth-form" data-mode="up">First time here</button>
          </div>
          <label class="cf-field cf-field-up" hidden>Your name<input name="name" type="text" autocomplete="name" maxlength="40" placeholder="As the others know you" /></label>
          <label class="cf-field">Email<input name="email" type="email" autocomplete="username" required placeholder="you@example.com" /></label>
          <label class="cf-field cf-field-reset" hidden>Reset word from the game master<input name="word" type="text" autocomplete="off" spellcheck="false" placeholder="ash-bell-crow-7f3" /></label>
          <label class="cf-field cf-field-pw">Password<input name="password" type="password" autocomplete="current-password" required minlength="8" placeholder="At least eight characters" /></label>
          {env.INVITE_CODE && <label class="cf-field cf-field-up" hidden>The word at the gate<input name="inviteCode" type="text" autocomplete="off" placeholder="Ask the game master" /></label>}
          <div class="cf-auth-foot">
            <button type="submit" class="cf-btn" id="auth-submit">Sign in</button>
            <span class="cf-note cf-auth-note" id="auth-note">Signed in once, you stay signed in on this device for a Moon or so.</span>
            <button type="button" class="cf-linkbtn cf-auth-link" id="auth-forgot" data-mode="reset">Forgotten your password?</button>
          </div>
        </form>
        {env.DEV_LOGIN && (
          <form class="cf-devlogin" id="devlogin" data-password={DEV_LOGIN_PASSWORD}>
            <label>Local player <input name="name" type="text" placeholder="Niklas" required maxlength="40" autocomplete="off" /></label>
            <button type="submit" class="cf-btn cf-btn-ghost">Sign in as this player</button>
            <p class="cf-note">Development only: no password, any name, and the same name is the same player. Two names make two players, so both warbands can be tried.</p>
          </form>
        )}
      </section>
    )}

    {viewer && (
      <div class="cf-account" id="account">
        <span class="cf-account-name">Signed in as {viewer.name}</span>
        {isAdminEmail(viewer.email) && <a class="cf-account-link" href={`${base}/admin/`}>The Watch House</a>}
        <button type="button" class="cf-linkbtn" id="signout">Sign out</button>
      </div>
    )}
    {trouble && <p class="cf-empty" style="margin-top:2rem">The ledger could not be read just now. Try again in a moment.</p>}

    <!-- Once a ledger is claimed the picker folds into this one line, so the daily scroll starts at last night. -->
    <div class="cf-identity" id="identity" hidden>
      <h1 class="cf-identity-name" id="identity-name"></h1>
      <span class="cf-identity-meta" id="identity-meta"></span>
    </div>

    <section class="cf-section cf-section-first" id="warband-section" hidden>
      <h1 class="cf-h2">Whose ledger is this?</h1>
      <p class="cf-muted">Take up your warband. One player keeps each ledger; a warband already kept is greyed out.</p>
      <div class="cf-pick" id="warband-pick">
        {warbands.map((wb) => (
          <button type="button" data-warband={wb.id} aria-pressed="false">
            <span class="cf-sigil" aria-hidden="true">{wb.sigil}</span>
            <span>{wb.name}<small>{wb.type}{wb.player ? ` · ${wb.player}` : ''}</small><small class="cf-kept" data-kept></small></span>
          </button>
        ))}
      </div>
    </section>

    <div id="ledger" hidden>
      <!-- 1. Wrap up last night -->
      <section class="cf-section cf-section-first" id="dawn" aria-labelledby="dawn-title">
        <h2 class="cf-h2" id="dawn-title">Last night</h2>
        <div class="cf-panel cf-dawn" id="dawn-report"></div>
      </section>

      <!-- 2. Learn about and plan tonight -->
      <section class="cf-section" id="tonight" aria-labelledby="tonight-title">
        <h2 class="cf-h2" id="tonight-title">Tonight</h2>
        <div class="cf-omen">
          <div class="cf-omen-card-col">
            <div class="cf-card" id="omen-card">
              <div class="cf-card-inner">
                <img class="cf-back-img" src={`${base}/curfew/omens/back.png`} alt="" width="1050" height="1800" />
                <img class="cf-face" id="omen-img" src={`${base}/curfew/omens/back.png`} alt="" width="1050" height="1800" />
              </div>
            </div>
            <ul class="cf-tilts" id="omen-tilts" aria-label="Tonight's odds"></ul>
          </div>
          <div class="cf-omen-text" id="omen-text"></div>
        </div>

        <div class="cf-watch" id="watch">
          <h3 class="cf-h3">Who goes out?</h3>
          <p class="cf-muted">Up to <span id="per-night">{campaign.membersPerNight}</span> a night, and nobody two nights running. The dead and the wounded stay home.</p>
          <p class="cf-muted cf-place-note" id="place-note" hidden></p>
          <div class="cf-watch-list" id="watch-list"></div>
          <div class="cf-orders-given" id="orders-given"></div>
          <details class="cf-details cf-details-quiet">
            <summary>What each errand brings</summary>
            <div class="cf-inner cf-errand-help" id="errand-help"></div>
          </details>
        </div>
      </section>

      <!-- 3. What you carry -->
      <section class="cf-section" id="hand" aria-labelledby="hand-title">
        <h2 class="cf-h2" id="hand-title">The Hand</h2>
        <div class="cf-hand-grid">
          <div>
            <div class="cf-hand" id="hand-list"></div>
            <p class="cf-note" style="margin-top:.8rem">Three charms, one palm. They are spent at the next game whether used or not. <a id="eve-link" href={`${base}/curfew/eve/`}>Lay the table for the Eve of Battle →</a></p>
          </div>
          <div class="cf-meters" id="meters"></div>
        </div>
      </section>

      <!-- 4. The longer memory -->
      <section class="cf-section" id="rumours-section" aria-labelledby="rumours-title">
        <h2 class="cf-h2" id="rumours-title">Rumours</h2>
        <p class="cf-muted">Warm for seven nights, then cold.</p>
        <ul class="cf-rumours" id="rumours"></ul>
      </section>

      <section class="cf-section" id="chronicle-section" aria-labelledby="chronicle-title">
        <h2 class="cf-h2" id="chronicle-title">The Chronicle</h2>
        <p class="cf-muted">What the earlier nights have written.</p>
        <ol class="cf-chron" id="chronicle"></ol>
        <button type="button" class="cf-btn cf-btn-ghost cf-more" id="chron-more" hidden>Older nights</button>
      </section>

      <footer class="cf-foot">
        <span>Nights turn at midnight in {location.settlement} ({campaign.timezone.replace('_', ' ')}). Stay away longer than {campaign.returnAfterNights} nights and {location.settlement} simply waits. The ledger is kept for you; open it from any device.</span>
        <span class="cf-foot-actions">
          <button type="button" class="cf-linkbtn" id="reset">Burn this ledger</button>
          <button type="button" class="cf-linkbtn" id="release">Give up the warband</button>
          <button type="button" class="cf-debug-toggle" id="debug-toggle" aria-pressed="false" title="Step through nights without waiting for midnight" hidden>Debug</button>
        </span>
      </footer>
    </div>
    <div class="cf-debug" id="debug-bar" hidden></div>
  </main>
  <div class="cf-toast" id="toast" hidden role="status"></div>
  <script is:inline type="application/json" id="boot" set:html={JSON.stringify(boot).replace(/</g, '\\u003c')} />
</Base>

<script>
  import { createAuthClient } from 'better-auth/client';
  import { warbands } from '../../data/warbands';
  import {
    CAMPAIGN, ERRANDS, ERRAND_LABEL, TOKEN_TYPES, HAND_SIZE, availability, moonForNight, omenForNight, tiltFor, titleFor, nextTitle, tokenById, dateForNight, statEdge, ERRAND_STATS, STAT_LABEL,
    blurbFor, isErrandAt, locationById, moonBoostAt, unavailableReason,
    type Errand, type MemberLike, type NightResult, type Order, type TokenOffer,
  } from '../../curfew/engine';
  import { keptMembers, keptReason, lastGivenOrders, restingMembers, standingOrders, type WarbandState } from '../../curfew/ledger';
  import { sealSvg } from '../../curfew/glyphs';
  import { carryDate, clearSandbox, debugEnabled, loadSandbox, renderDebugBar, saveSandbox, setDebug } from '../../curfew/debug';
  import { formatImperial, imperialForDate } from '../../lib/calendar';

  interface View { warbandId: string; state: WarbandState; today: number; recovering: string[]; fresh: boolean; locationId: string; dry?: boolean; wouldPrint?: { headline: string }[] }
  interface Boot { today: number; debug: boolean; dry: boolean; viewer: { name: string; admin: boolean } | null; view: View | null; locationId: string; claims: { warbandId: string; ownerName: string }[] }

  document.body.classList.add('curfew-body');
  const root = document.getElementById('main-content')!;
  const base = root.dataset.base ?? '';
  const boot: Boot = JSON.parse(document.getElementById('boot')!.textContent || '{}');
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const authClient = createAuthClient({ baseURL: location.origin, basePath: `${base}/api/auth` });

  const today = boot.today;
  let view: View | null = boot.view;
  let warband = view ? warbands.find((w) => w.id === view!.warbandId) ?? null : null;
  let state: WarbandState | null = view?.state ?? null;
  // Where the campaign is tonight: which errands are open, whose words the page uses.
  let place = locationById(view?.locationId ?? boot.locationId);
  const Settlement = () => place.settlement.charAt(0).toUpperCase() + place.settlement.slice(1);
  let chronShown = 6;

  function toast(text: string) {
    const el = $('toast'); el.textContent = text; el.hidden = false;
    clearTimeout((el as any)._t); (el as any)._t = setTimeout(() => (el.hidden = true), 3600);
  }

  // ── the server ──
  // A dry run (the Debug strip on, for a game master): the server saves nothing, and the sandbox it answers with is sent back with the next request.
  const dryRun = boot.dry && debugEnabled();
  const realLastResolved = boot.view?.state.lastResolved ?? 0;
  /** One errand to the API. Every answer is the whole ledger again, so the page re-renders from it. */
  async function api(action: string, body: Record<string, unknown> = {}): Promise<View | null> {
    const url = new URL(`${base}/api/curfew/${action}`, location.href);
    const date = new URLSearchParams(location.search).get('date');
    if (date) url.searchParams.set('date', date);
    if (dryRun && warband) body = { ...body, dry: { base: loadSandbox(warband.id)?.state } };
    const res = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body), credentials: 'same-origin' });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error ?? 'The city did not answer. Try again.');
    const next: View | null = data.view ?? null;
    if (dryRun && next?.dry) saveSandbox(next.warbandId, next.state, realLastResolved);
    return next;
  }
  function applyView(next: View | null) {
    view = next;
    state = next?.state ?? null;
    warband = next ? warbands.find((w) => w.id === next.warbandId) ?? null : null;
    if (next) place = locationById(next.locationId);
    if (view && warband) { showPicker(false); $('ledger').hidden = false; renderAll(view.fresh); }
    else { $('ledger').hidden = true; showPicker(true); }
    renderDebug();
  }
  /** Run an errand and re-render; a refusal becomes a toast and the page stays as the server has it. */
  async function act(action: string, body: Record<string, unknown>, done?: (v: View) => void): Promise<boolean> {
    try {
      const next = await api(action, body);
      applyView(next);
      if (next && done) done(next);
      return true;
    } catch (e) {
      toast((e as Error).message);
      if (view) renderAll(false);
      return false;
    }
  }

  function recovering(): string[] { return view?.recovering ?? []; }
  function resting(): string[] { return state ? restingMembers(state, today) : []; }
  function kept(): string[] { return state ? keptMembers(state, today) : []; }
  function memberName(id: string) { return warband?.members.find((m) => m.id === id)?.name ?? id; }
  function firstName(id: string) { return memberName(id).split(' ')[0]; }
  function prettyDate(night: number) {
    const d = new Date(dateForNight(night) + 'T12:00:00Z');
    return d.toLocaleDateString(undefined, { day: 'numeric', month: 'short', timeZone: 'UTC' });
  }
  /** The night's date as the Empire writes it, counted on from the first game. */
  const imperialDate = (night: number, style: 'long' | 'short' | 'day' = 'long') => formatImperial(imperialForDate(dateForNight(night)), style);

  // ── sign in / out ──
  const authForm = document.getElementById('auth-form') as HTMLFormElement | null;
  if (authForm) {
    type Mode = 'in' | 'up' | 'reset';
    const NOTE: Record<Mode, string> = {
      in: 'Signed in once, you stay signed in on this device for a Moon or so.',
      up: 'No emails are sent; the address is only your name at the gate. Keep the password somewhere; the game master can issue a reset word if it is lost.',
      reset: 'Ask the game master for a reset word, then give it here with a new password. Every device is signed out.',
    };
    const LABEL: Record<Mode, string> = { in: 'Sign in', up: 'Take the oath', reset: 'Set the new password' };
    const setMode = (mode: Mode) => {
      authForm.dataset.mode = mode;
      authForm.querySelectorAll<HTMLElement>('.cf-field-up').forEach((f) => { f.hidden = mode !== 'up'; });
      authForm.querySelectorAll<HTMLElement>('.cf-field-reset').forEach((f) => { f.hidden = mode !== 'reset'; });
      authForm.querySelectorAll<HTMLButtonElement>('[role=tab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.mode === mode)));
      const pwField = authForm.querySelector<HTMLElement>('.cf-field-pw')!, pw = pwField.querySelector('input')!;
      pw.autocomplete = mode === 'in' ? 'current-password' : 'new-password';
      pwField.firstChild!.textContent = mode === 'reset' ? 'New password' : 'Password';
      $('auth-submit').textContent = LABEL[mode];
      $('auth-note').textContent = NOTE[mode];
      $('auth-forgot').hidden = mode !== 'in';
    };
    authForm.querySelectorAll<HTMLButtonElement>('[role=tab], #auth-forgot').forEach((t) => t.addEventListener('click', () => setMode(t.dataset.mode as Mode)));
    setMode('in');
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(authForm);
      const email = String(data.get('email') ?? '').trim(), password = String(data.get('password') ?? '');
      const mode = authForm.dataset.mode as Mode;
      if (!email || !password) { toast('Email and password, both.'); return; }
      if (password.length < 8) { toast('The password needs at least eight characters.'); return; }
      const button = $<HTMLButtonElement>('auth-submit');
      button.disabled = true;
      try {
        if (mode === 'reset') {
          const word = String(data.get('word') ?? '').trim();
          if (!word) throw new Error('The reset word, as the game master gave it to you.');
          const res = await fetch(new URL(`${base}/api/account/reset`, location.href), { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email, word, newPassword: password }), credentials: 'same-origin' });
          const out = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(out.error ?? 'The city did not answer. Try again.');
          const { error } = await authClient.signIn.email({ email, password });
          if (error) throw new Error(error.message ?? 'The password is set, but the gate did not open. Sign in again.');
        } else if (mode === 'up') {
          const name = String(data.get('name') ?? '').trim();
          if (!name) throw new Error('Tell us your name.');
          const inviteCode = String(data.get('inviteCode') ?? '').trim();
          const { error } = await authClient.signUp.email({ email, password, name, ...(inviteCode ? { inviteCode } : {}) } as never);
          if (error) throw new Error(error.message ?? 'The gate did not open.');
        } else {
          const { error } = await authClient.signIn.email({ email, password });
          if (error) throw new Error(error.message ?? 'The gate did not open.');
        }
        location.href = location.pathname + location.search;
      } catch (err) {
        button.disabled = false;
        toast((err as Error).message);
      }
    });
  }
  document.getElementById('signout')?.addEventListener('click', async () => { await authClient.signOut(); location.href = location.pathname; });
  // local development: a name becomes a player, created on first use
  document.getElementById('devlogin')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const name = String(new FormData(form).get('name') ?? '').trim();
    if (!name) return;
    const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'player';
    const email = `${slug}@curfew.local`, password = form.dataset.password!;
    form.querySelector('button')!.disabled = true;
    let { error } = await authClient.signIn.email({ email, password });
    if (error) ({ error } = await authClient.signUp.email({ email, password, name }));
    if (error) { form.querySelector('button')!.disabled = false; toast(error.message ?? 'The gate did not open.'); return; }
    location.href = location.pathname + location.search;
  });

  // ── warband ──
  function showPicker(show: boolean) {
    $('warband-section').hidden = !show || !boot.viewer;
    $('identity').hidden = show || !warband;
    if (warband) {
      $('identity-name').textContent = warband.name;
      $('identity-meta').textContent = warband.type + (warband.player ? ` · ${warband.player}` : '');
    }
    if (show) {
      for (const b of root.querySelectorAll<HTMLButtonElement>('#warband-pick button')) {
        const claim = boot.claims.find((c) => c.warbandId === b.dataset.warband);
        b.disabled = !!claim;
        b.querySelector<HTMLElement>('[data-kept]')!.textContent = claim ? `Kept by ${claim.ownerName}` : '';
      }
    }
  }
  root.querySelector('#warband-pick')!.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-warband]');
    if (!b || b.disabled) return;
    b.setAttribute('aria-pressed', 'true');
    const ok = await act('claim', { warbandId: b.dataset.warband }, (v) => { boot.claims.push({ warbandId: v.warbandId, ownerName: boot.viewer?.name ?? 'you' }); });
    if (!ok) b.setAttribute('aria-pressed', 'false');
  });

  // ── render ──
  function renderAll(fresh = false) {
    if (!warband || !state) return;
    renderNightline(); renderDawn(fresh); renderOmen(); renderWatch(); renderHand(); renderRumours(); renderChronicle();
  }
  function renderNightline() {
    const moon = moonForNight(today);
    const mark = `<img class="cf-place-mark" src="${base}/curfew/places/${place.id}-mark.jpg" alt="" width="96" height="96" />`;
    $('nightline').innerHTML = today < 1
      ? `${mark}${esc(Settlement())} sleeps until <strong>${esc(prettyDate(1))}</strong>`
      : `${mark}Night <strong>${today}</strong> · ${esc(place.name)} · ${esc(imperialDate(today, 'day'))} · ${esc(moon.name)}`;
    renderPlaceBand();
  }
  /** The band was rendered on the server for tonight's place; keep it true if the place changes under us. */
  function renderPlaceBand() {
    const band = document.getElementById('place-band');
    if (!band || band.dataset.place === place.id) return;
    band.dataset.place = place.id;
    const art = $<HTMLImageElement>('place-art');
    art.src = `${base}/curfew/places/${place.id}-band.jpg`;
    art.style.objectPosition = place.art?.focus ?? '50% 50%';
    $('place-name').textContent = place.name;
    $('place-sub').textContent = place.title;
  }

  // 1. Last night
  function nightParts(n: NightResult, ink: boolean, headingTag: 'h3' | 'h4' = 'h3', card = '') {
    const c = n.crossroads, waiting = !!c && !c.decided;
    const chunks: string[] = [];
    const para = (text: string) => chunks.push(`<p class="${ink ? 'cf-ink' : ''}" style="animation-delay:${0.15 + chunks.length * 0.45}s">${esc(text)}</p>`);
    for (const r of n.results) {
      para(r.prose);
      // the report reaches the crossroads right after that member's own night; the choice is made there, before reading on
      if (c?.memberId === r.memberId) {
        para(c.setup);
        if (c.decided) para(c.decided.outcome);
        else if (card) chunks.push(`<div class="${ink ? 'cf-ink' : ''}" style="animation-delay:${0.15 + chunks.length * 0.45}s">${card}</div>`);
      }
    }
    if (!waiting) { para(n.detail); if (n.closer) para(n.closer); }
    let paras = chunks.join('');
    if (c?.decided) paras += `<p class="cf-chose"><span class="cf-chose-label">What ${esc(firstName(c.memberId))} did</span>${esc(c.decided.label)}${c.decided.defaulted ? '<small>Nobody was asked. The character decided.</small>' : ''}</p>`;
    const items = [...n.ledger, ...(c?.decided?.ledger ?? [])];
    const ledger = waiting
      ? `<div class="cf-ledger cf-ledger-waiting">The ledger waits on ${esc(firstName(c!.memberId))}.</div>`
      : items.length ? `<div class="cf-ledger">Ledger: ${items.map((l) => `<strong>${esc(l)}</strong>`).join('<span class="cf-sep"> · </span>')}</div>` : '';
    return { head: `<${headingTag} class="cf-dawn-head">${esc(n.header)}</${headingTag}><span class="cf-dawn-date">${esc(imperialDate(n.night))}</span>`, paras, ledger, waiting };
  }
  function nightHtml(n: NightResult, ink: boolean, headingTag: 'h3' | 'h4' = 'h3') {
    const part = nightParts(n, ink, headingTag);
    return part.head + part.paras + part.ledger;
  }
  function renderDawn(fresh: boolean) {
    const el = $('dawn-report');
    const last = state!.nights.at(-1);
    if (!last) {
      el.innerHTML = `<h3 class="cf-dawn-head">No dawn yet.</h3><p>Your first night is below. Give the orders; the city answers at midnight, and tomorrow the report is written here.</p>`;
      return;
    }
    // The prose leads; the ledger line, what came home, and any decision follow. On a wide screen they sit beside it.
    const waiting = !!last.crossroads && !last.crossroads.decided;
    const part = nightParts(last, fresh && !reduced, 'h3', waiting ? crossroadsHtml(last) : '');
    const side = part.ledger + (part.waiting ? '' : gainsHtml(last)) || '<p class="cf-dawn-nothing">Nothing to enter in the ledger.</p>';
    const decisions = state!.offers.map((offer) => offerHtml(offer, last)).join('');
    el.innerHTML = `<div class="cf-dawn-main">${part.head}${part.paras}</div><div class="cf-dawn-side">${side}</div>${decisions ? `<div class="cf-dawn-foot">${decisions}</div>` : ''}`;
  }
  /** What the night brought home, beyond the ledger line: charms, rumours, and names earned. */
  function gainsHtml(last: NightResult) {
    const s = state!;
    const pending = new Set(s.offers.map((o) => o.incoming));
    const charms = last.results.filter((r) => r.token && !pending.has(r.token.id));
    const rumours = last.results.filter((r) => r.rumour);
    const names = s.headlines.filter((h) => h.night === last.night);
    if (!charms.length && !rumours.length && !names.length) return '';
    let html = '<div class="cf-gains"><h4 class="cf-gains-title">Brought home</h4>';
    if (charms.length) html += `<div class="cf-hand cf-hand-mini">${charms.map((r) => tokenHtml(r.token!.id, 'div', `title="Found by ${esc(memberName(r.memberId))}"`)).join('')}</div>`;
    for (const r of rumours) html += `<p class="cf-gain-rumour">“${esc(r.rumour!)}”<small>${esc(firstName(r.memberId))} heard it. Warm for ${CAMPAIGN.rumourWarmNights} nights.</small></p>`;
    for (const h of names) html += `<p class="cf-gain-name">${esc(h.text)}</p>`;
    return html + '</div>';
  }
  // ── the Crossroads: what one member did last night is decided here, at dawn ──
  // The road the player has marked, per night, before confirming. Never saved: a reload clears it.
  const roadPicks = new Map<number, string>();
  function crossroadsHtml(n: NightResult) {
    const c = n.crossroads!, first = firstName(c.memberId);
    const pick = roadPicks.get(n.night);
    const road = c.options.find((o) => o.id === pick);
    const footer = road
      ? `<div class="cf-offer-confirm" role="group" aria-label="Confirm the road">
          <p><b>${esc(road.label)}</b> That is what ${esc(first)} did. Nothing else was.</p>
          <div class="cf-offer-actions"><button type="button" class="cf-btn cf-btn-blood" data-road-confirm="${esc(road.id)}">So it was</button><button type="button" class="cf-btn cf-btn-ghost" data-road-unpick>Not yet</button></div>
        </div>`
      : `<p class="cf-note cf-offer-hint">Choose for ${esc(first)}. Nothing is decided until you confirm. Left until midnight, ${esc(first)} decides alone.</p>`;
    return `<div class="cf-offer cf-crossroads" data-night="${n.night}">
      <h4 class="cf-offer-title">What ${esc(first)} did</h4>
      <div class="cf-roads" role="group" aria-label="The roads">${c.options.map((o) => `<button type="button" class="cf-road" data-road="${esc(o.id)}" aria-pressed="${pick === o.id}">${esc(o.label)}</button>`).join('')}</div>
      ${footer}
    </div>`;
  }
  $('dawn-report').addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const box = target.closest<HTMLElement>('.cf-crossroads'); if (!box || !state) return;
    const night = Number(box.dataset.night);
    const n = state.nights.find((x) => x.night === night);
    if (!n?.crossroads || n.crossroads.decided) return;
    const pickBtn = target.closest<HTMLElement>('[data-road]');
    const confirmBtn = target.closest<HTMLElement>('[data-road-confirm]');
    const unpick = target.closest<HTMLElement>('[data-road-unpick]');
    if (pickBtn) {
      const id = pickBtn.dataset.road!;
      if (roadPicks.get(night) === id) roadPicks.delete(night); else roadPicks.set(night, id);
      box.outerHTML = crossroadsHtml(n);
      const fresh = $('dawn-report').querySelector<HTMLElement>('.cf-crossroads');
      (fresh?.querySelector<HTMLElement>('[data-road-confirm]') ?? fresh?.querySelector<HTMLElement>(`[data-road="${id}"]`))?.focus();
    } else if (unpick) {
      roadPicks.delete(night);
      box.outerHTML = crossroadsHtml(n);
    } else if (confirmBtn) {
      const roadId = confirmBtn.dataset.roadConfirm!;
      roadPicks.delete(night);
      await act('decide', { night, roadId }, () => toast('So it was. The ledger is written.'));
    }
  });

  // Which charm the player has marked to keep, per offer, before confirming. Never saved: a reload clears it.
  const offerPicks = new Map<string, 'incoming' | 'held'>();
  const offerKey = (o: TokenOffer) => `${o.night}:${o.incoming}:${o.held}`;
  function offerHtml(offer: TokenOffer, last: NightResult) {
    const inc = tokenById(offer.incoming), held = tokenById(offer.held);
    const who = last.results.find((r) => r.token?.id === offer.incoming)?.memberId;
    const pick = offerPicks.get(offerKey(offer));
    const keep = pick === 'incoming' ? inc : pick === 'held' ? held : null;
    const lose = pick === 'incoming' ? held : pick === 'held' ? inc : null;
    const footer = keep && lose
      ? `<div class="cf-offer-confirm" role="group" aria-label="Confirm your choice">
          <p><b>${esc(keep.name)}</b> stays in the Hand. <b>${esc(lose.name)}</b> goes in the river, and does not come back.</p>
          <div class="cf-offer-actions"><button type="button" class="cf-btn cf-btn-blood" data-confirm="${pick}">Let ${esc(lose.name)} go</button><button type="button" class="cf-btn cf-btn-ghost" data-unpick>Not yet</button></div>
        </div>`
      : `<p class="cf-note cf-offer-hint">Choose the charm to keep. Nothing is decided until you confirm.</p>`;
    return `<div class="cf-offer" data-night="${offer.night}" data-incoming="${esc(offer.incoming)}" data-held="${esc(offer.held)}">
      <h4 class="cf-offer-title">The Hand is full</h4>
      <p>${who ? esc(firstName(who)) + ' brought back' : 'The night brought'} <b>${esc(inc.name)}</b>. Keep it, or keep <b>${esc(held.name)}</b>. Over a month the Hand does not grow; it gets curated.</p>
      <div class="cf-hand" role="group" aria-label="Charm to keep">
        ${tokenHtml(inc.id, 'button', `data-keep="incoming" aria-pressed="${pick === 'incoming'}" aria-label="Keep ${esc(inc.name)}"`)}
        ${tokenHtml(held.id, 'button', `data-keep="held" aria-pressed="${pick === 'held'}" aria-label="Keep ${esc(held.name)}"`)}
      </div>
      ${footer}
    </div>`;
  }
  function tokenHtml(id: string, tag: 'div' | 'button' = 'div', attrs = '') {
    const t = tokenById(id); const type = TOKEN_TYPES[t.type];
    const typeAttr = tag === 'button' ? ' type="button"' : '';
    return `<${tag}${typeAttr} class="cf-token" ${attrs}><span class="cf-cord" aria-hidden="true"></span><span class="cf-seal" style="--seal:${type.seal}">${sealSvg(t.type)}</span><span class="cf-type">${esc(type.name)}</span><span class="cf-token-name">${esc(t.name)}</span><span class="cf-effect">${esc(t.effect)}</span></${tag}>`;
  }
  $('dawn-report').addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const box = target.closest<HTMLElement>('.cf-offer'); if (!box || !state) return;
    const offer = state.offers.find((o) => String(o.night) === box.dataset.night && o.incoming === box.dataset.incoming && o.held === box.dataset.held);
    if (!offer) return;
    const last = state.nights.at(-1)!;
    const pickBtn = target.closest<HTMLElement>('[data-keep]');
    const confirmBtn = target.closest<HTMLElement>('[data-confirm]');
    const unpick = target.closest<HTMLElement>('[data-unpick]');
    if (pickBtn) {
      // Step one: mark the charm to keep. Tapping it again unmarks it.
      const choice = pickBtn.dataset.keep as 'incoming' | 'held';
      if (offerPicks.get(offerKey(offer)) === choice) offerPicks.delete(offerKey(offer)); else offerPicks.set(offerKey(offer), choice);
      box.outerHTML = offerHtml(offer, last);
      const fresh = $('dawn-report').querySelector<HTMLElement>(`.cf-offer[data-incoming="${offer.incoming}"]`);
      (fresh?.querySelector<HTMLElement>('[data-confirm]') ?? fresh?.querySelector<HTMLElement>(`[data-keep="${choice}"]`))?.focus();
    } else if (unpick) {
      offerPicks.delete(offerKey(offer));
      box.outerHTML = offerHtml(offer, last);
    } else if (confirmBtn) {
      // Step two: the decision.
      const choice = confirmBtn.dataset.confirm as 'incoming' | 'held';
      offerPicks.delete(offerKey(offer));
      const gone = choice === 'incoming' ? tokenById(offer.held).name : tokenById(offer.incoming).name;
      await act('offer', { offer, keep: choice }, () => toast(`${gone} goes in the river.`));
    }
  });

  // 2. Tonight
  function renderOmen() {
    const omen = omenForNight(today), moon = moonForNight(today);
    const img = $<HTMLImageElement>('omen-img');
    img.src = `${base}${omen.image}`; img.alt = `${omen.title}. ${omen.reading}`;
    const tilts = place.errands.map((e) => ({ e, t: tiltFor(e, omen, moon, place) })).filter((x) => x.t !== 0);
    $('omen-tilts').innerHTML = tilts.length
      ? tilts.map(({ e, t }) => `<li class="cf-tilt ${t > 0 ? 'up' : 'down'}"><span>${esc(ERRAND_LABEL[e])}</span><span aria-label="${t > 0 ? 'favoured' : 'perilous'} ${Math.abs(t)}">${t > 0 ? '▲'.repeat(t) : '▼'.repeat(-t)}</span></li>`).join('')
      : '<li class="cf-tilt flat">A flat night</li>';
    const boost = moonBoostAt(moon, place);
    const favours = boost
      ? `This Moon favours <b>${esc(ERRAND_LABEL[boost])}</b>${boost !== moon.boost ? ` here, where there is no ${esc(ERRAND_LABEL[moon.boost].toLowerCase())} to be had,` : ''} and colours everything else.`
      : `This Moon favours <b>${esc(ERRAND_LABEL[moon.boost])}</b>, which ${esc(place.name)} has none of. It colours everything else.`;
    $('omen-text').innerHTML = `
      <div class="cf-moon"><h3 class="cf-h3"><span class="cf-week">This week</span>${esc(moon.name)}</h3><p class="cf-reading">${esc(moon.reading)}</p><p class="cf-note">${favours}</p></div>`;
    const card = $('omen-card'), tiltList = $('omen-tilts');
    [...tiltList.children].forEach((li, i) => (li as HTMLElement).style.setProperty('--d', `${0.12 * i}s`));
    const key = `curfew:revealed:${warband!.id}:${today}`;
    let seen = false; try { seen = sessionStorage.getItem(key) === '1'; } catch {}
    revealObserver?.disconnect();
    card.classList.remove('is-revealing');
    const done = () => { card.classList.add('is-flipped'); card.classList.remove('is-revealing'); setTimeout(() => tiltList.classList.add('is-shown'), 150); try { sessionStorage.setItem(key, '1'); } catch {} };
    if (seen || !('IntersectionObserver' in window)) { card.classList.add('is-flipped'); tiltList.classList.add('is-shown'); return; }
    // Face down until the card scrolls into view; then it turns, and the odds fade in after it.
    card.classList.remove('is-flipped'); tiltList.classList.remove('is-shown');
    // "In view" means as much of the card as this screen can show: a short phone screen never shows 90% of it.
    const cardHeight = card.getBoundingClientRect().height || 500;
    const threshold = Math.min(0.9, Math.max(0.35, (window.innerHeight - 96) / cardHeight));
    revealObserver = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      revealObserver?.disconnect();
      if (reduced) { done(); return; } // a plain crossfade, from the stylesheet
      setTimeout(() => {
        card.classList.add('is-revealing');
        const inner = card.querySelector('.cf-card-inner')!;
        const finish = () => { clearTimeout(guard); done(); };
        inner.addEventListener('animationend', finish, { once: true });
        const guard = setTimeout(finish, 1900); // if the animation never reports back, still land face up
      }, 250);
    }, { threshold });
    revealObserver.observe(card);
  }
  let revealObserver: IntersectionObserver | null = null;

  function renderWatch() {
    const w = warband!, s = state!;
    const rec = recovering();
    const av = availability(w, rec, resting(), kept());
    const given = s.orders[today] ?? [];
    const standing = given.length ? [] : standingOrders(s, w, rec, today, place);
    const shown = given.length ? given : standing;
    // the place's errands first; the ones it has none of stay in the list, greyed, so the player sees what is missing
    const open = ERRANDS.filter((e) => isErrandAt(e, place)), shut = ERRANDS.filter((e) => !isErrandAt(e, place));
    const options = (m: MemberLike, sel?: Errand) => `<option value="" ${sel ? '' : 'selected'}>Stays home</option>`
      + open.map((e) => `<option value="${e}" ${e === sel ? 'selected' : ''}>${ERRAND_LABEL[e]}${arrows(statEdge(w, m, e))}</option>`).join('')
      + shut.map((e) => `<option value="${e}" disabled class="cf-shut">${ERRAND_LABEL[e]} — not in ${esc(place.name)}</option>`).join('');
    const note = $('place-note');
    note.hidden = !place.watchNote; note.textContent = place.watchNote;
    $('watch-list').innerHTML = w.members.map((m) => {
      const a = av.find((x) => x.memberId === m.id)!;
      const order = shown.find((o) => o.memberId === m.id);
      const ep = s.epithets[m.id] ? ` <span class="cf-epithet">${esc(m.name.split(' ')[0])} ${esc(s.epithets[m.id])}</span>` : '';
      const who = `<span class="cf-who"><span class="cf-name">${esc(m.name)}</span>${ep}<span class="cf-role">${esc(m.role)}</span></span>`;
      if (!a.available) {
        const status = a.reason === 'dead'
          ? '<span class="cf-status dead">Dead</span>'
          : a.reason === 'resting'
          ? '<span class="cf-status resting" title="Went out last night. Nobody is sent two nights running.">Resting</span>'
          : a.reason === 'kept'
          ? `<span class="cf-status kept" title="${esc(keptReason(s, today, m.id) ?? 'Kept home by what happened last night.')}">Kept home<small>${esc(keptReason(s, today, m.id) ?? '')}</small></span>`
          : `<span class="cf-status-wrap"><span class="cf-status">Recovering</span><button type="button" class="cf-btn cf-btn-ghost cf-heal" data-heal="${esc(m.id)}">Back on their feet</button></span>`;
        return `<div class="cf-member is-out">${who}${status}</div>`;
      }
      return `<div class="cf-member ${order ? 'is-chosen' : ''}" data-member="${esc(m.id)}">${who}<span class="cf-choice">${edgeChip(m, order?.errand)}<select aria-label="Tonight, ${esc(m.name)}">${options(m, order?.errand)}</select></span></div>`;
    }).join('');
    $('errand-help').innerHTML = [...open, ...shut].map((e) => isErrandAt(e, place)
      ? `<div><b>${ERRAND_LABEL[e]}</b>${esc(blurbFor(e, place))} <span class="cf-leans">Leans on ${ERRAND_STATS[e].join(' and ')}.</span></div>`
      : `<div class="cf-shut"><b>${ERRAND_LABEL[e]}</b><span class="cf-shut-tag">Not in ${esc(place.name)}</span>${esc(unavailableReason(e, place))}</div>`).join('')
      + `<p class="cf-edge-note">A warrior who is the warband's best hand for an errand, by those characteristics, gets an edge: <span class="cf-edge is-on">▲</span> a point on the odds, <span class="cf-edge is-on">▲▲</span> two when they also stand well above the band's usual. It is measured within your own warband, so no band is favoured over another.</p>`;
    limitSelects(); renderOrdersLine();
  }
  const arrows = (edge: number) => edge > 0 ? ` ${'▲'.repeat(edge)}` : '';
  /** A discreet chip beside the control: the characteristics tonight's errand leans on, and whether this warrior brings an edge to it. */
  function edgeChip(m: MemberLike, errand?: Errand): string {
    if (!errand || !m.stats) return '<span class="cf-edge" aria-hidden="true"></span>';
    const w = warband!, edge = statEdge(w, m, errand), stats = ERRAND_STATS[errand];
    const names = stats.map((k) => STAT_LABEL[k]).join(' and ');
    const title = edge
      ? `${ERRAND_LABEL[errand]} leans on ${names}. ${m.name.split(' ')[0]} is the warband's best hand for it: ${edge === 2 ? 'two points' : 'a point'} on the odds.`
      : `${ERRAND_LABEL[errand]} leans on ${names}. ${m.name.split(' ')[0]} is not the warband's best hand for it.`;
    return `<span class="cf-edge ${edge ? 'is-on' : ''}" title="${esc(title)}"><span class="cf-edge-stats">${stats.join('·')}</span>${edge ? `<span class="cf-edge-mark">${'▲'.repeat(edge)}</span>` : ''}<span class="cf-sr">${esc(title)}</span></span>`;
  }
  function chosenOrders(): Order[] {
    return [...root.querySelectorAll<HTMLElement>('#watch-list .cf-member[data-member]')]
      .map((row) => ({ memberId: row.dataset.member!, errand: row.querySelector<HTMLSelectElement>('select')!.value as Errand | '' }))
      .filter((o): o is Order => o.errand !== '');
  }
  function describe(orders: Order[]) { return orders.map((o) => `${esc(firstName(o.memberId))} will ${ERRAND_LABEL[o.errand].toLowerCase()}`).join('; '); }
  const STANDING_NOTE = '<p class="cf-orders-note">Orders stand until you change them. On nights you do not look in, the same members go out at half yield, resting every other night.</p>';
  function renderOrdersLine() {
    const s = state!, el = $('orders-given');
    if (today < 1) { el.innerHTML = `<p>The first night is ${esc(prettyDate(1))}.</p>`; return; }
    const given = s.orders[today];
    if (given?.length) { el.innerHTML = `<p><b>Orders given.</b> ${describe(given)}. ${esc(Settlement())} answers at midnight.</p>${STANDING_NOTE}`; return; }
    if (given && !given.length) { el.innerHTML = `<p><b>Nobody goes out.</b> The door stays barred tonight.</p>${STANDING_NOTE}`; return; }
    const standing = standingOrders(s, warband!, recovering(), today, place);
    const last = lastGivenOrders(s, today);
    if (!standing.length) {
      const rest = resting().map(firstName);
      el.innerHTML = rest.length
        ? `<p><b>Nobody goes out tonight</b> unless you send someone. ${esc(rest.join(' and '))} went out last night and ${rest.length > 1 ? 'are' : 'is'} resting.</p>${STANDING_NOTE}`
        : `<p>Nobody is fit to go out. Mark someone back on their feet.</p>`;
      return;
    }
    el.innerHTML = `<p><b>Standing orders${last ? ` from night ${last.night}` : ''}.</b> ${describe(standing)}, at half yield, unless you change them. <button type="button" class="cf-linkbtn cf-inline" id="keep-standing">Send them in full tonight</button></p>${STANDING_NOTE}`;
  }
  function limitSelects() {
    const n = chosenOrders().length, max = CAMPAIGN.membersPerNight;
    for (const row of root.querySelectorAll<HTMLElement>('#watch-list .cf-member[data-member]')) {
      const sel = row.querySelector<HTMLSelectElement>('select')!;
      const out = sel.value !== '';
      row.classList.toggle('is-chosen', out);
      sel.disabled = !out && n >= max;
      sel.title = sel.disabled ? `Only ${max} go out a night. Send someone home first.` : '';
      const m = warband?.members.find((x) => x.id === row.dataset.member);
      const chip = row.querySelector('.cf-edge');
      if (m && chip) chip.outerHTML = edgeChip(m, (sel.value || undefined) as Errand | undefined);
    }
  }
  $('watch-list').addEventListener('change', async (e) => {
    if (!state || today < 1) return;
    const sel = e.target as HTMLSelectElement;
    const orders = chosenOrders();
    if (orders.length > CAMPAIGN.membersPerNight) {
      sel.value = ''; limitSelects();
      toast(`Only ${CAMPAIGN.membersPerNight} go out a night. Send someone home first.`);
      return;
    }
    limitSelects();
    await act('orders', { orders }, () => toast(orders.length ? `${describe(orders).replace(/&#39;/g, "'")}. ${Settlement()} answers at midnight.` : 'Nobody goes out. The door stays barred tonight.'));
  });
  $('orders-given').addEventListener('click', async (e) => {
    if (!(e.target as HTMLElement).closest('#keep-standing') || !state) return;
    const orders = standingOrders(state, warband!, recovering(), today, place).map((o) => ({ memberId: o.memberId, errand: o.errand }));
    await act('orders', { orders }, () => toast(`Orders given in full. ${Settlement()} answers at midnight.`));
  });
  $('watch-list').addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-heal]'); if (!b || !state) return;
    const id = b.dataset.heal!;
    await act('heal', { memberId: id }, () => toast(`${memberName(id)} is back on their feet.`));
  });

  // 3. The Hand
  function renderHand() {
    const s = state!;
    const slots = s.hand.slice().sort((a, b) => a.earnedNight - b.earnedNight).map((h) => tokenHtml(h.id));
    while (slots.length < HAND_SIZE) slots.push('<div class="cf-token is-empty"><span class="cf-cord" aria-hidden="true"></span><span class="cf-seal cf-seal-empty" aria-hidden="true"></span><span class="cf-effect">an empty palm</span></div>');
    $('hand-list').innerHTML = slots.join('');
    const title = titleFor(s.renown), next = nextTitle(s.renown);
    $('meters').innerHTML = `
      <div class="cf-meter"><div class="cf-meter-label"><span>Favour</span><strong>${s.favour}<small> / 100</small></strong></div><div class="cf-bar" role="img" aria-label="Favour ${s.favour} of 100, soft cap ${CAMPAIGN.favourSoftCap}"><span style="transform:scaleX(${s.favour / 100})"></span><i class="cf-cap" style="left:${CAMPAIGN.favourSoftCap}%"></i></div><div class="cf-note">${esc(Settlement())} forgets quickly. Past ${CAMPAIGN.favourSoftCap} the surplus becomes a name. Spend it at the Eve.</div></div>
      <div class="cf-stats">
        <div class="cf-stat"><span>Shards</span><b class="wyrd">${s.shards}</b><small>${s.shards >= 5 ? 'Five make a Market chit at Trade' : 'Never rot'}</small></div>
        <div class="cf-stat"><span>Renown</span><b>${s.renown}</b><small>${next ? `${esc(next.title)} at ${next.renown}` : 'A name that will keep'}</small></div>
      </div>
      <div class="cf-title-line">${esc(warband!.name)} are called <b>${esc(title)}</b>${place.kind === 'village' ? ` in ${esc(place.name)}` : ''}.</div>`;
  }

  // 4. Memory
  function renderRumours() {
    const list = state!.rumours.slice().reverse();
    $('rumours').innerHTML = list.length ? list.map((r) => `<li>${esc(r.text)}<small>night ${r.night}</small></li>`).join('') : '<li class="cf-muted">Nobody has heard anything worth repeating. Send someone to listen.</li>';
  }
  function renderChronicle() {
    // The newest night is already open above as Last night; the Chronicle starts with the one before.
    const nights = state!.nights.slice(0, -1).reverse();
    $('chronicle').innerHTML = nights.length ? nights.slice(0, chronShown).map((n) => `<li>${nightHtml(n, false)}</li>`).join('') : `<li class="cf-empty">${state!.nights.length ? 'One night so far. The rest of the page is still to be written.' : 'The first page is blank. The ink is waiting.'}</li>`;
    $('chron-more').hidden = nights.length <= chronShown;
  }
  $('chron-more').addEventListener('click', () => { chronShown += 10; renderChronicle(); });

  $('reset').addEventListener('click', async () => {
    if (!warband) return;
    if (confirm(`Burn ${warband.name}'s ledger? Every night, charm and rumour goes with it. You keep the warband.`)) await act('reset', {}, () => toast('The ledger is ash.'));
  });
  $('release').addEventListener('click', async () => {
    if (!warband) return;
    if (confirm(`Give up ${warband.name}? The ledger is destroyed and anyone may take the warband up.`)) {
      const id = warband.id;
      await act('release', {}, undefined);
      boot.claims = boot.claims.filter((c) => c.warbandId !== id);
      showPicker(true);
      toast('The warband is nobody’s now.');
    }
  });

  // ── debug: step through nights (only where the server allows a date override, and only for the Watch) ──
  function renderDebug() {
    if (!boot.debug || !boot.viewer?.admin) { setDebug(false); return; }
    $('debug-toggle').hidden = false;
    const on = debugEnabled();
    $('debug-toggle').setAttribute('aria-pressed', String(on));
    $('debug-toggle').textContent = on ? 'Debug on · dry run' : 'Debug';
    const dry = on && boot.dry && warband
      ? { sandbox: loadSandbox(warband.id), wouldPrint: (view?.wouldPrint ?? []).map((d) => d.headline), onReset: () => { clearSandbox(); location.reload(); } }
      : undefined;
    renderDebugBar($('debug-bar'), today, dry);
    if (on) carryDate($<HTMLAnchorElement>('eve-link'));
  }
  $('debug-toggle').addEventListener('click', () => {
    // turning the strip on or off changes what the server does with the next request, so the page starts over
    setDebug(!debugEnabled());
    location.href = debugEnabled() ? location.href : location.pathname;
  });

  applyView(view);
  // A dry run with a sandbox from an earlier step: the page was rendered from the real ledger, so ask again with the sandbox as the base.
  if (dryRun && warband && loadSandbox(warband.id)) act('look', {});
</script>
