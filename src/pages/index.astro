---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import TownCryer from '../components/TownCryer.astro';
import WarbandCard from '../components/WarbandCard.astro';
import MemberModal from '../components/MemberModal.astro';
import Standings from '../components/Standings.astro';
import Chronicle from '../components/Chronicle.astro';
import Graveyard from '../components/Graveyard.astro';
import Icon from '../components/Icon.astro';
import { hasDatabase } from '../server/db/client';
import { campaignMoves, curfewStory, recentDispatches, todayFor, type CurfewStory, type PrintedDispatch } from '../server/curfew/service';
import { listWarbands } from '../server/campaign/roster';
import { listScenarios, memberStories, type MemberChapter } from '../server/campaign/scenarios';
import { articlesFor } from '../server/campaign/news';
import { DEFAULT_SETTINGS, getSettings, type CampaignSettings } from '../server/campaign/settings';
import { primeContent } from '../server/content/curfew';
import { locationForNight, type Move } from '../curfew/engine';
import type { NewsArticle, Scenario, Warband } from '../campaign/model';

// Rendered on request: the whole campaign's record lives in the database now. Cached at the edge for a few
// minutes, since nothing on this page is personal; the header's signed-in links are revealed by the browser.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=1800');

const today = todayFor(null);
let warbands: Warband[] = [], scenarios: Scenario[] = [], articles: NewsArticle[] = [], dispatches: PrintedDispatch[] = [], moves: Move[] = [];
let stories: Record<string, MemberChapter[]> = {};
let story: CurfewStory = { members: {}, warbands: {} };
// The standings stay the Watch's until the admin shows them.
let settings: CampaignSettings = DEFAULT_SETTINGS;
let trouble = !hasDatabase();
if (hasDatabase()) {
  try {
    await primeContent();
    [warbands, scenarios, moves, dispatches, settings] = await Promise.all([listWarbands(), listScenarios(), campaignMoves(), recentDispatches(today, 8), getSettings()]);
    stories = memberStories(scenarios);
    articles = await articlesFor(locationForNight(today, moves).id);
    story = await curfewStory(today);
  } catch (e) { console.error('[campaign] the record could not be read', e); trouble = true; }
}
const fallen = warbands.reduce((n, w) => n + w.members.filter((m) => m.dead).length, 0);
const played = scenarios.filter((s) => s.status === 'played').length;
---

<Base title="Mordheim — City of the Damned | Campaign Chronicle">
  <Header warbands={warbands.length} scenarios={played} fallen={fallen} standings={settings.standingsVisible} />

  <main id="main-content">
    {trouble && <div class="empty-state"><p>The campaign's record could not be read just now. Try again in a moment.</p></div>}
    <TownCryer today={today} articles={articles} dispatches={dispatches} moves={moves} />

    <section id="warbands" class="warbands">
      <p class="section-kicker">I · Those who enter the gates</p>
      <h2 class="section-title"><span class="ornament" aria-hidden="true"><Icon name="diamond" /></span> The Warbands <span class="ornament" aria-hidden="true"><Icon name="diamond" /></span></h2>
      <p class="section-intro">
        These brave — or foolish — souls have entered the shattered gates of Mordheim in search of
        wyrdstone, gold, and glory. Most will find only death. Click a warrior to read their tale.
      </p>
      <div class="warband-grid">
        {warbands.map((wb) => <WarbandCard warband={wb} standing={story.warbands[wb.id]} />)}
      </div>
    </section>

    {settings.standingsVisible && <Standings warbands={warbands} />}
    <Chronicle scenarios={scenarios} warbands={warbands} />
    <Graveyard warbands={warbands} />
  </main>

  <footer class="site-footer">
    <a class="footer-mark" href="#top" aria-label="Return to the gates of Mordheim"><Icon name="cross" size={28} /></a>
    <p class="footer-quote">“The dead walk the streets of Mordheim, and the living envy them.”</p>
    <p class="footer-note">
      A fan-made campaign page for our game group. Mordheim is © Games Workshop — this is a
      non-commercial hobby project.
    </p>
  </footer>

  <MemberModal warbands={warbands} stories={stories} nights={story.members} />
</Base>

<style>
  .warband-grid {
    display: grid;
    gap: 2.5rem;
  }

  .site-footer {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 4rem 1rem;
    border-top: 1px solid var(--border);
    background: linear-gradient(transparent, #070c0a);
  }
  .footer-mark { display: inline-block; color: var(--gold); margin-bottom: 1.5rem; text-decoration: none; }
  .footer-quote {
    font-family: 'UnifrakturMaguntia', cursive;
    font-size: 1.3rem;
    color: var(--ink-dim);
    margin-bottom: 1rem;
  }
  .footer-note {
    font-size: var(--text-meta);
    color: var(--ink-dim);
    max-width: 560px;
    margin-inline: auto;
  }
</style>

<script>
  // Scroll-reveal animation
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
