---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { history, getScenarioUrl, type ScenarioRecord } from '../../data/history';

export const getStaticPaths = (() =>
  history.map((scenario) => ({
    params: { id: scenario.id },
    props: { scenario },
  }))) satisfies GetStaticPaths;

interface Props {
  scenario: ScenarioRecord;
}

const { scenario } = Astro.props;
const { report } = scenario;
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const chapters = [...history].sort((a, b) => a.sequence - b.sequence);
const chapterIndex = chapters.findIndex((chapter) => chapter.id === scenario.id);
const previous = chapters[chapterIndex - 1];
const next = chapters[chapterIndex + 1];
const winners = scenario.warbands.filter((warband) => warband.result === 'victory');
const resultLabel = { victory: 'Victory', defeat: 'Defeat', draw: 'Draw' } as const;
const statusLabel = { active: 'Active', injured: 'Injured', dead: 'Fell in this battle' } as const;
const perspectives = scenario.warbands.map((warband) => ({
  warband,
  perspective: report.perspectives.find((entry) => entry.warbandId === warband.warbandId),
}));
const sealIcons = { Bell: 'bell', Boat: 'boat', Key: 'key', Candle: 'candle', Anchor: 'anchor', Crown: 'crown', Moon: 'moon' } as const;
---

<Base title={`${scenario.scenario} — Mordheim`} description={scenario.summary}>
  <main id="main-content" class="battle-report">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={home}>Mordheim</a><span aria-hidden="true">/</span>
      <a href={`${home}#chronicle`}>The Chronicle</a><span aria-hidden="true">/</span>
      <span aria-current="page">Scenario {String(scenario.sequence).padStart(2, '0')}</span>
    </nav>

    <header class="report-header">
      <p class="section-kicker">From the campaign archives · {scenario.date}</p>
      <h1>{scenario.scenario}</h1>
      <p class="summary">{scenario.summary}</p>
      <div class="participants" aria-label="Participating warbands">
        {scenario.warbands.map((warband) => (
          <a href={`#${warband.warbandId}`} class:list={['participant', warband.result]}>
            {warband.name}<span>{resultLabel[warband.result]}</span>
          </a>
        ))}
      </div>
    </header>

    <nav class="report-nav" aria-label="Battle report sections">
      <a href="#outcome">Outcome</a>
      <a href="#prologue">Prologue</a>
      <a href="#battle">The battle</a>
      <a href="#epilogue">Epilogue</a>
      {report.puzzle && <a href="#merchant-puzzle">The sealed clue</a>}
      <a href="#muster">Warbands &amp; warriors</a>
      <a href="#campaign">Campaign consequences</a>
    </nav>

    <section id="outcome" class="panel">
      <h2>Scenario &amp; outcome</h2>
      <dl class="outcome-facts">
        <div><dt>Rulebook scenario</dt><dd>{report.rulebookScenario ?? 'Not recorded'}</dd></div>
        <div><dt>Win condition</dt><dd>{report.winCondition ?? 'Not recorded'}</dd></div>
        <div><dt>Winner</dt><dd>{winners.length ? winners.map((warband) => warband.name).join(' & ') : 'No winner — draw'}</dd></div>
      </dl>
      <h3>How the outcome was decided</h3>
      <p>{report.outcome}</p>
      {(!report.rulebookScenario || !report.winCondition) && (
        <p class="archive-note">The chapter title is not a rulebook scenario name. Missing rules information is left unconfirmed rather than inferred from the story.</p>
      )}
    </section>

    <section id="prologue">
      <p class="section-kicker">Before the first blow</p>
      <h2 class="section-title">Prologue</h2>
      <p class="neutral">{report.prologue}</p>
      <div class="perspectives">
        {perspectives.map(({ warband, perspective }) => (
          <article class="panel perspective">
            <p class="voice-label">From their perspective</p>
            <h3>{warband.name}</h3>
            <p>{perspective?.prologue ?? 'This perspective has not yet been recorded.'}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="battle" class="battle-narrative">
      <p class="section-kicker">An account of blood &amp; wyrdstone</p>
      <h2 class="section-title">The battle</h2>
      {report.battle.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section id="epilogue">
      <p class="section-kicker">When the fighting ends</p>
      <h2 class="section-title">Epilogue</h2>
      <p class="neutral">{report.epilogue}</p>
      <div class="perspectives">
        {perspectives.map(({ warband, perspective }) => (
          <article class="panel perspective">
            <p class="voice-label">From their perspective</p>
            <h3>{warband.name}</h3>
            <p>{perspective?.epilogue ?? 'This perspective has not yet been recorded.'}</p>
          </article>
        ))}
      </div>
    </section>

    {report.puzzle && (
      <section id="merchant-puzzle" class="panel seal-puzzle" aria-labelledby="puzzle-title">
        <p class="section-kicker">An unfinished account</p>
        <h2 id="puzzle-title">{report.puzzle.title}</h2>
        <p id="puzzle-instructions">{report.puzzle.introduction}</p>
        <div class="perspectives puzzle-evidence">
          {report.puzzle.clues.map((clue) => (
            <article class="evidence">
              <h3>{clue.source}</h3>
              <p>{clue.text}</p>
            </article>
          ))}
        </div>
        <form data-seal-form aria-describedby="puzzle-instructions seal-help">
          <fieldset disabled>
            <legend>The routing plate · follow socket numbers</legend>
            <p id="seal-help">Select a seal from the tray, then tap a numbered socket to place it. Placing a used seal moves it; occupied sockets swap. Tap a filled socket with no seal selected to return it to the tray. Keyboard: Tab to a control, then Enter or Space.</p>
            <div class="seal-controls" role="group" aria-label="Routing sockets, in reading order">
              {report.puzzle.solution.map((answer, index) => (
                <button type="button" class="seal-socket" data-answer={answer} data-socket aria-label={`Socket ${index + 1}, empty`}>
                  <span class="socket-number" aria-hidden="true">{index + 1}</span>
                  <span data-socket-symbol aria-hidden="true"><Icon name="diamond" size={32} /></span>
                  <span data-socket-name>Empty</span>
                </button>
              ))}
            </div>
            <p class="tray-label">Seal tray · select one to place</p>
            <div class="seal-tray" role="group" aria-label="Available seals">
              {report.puzzle.seals.map((seal) => (
                <button type="button" data-seal={seal} aria-pressed="false">
                  <span data-seal-symbol><Icon name={sealIcons[seal as keyof typeof sealIcons] ?? 'diamond'} size={32} /></span>
                  <span>{seal}</span>
                  <small data-seal-location>In tray</small>
                </button>
              ))}
            </div>
            <div class="seal-actions">
              <button type="submit">Turn the seals</button>
              <button type="reset">Reset puzzle</button>
            </div>
          </fieldset>
        </form>
        <noscript><p>The clues can be solved on paper using the numbered sockets and labelled seals. Enable JavaScript to arrange the seals and reveal the hidden dispatch.</p></noscript>
        <p data-puzzle-feedback role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="margin-note">
          <button
            type="button"
            class="thumbprint"
            data-hint-trigger
            data-hint-key={scenario.id}
            aria-expanded="false"
            aria-controls="clerks-margin"
            aria-label="A greasy thumbprint in the margin — press to read the clerk&rsquo;s workings on this puzzle"
          >
            <Icon name="thumbprint" size={22} />
            <span class="thumbprint-label" aria-hidden="true">A greasy thumbprint in the margin</span>
          </button>
        </div>
        <div id="clerks-margin" class="clerks-margin" data-hint-ledger hidden>
          <h3 tabindex="-1">The clerk&rsquo;s margin</h3>
          <p class="archive-note">Someone worked the puzzle before you and left their reasoning in soot along the edge of the plate. Rub the lines back one at a time; each gives away a little more.</p>
          <ol class="margin-workings">
            {report.puzzle.hints.map((hint, index) => (
              <li data-hint hidden><span class="working-index">Working {index + 1}</span><p>{hint}</p></li>
            ))}
          </ol>
          <div class="margin-actions">
            <button type="button" data-hint-next>Rub away more soot</button>
            <button type="button" data-hint-close>Fold the margin under</button>
          </div>
          <p class="archive-note" data-hint-exhausted hidden>Nothing further survives in the margin.</p>
        </div>
        <div data-puzzle-revelation class="dispatch" hidden>
          <h3 tabindex="-1">The hidden dispatch</h3>
          {report.puzzle.revelation.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>
    )}

    <section id="muster">
      <p class="section-kicker">The final reckoning</p>
      <h2 class="section-title">Warbands &amp; warriors</h2>
      <p class="neutral archive-note">Treasury and ratings are post-battle totals, not loot earned in this battle. Only explicitly recorded out-of-action results are credited; a hit, a fall, or a bow notch alone is not confirmation. “Not recorded” does not mean none occurred.</p>
      <div class="warband-summaries">
        {perspectives.map(({ warband, perspective }) => {
          const takedowns = report.outOfAction.filter((event) => warband.members.some((member) => member.memberId === event.attackerId));
          return (
            <article id={warband.warbandId} class="panel warband-summary">
              <p class:list={['voice-label', warband.result]}>{resultLabel[warband.result]}</p>
              <h3>{warband.name}</h3>
              <h4>Accomplishments</h4>
              <p>{perspective?.accomplishments ?? warband.highlights.join(' ')}</p>
              <dl class="snapshot-stats">
                <div><dt>Rating</dt><dd>{warband.rating}</dd></div>
                <div><dt>Battles</dt><dd>{warband.battles}</dd></div>
                <div><dt>Victories</dt><dd>{warband.victories}</dd></div>
                <div><dt>Wyrdstone</dt><dd>{warband.wyrdstone} shards</dd></div>
                <div><dt>Treasury</dt><dd>{warband.gold} crowns</dd></div>
              </dl>
              <h4 class="finest">Finest moments</h4>
              <ul>{warband.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
              <h4 class="darkest">Darkest moments</h4>
              <ul>{warband.lowlights.map((lowlight) => <li>{lowlight}</li>)}</ul>
              <h4>Opponents put out of action</h4>
              {takedowns.length ? (
                <ul>{takedowns.map((event) => (
                  <li><a href={`#member-${event.attackerId}`}>{warband.members.find((member) => member.memberId === event.attackerId)?.name}</a> defeated {event.target}</li>
                ))}</ul>
              ) : <p class="archive-note">Not recorded.</p>}

              <h4 class="roster-title">Every warrior's battle record</h4>
              {warband.members.map((member) => {
                const events = report.outOfAction.filter((event) => event.attackerId === member.memberId);
                return (
                  <article id={`member-${member.memberId}`} class="member-record">
                    <h5>{member.name}</h5>
                    <p class="member-meta">{member.rank} · {member.role} · <span class:list={{ darkest: member.status !== 'active' }}>{statusLabel[member.status]}</span></p>
                    {member.experience !== undefined && <p><strong>Experience:</strong> {member.experience}</p>}
                    <p><strong class="finest">Accomplishment &amp; finest moment:</strong> {member.highlight}</p>
                    <p><strong class="darkest">Darkest moment:</strong> {member.lowlight}</p>
                    <p><strong>Put out of action:</strong> {events.length === 0 && 'Not recorded.'}</p>
                    {events.length > 0 && (
                      <ul>{events.map((event) => (
                        <li>
                          {event.targetId ? <a href={`#member-${event.targetId}`}>{event.target}</a> : event.target}
                          {' — '}{event.detail}
                        </li>
                      ))}</ul>
                    )}
                  </article>
                );
              })}
            </article>
          );
        })}
      </div>
    </section>

    <details id="campaign" class="panel campaign-ledger">
      <summary>
        <h2>What the campaign carries forward</h2>
        <span class="summary-note">Loot, costs &amp; unresolved records <Icon name="arrow-down" size={14} /></span>
      </summary>
      <div class="campaign-body">
        <h3>Noteworthy loot &amp; costs</h3>
        {report.loot.length ? <ul>{report.loot.map((item) => <li>{item}</li>)}</ul> : <p>No noteworthy loot recorded.</p>}
        <h3>Lasting consequences &amp; unresolved records</h3>
        {report.campaignNotes.length ? <ul>{report.campaignNotes.map((note) => <li>{note}</li>)}</ul> : <p>No lasting consequences recorded.</p>}
      </div>
    </details>

    <nav class="chapter-nav" aria-label="Scenario navigation">
      {previous && <a href={getScenarioUrl(previous.id)}><Icon name="arrow-left" size={14} /> Previous: {previous.scenario}</a>}
      <a href={`${home}#chronicle`}>Back to the Chronicle</a>
      {next && <a href={getScenarioUrl(next.id)}>Next: {next.scenario} <Icon name="arrow-right" size={14} /></a>}
    </nav>
  </main>
</Base>

<script>
  const puzzle = document.querySelector<HTMLElement>('.seal-puzzle');
  if (puzzle) {
    const form = puzzle.querySelector<HTMLFormElement>('[data-seal-form]')!;
    const fieldset = form.querySelector('fieldset')!;
    const sockets = [...form.querySelectorAll<HTMLButtonElement>('[data-socket]')];
    const seals = [...form.querySelectorAll<HTMLButtonElement>('[data-seal]')];
    const feedback = puzzle.querySelector<HTMLElement>('[data-puzzle-feedback]')!;
    const revelation = puzzle.querySelector<HTMLElement>('[data-puzzle-revelation]')!;
    const hintTrigger = puzzle.querySelector<HTMLButtonElement>('[data-hint-trigger]')!;
    const ledger = puzzle.querySelector<HTMLElement>('[data-hint-ledger]')!;
    const workings = [...ledger.querySelectorAll<HTMLElement>('[data-hint]')];
    const nextHint = ledger.querySelector<HTMLButtonElement>('[data-hint-next]')!;
    const closeLedger = ledger.querySelector<HTMLButtonElement>('[data-hint-close]')!;
    const exhausted = ledger.querySelector<HTMLElement>('[data-hint-exhausted]')!;
    const noticedKey = `mordheim:margin-noticed:${hintTrigger.dataset.hintKey}`;
    let failedAttempts = 0;
    const emptySymbol = sockets[0].querySelector('[data-socket-symbol]')!.firstElementChild!.cloneNode(true);
    let arrangement: (string | null)[] = sockets.map(() => null);
    let selected: string | null = null;
    fieldset.disabled = false;

    /* The margin is meant to be found, not advertised: it stays a near-invisible
       smudge until someone hovers, tabs onto it, or struggles with the plate. Once
       a reader has found it, remember that so it stays legible on later visits. */
    const notice = (persist: boolean) => {
      hintTrigger.classList.add('is-noticed');
      if (!persist) return;
      try { localStorage.setItem(noticedKey, '1'); } catch { /* storage unavailable */ }
    };

    try { if (localStorage.getItem(noticedKey)) notice(false); } catch { /* storage unavailable */ }

    const revealWorking = () => {
      const working = workings.find((entry) => entry.hidden);
      if (!working) return;
      working.hidden = false;
      const remaining = workings.filter((entry) => entry.hidden).length;
      nextHint.hidden = remaining === 0;
      exhausted.hidden = remaining > 0;
      feedback.textContent = remaining
        ? `Working ${workings.indexOf(working) + 1} of ${workings.length} rubbed clear. ${remaining} still under the soot.`
        : `Working ${workings.length} of ${workings.length} rubbed clear. Nothing further survives in the margin.`;
    };

    const openLedger = () => {
      notice(true);
      ledger.hidden = false;
      hintTrigger.setAttribute('aria-expanded', 'true');
      if (workings.every((entry) => entry.hidden)) revealWorking();
      ledger.querySelector('h3')?.focus();
    };

    const shutLedger = () => {
      ledger.hidden = true;
      hintTrigger.setAttribute('aria-expanded', 'false');
    };

    hintTrigger.addEventListener('click', () => {
      if (ledger.hidden) openLedger();
      else { shutLedger(); hintTrigger.focus(); }
    });
    nextHint.addEventListener('click', revealWorking);
    closeLedger.addEventListener('click', () => { shutLedger(); hintTrigger.focus(); });

    const render = () => {
      sockets.forEach((socket, index) => {
        const name = arrangement[index];
        const symbol = seals.find((seal) => seal.dataset.seal === name)?.querySelector('[data-seal-symbol]')?.firstElementChild;
        socket.querySelector('[data-socket-symbol]')!.replaceChildren((symbol ?? emptySymbol).cloneNode(true));
        socket.querySelector('[data-socket-name]')!.textContent = name ?? 'Empty';
        socket.setAttribute('aria-label', `Socket ${index + 1}, ${name ?? 'empty'}${selected ? `; place ${selected}` : name ? '; return to tray' : ''}`);
        socket.classList.toggle('is-filled', name !== null);
      });
      seals.forEach((seal) => {
        const position = arrangement.indexOf(seal.dataset.seal!);
        seal.setAttribute('aria-pressed', String(selected === seal.dataset.seal));
        seal.querySelector('[data-seal-location]')!.textContent = position < 0 ? 'In tray' : `Socket ${position + 1}`;
      });
    };

    seals.forEach((seal) => {
      seal.addEventListener('click', () => {
        selected = selected === seal.dataset.seal ? null : seal.dataset.seal!;
        feedback.textContent = selected ? `${selected} selected. Choose a socket.` : 'Selection cleared.';
        render();
      });
    });

    sockets.forEach((socket, index) => {
      socket.addEventListener('click', () => {
        if (selected) {
          const previous = arrangement.indexOf(selected);
          if (previous >= 0) arrangement[previous] = arrangement[index];
          arrangement[index] = selected;
          feedback.textContent = `${selected} placed in socket ${index + 1}.`;
          selected = null;
        } else {
          feedback.textContent = arrangement[index] ? `${arrangement[index]} returned to the tray.` : 'Select a seal from the tray first.';
          arrangement[index] = null;
        }
        revelation.hidden = true;
        render();
      });
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      revelation.hidden = true;
      if (arrangement.some((seal) => seal === null)) {
        feedback.textContent = 'The plate is incomplete. Fill every numbered socket before turning the seals.';
        return;
      }
      if (!sockets.every((socket, index) => arrangement[index] === socket.dataset.answer)) {
        failedAttempts += 1;
        const stuck = failedAttempts >= 3 && ledger.hidden;
        if (stuck) notice(true);
        feedback.textContent = stuck
          ? 'The seals resist. The mechanism gives no indication of which marks are wrong — but a greasy thumbprint below the plate catches the light, where some earlier clerk worked the same puzzle.'
          : 'The seals resist. The mechanism gives no indication of which marks are wrong. Compare the spacing and order in the evidence.';
        return;
      }
      selected = null;
      failedAttempts = 0;
      render();
      feedback.textContent = 'The seals yield. The hidden dispatch is revealed.';
      revelation.hidden = false;
      revelation.querySelector('h3')?.focus();
    });

    form.addEventListener('reset', () => {
      arrangement = sockets.map(() => null);
      selected = null;
      failedAttempts = 0;
      render();
      revelation.hidden = true;
      feedback.textContent = 'The dispatch is sealed again.';
      shutLedger();
      workings.forEach((working) => { working.hidden = true; });
      nextHint.hidden = false;
      exhausted.hidden = true;
      seals[0]?.focus();
    });
  }
</script>

<script>
  /* The campaign ledger sits closed at the foot of the page; anyone arriving on it
     from the section nav or a shared link should land on it already open. */
  const ledger = document.querySelector<HTMLDetailsElement>('#campaign');
  if (ledger) {
    const openOnHash = () => { if (location.hash === '#campaign') ledger.open = true; };
    openOnHash();
    window.addEventListener('hashchange', openOnHash);
    document.querySelectorAll<HTMLAnchorElement>('a[href="#campaign"]').forEach((link) => {
      link.addEventListener('click', () => { ledger.open = true; });
    });
  }
</script>

<style>
  .puzzle-evidence { margin: 1.5rem 0; }
  .evidence { border-left: 2px solid var(--gold-dim); padding-left: 1rem; }
  .evidence h3 { font-size: 1.4rem; }
  .seal-puzzle fieldset { border: 1px solid var(--gold-dim); padding: 1rem; min-width: 0; }
  .seal-puzzle legend { padding: 0 .5rem; color: var(--gold); }
  #seal-help { font-size: .9rem; }
  .seal-controls { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .5rem; margin-top: 1.25rem; padding-block: 1rem; border-block: 1px solid var(--gold-dim); }
  .seal-puzzle button:not(.thumbprint) { font: inherit; color: var(--parchment); background: var(--bg-panel2); border: 1px solid var(--gold-dim); padding: .75rem; min-height: 48px; min-width: 0; touch-action: manipulation; }
  .seal-puzzle button:not(.thumbprint):hover { border-color: var(--parchment); background: var(--bg); }
  .seal-puzzle button:disabled { cursor: default; opacity: .6; }
  .seal-socket, .seal-tray button { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .35rem; }
  .seal-puzzle .seal-socket { border-style: dashed; background: var(--bg); }
  .seal-puzzle .seal-socket.is-filled { border-style: solid; color: var(--gold); }
  .socket-number { font-size: .8rem; color: var(--ink-dim); }
  .tray-label { margin: 1.25rem 0 .75rem; color: var(--gold); }
  .seal-tray { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: .5rem; }
  .seal-tray small { font-size: .7rem; color: var(--ink-dim); }
  .seal-tray button[aria-pressed="true"] { outline: 2px solid var(--parchment); outline-offset: 2px; background: var(--bg); }
  .seal-puzzle button { cursor: pointer; }
  .seal-puzzle button:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .seal-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
  .seal-puzzle [role="status"] { margin: 1rem 0; color: var(--gold); }
  /* The clerk's margin: a smudge at the edge of the plate that only shows itself
     to a reader who hovers over it, tabs onto it, or has failed the plate enough
     times for the page to take pity. Never hidden from assistive technology. */
  .margin-note { display: flex; justify-content: flex-end; margin-top: .5rem; }
  .thumbprint {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    min-height: 48px; min-width: 48px; padding: .6rem;
    color: var(--ink-dim); background: none; border: 0;
    font: inherit; font-size: .8rem; text-align: left;
    opacity: .09; filter: blur(.5px); transition: opacity .45s ease, color .45s ease, filter .45s ease;
  }
  .thumbprint.is-noticed { opacity: .45; }
  .thumbprint:hover, .thumbprint:focus-visible, .seal-puzzle:hover .thumbprint.is-noticed {
    opacity: 1; color: var(--gold); filter: none;
  }
  /* At rest the smudge is a mark, not a sentence; the wording only surfaces once
     the reader has actually found it. It stays in the accessible name throughout. */
  .thumbprint-label {
    position: absolute; right: calc(100% - .25rem); top: 50%; transform: translateY(-50%);
    width: max-content; max-width: 19ch; text-align: right;
    opacity: 0; transition: opacity .3s ease;
  }
  .thumbprint:hover .thumbprint-label,
  .thumbprint:focus-visible .thumbprint-label,
  .seal-puzzle:hover .thumbprint.is-noticed .thumbprint-label { opacity: 1; }
  .clerks-margin { margin-top: 1rem; padding: 1.25rem; border: 1px dashed var(--gold-dim); background: var(--bg); }
  .clerks-margin[hidden] { display: none; }
  .clerks-margin h3 { font-size: 1.5rem; margin-bottom: .5rem; }
  .clerks-margin h3:focus-visible { outline: 2px solid var(--gold); outline-offset: 4px; }
  .margin-workings { list-style: none; padding: 0; margin-top: 1rem; }
  .margin-workings li { border-top: 1px solid var(--border); padding-top: .75rem; margin-bottom: .75rem; }
