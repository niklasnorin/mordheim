---
/**
 * A warband's page: the roll in full, their chronicle, and at the foot the keeper's pen. The owner or a game master
 * edits the warband and its warriors here; everyone else reads. Built for a phone first: one column, drawers that
 * open under each warrior, and links at the top to each part.
 */
import Base from '../../layouts/Base.astro';
import ManageTop from '../../components/ManageTop.astro';
import WarriorStory from '../../components/WarriorStory.astro';
import WarbandChronicle from '../../components/WarbandChronicle.astro';
import StoryChapters from '../../components/StoryChapters.astro';
import Portrait from '../../components/Portrait.astro';
import '../../styles/manage.css';
import '../../styles/portrait.css';
import { asset, base } from '../../lib/site';
import { hasDatabase } from '../../server/db/client';
import { getActor, isGm, listUsers } from '../../server/roles';
import { getWarband, listWarbands } from '../../server/campaign/roster';
import { listScenarios, memberStories, type MemberChapter } from '../../server/campaign/scenarios';
import { curfewStory, todayFor } from '../../server/curfew/service';
import { primeContent } from '../../server/content/curfew';
import { STAT_KEYS, STAT_NAMES, paragraphsOf, type Scenario, type StoryChapter, type Warband } from '../../campaign/model';
import { listChapters } from '../../server/campaign/chapters';
import type { MemberNights } from '../../curfew/story';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const ready = hasDatabase();
const viewer = ready ? await getActor(Astro.request) : null;
let warband: Warband | undefined, stories: Record<string, MemberChapter[]> = {}, keeperless = 0;
let nights: Record<string, MemberNights> = {}, roster: Warband[] = [], scenarios: Scenario[] = [], chapters: StoryChapter[] = [];
let players: { id: string; name: string; email: string }[] = [];
if (ready) {
  try {
    await primeContent();
    warband = await getWarband(Astro.params.id!);
    if (warband) {
      const [list, story, all, written] = await Promise.all([listScenarios(), curfewStory(todayFor(null)), listWarbands(), listChapters(warband.id)]);
      chapters = written;
      scenarios = list;
      stories = memberStories(scenarios);
      nights = story.members;
      roster = all;
      keeperless = all.filter((w) => !w.ownerId).length;
      if (viewer && isGm(viewer)) players = await listUsers();
    }
  } catch (e) { console.error('[warbands] unavailable', e); }
}
if (!warband) Astro.response.status = 404;
const gm = isGm(viewer);
const owner = !!viewer && !!warband && warband.ownerId === viewer.id;
const canEdit = owner || gm;
const mayClaim = !!viewer && !!warband && !warband.ownerId;
// The keeper's business sits at the foot of the page, under the roll and the chronicle; the links at the top reach it.
const hasPen = canEdit || mayClaim;
const overview = paragraphsOf(warband?.lore ?? '');
---

<Base title={warband ? `${warband.name} — Mordheim` : 'No such warband — Mordheim'} description={warband?.lore.slice(0, 160)}>
  <main class="mg mg-page" id="main-content" data-base={base}>
    <ManageTop crumbs={[{ label: 'Warbands', href: `${base}/warbands/` }, { label: warband?.name ?? 'Unknown' }]} viewer={viewer} />

    {!warband && <div class="mg-hero"><h1 class="mg-h1">No such warband</h1><p class="mg-lede">Nobody by that name has entered the gates. <a href={`${base}/warbands/`}>The warbands that have</a>.</p></div>}

    {warband && (
      <>
        <div class="mg-hero wb-hero">
          <span class="wb-crest" aria-hidden="true">{warband.crest ? <img src={asset(warband.crest)} width="120" height="140" alt="" /> : warband.sigil}</span>
          <div>
            <p class="mg-kicker">{warband.type}{warband.player ? <> · kept by {warband.player}</> : <> · <span class="mg-chip">nobody’s yet</span></>}{owner && <span class="mg-chip gold">Yours</span>}{owner && <a class="wb-kicker-link" href={`${base}/curfew/`}>The Curfew ledger</a>}{!viewer && ready && <a class="wb-kicker-link" href={`${base}/signin/?next=${encodeURIComponent(Astro.url.pathname)}`}>Sign in to keep a warband</a>}</p>
            <h1 class="mg-h1">{warband.name}</h1>
          </div>
        </div>


        <nav class="wb-tabs" aria-label="The warband">
          <a href="#overview" data-tab>Overview</a>
          <a href="#story" data-tab>Their story</a>
          <a href="#roster" data-tab>The muster roll</a>
          <a href="#chronicle" data-tab>Their chronicle</a>
          {hasPen && <a href="#keeping" data-tab>{mayClaim && !canEdit ? 'Take them up' : 'The keeper’s pen'}</a>}
        </nav>

        <section class="mg-section wb-pane" id="overview" data-pane>
          <div class="mg-section-head"><h2 class="mg-h2">Warband overview</h2><span class="mg-muted">For the other players: who they are and what they want.</span></div>
          {overview.length > 0
            ? <div class="wb-overview">{overview.map((p) => <p>{p}</p>)}</div>
            : <p class="mg-empty">{canEdit ? 'No overview yet. Write a paragraph the other players can read, in the keeper’s pen.' : 'No overview has been written yet.'}</p>}
          {canEdit && <div class="mg-actions"><a class="mg-btn ghost" href="#record">{overview.length > 0 ? 'Change the overview' : 'Write the overview'}</a></div>}
        </section>

        <section class="mg-section wb-pane" id="story" data-pane hidden>
          <h2 class="visually-hidden">Their story</h2>
          <StoryChapters warbandId={warband.id} chapters={chapters} canEdit={canEdit} />
        </section>

        <section class="mg-section wb-pane" id="roster" data-pane hidden>
          <div class="mg-section-head">
            <h2 class="mg-h2">The muster roll</h2>
          </div>
          <p class="mg-muted wb-hint">{canEdit ? 'Open a warrior to read them, or to change them.' : 'Open a warrior to read their record.'}</p>
          {warband.members.length === 0 && <p class="mg-empty">No warriors yet. {canEdit ? 'Add the first below.' : 'The roll is blank.'}</p>}
          <ul class="mg-roster">
            {warband.members.map((m, i) => {
              const chapters = stories[m.id] ?? [];
              return (
                <li>
                  <details class:list={['mg-warrior', { dead: m.dead }]} id={m.id}>
                    <summary>
                      <span class="mg-num">{m.picture ? <Portrait member={m} width="2.4rem" /> : String(i + 1).padStart(2, '0')}</span>
                      <span><span class="mg-name">{m.name}</span><span class="mg-role">{m.role}{m.rank === 'hero' ? ' · hero' : ''}</span>{m.epithet && <span class="mg-tag">{m.epithet}</span>}</span>
                      <span class="mg-muted">{m.dead ? <span class="mg-chip blood">Fallen</span> : m.experience !== undefined ? `${m.experience} xp` : ''}</span>
                    </summary>
                    <div class:list={['mg-body', { 'pt-split': !!m.picture || canEdit }]}>
                      {(m.picture || canEdit) && (
                        <div class:list={['pt-side', { empty: !m.picture }]}>
                          <div class="pt-side-hold">
                            {m.picture
                              ? <Portrait member={m} alt={`Portrait of ${m.name}`} framed />
                              : (
                                <div class="pt-likeness" data-portrait-editor data-member={m.id} data-name={m.name.split(' ')[0]}>
                                  <button type="button" class="pt-empty" data-portrait-choose><span>Add a portrait</span></button>
                                  <div class="pt-acts">
                                    <small class="mg-muted">Any picture will do: a photograph of the model, a painting, a sketch. You frame it next.</small>
                                    <small class="pt-note" data-portrait-note role="alert" hidden></small>
                                  </div>
                                  <input type="file" accept="image/*" data-portrait-file hidden />
                                </div>
                              )}
                          </div>
                        </div>
                      )}
                      <div class="pt-main">
                        <table class="mg-statline"><caption class="visually-hidden">{m.name}'s statline</caption>
                          <thead><tr>{STAT_KEYS.map((k) => <th scope="col"><abbr title={STAT_NAMES[k]}>{k}</abbr></th>)}</tr></thead>
                          <tbody><tr>{STAT_KEYS.map((k) => <td>{m.stats[k]}</td>)}</tr></tbody>
                        </table>
                        {m.skills.length > 0 && <><h4 class="mg-h3">Skills &amp; special rules</h4><ul class="mg-list">{m.skills.map((x) => <li>{x}</li>)}</ul></>}
                        {m.injuries.length > 0 && <><h4 class="mg-h3">Old wounds</h4><ul class="mg-list">{m.injuries.map((x) => <li>{x}</li>)}</ul></>}
                        {m.lore.trim() && <><h4 class="mg-h3">Tale</h4><p class="mg-lede">{m.lore}</p></>}
                        <WarriorStory member={m} chapters={chapters} nights={nights[m.id]} warbands={roster} />
                        {canEdit && (
                          <details class="mg-editor">
                            <summary>Change {m.name.split(' ')[0]}</summary>
                            <form class="mg-form" data-api="warbands/update-member" data-json={JSON.stringify({ memberId: m.id })}>
                              {m.picture && (
                                <fieldset class="mg-fieldset"><legend>Portrait</legend>
                                  <div class="pt-change" data-portrait-editor data-member={m.id} data-name={m.name.split(' ')[0]} data-picture={JSON.stringify(m.picture)}>
                                    <Portrait member={m} width="4.5rem" />
                                    <div class="pt-acts">
                                      <button type="button" class="mg-link" data-portrait-reframe>Frame it again</button>
                                      <button type="button" class="mg-link" data-portrait-choose>Another picture</button>
                                      <button type="button" class="mg-link pt-down" data-act="warbands/remove-portrait" data-body={JSON.stringify({ memberId: m.id })} data-confirm={`Take down ${m.name}’s portrait?`}>Take it down</button>
                                      <small class="pt-note" data-portrait-note role="alert" hidden></small>
                                    </div>
                                    <input type="file" accept="image/*" data-portrait-file hidden />
                                  </div>
                                  <small class="mg-muted pt-hint">A new framing is kept as soon as it is made; the rest waits for Save.</small>
                                </fieldset>
                              )}
                              <div class="mg-two">
                                <label class="mg-field">Name<input name="patch.name" required maxlength="80" value={m.name} /></label>
                                <label class="mg-field">Role<input name="patch.role" maxlength="60" value={m.role} placeholder="Elder, Jaeger, Ogre…" /></label>
                              </div>
                              <div class="mg-two">
                                <label class="mg-field">Rank<select name="patch.rank"><option value="hero" selected={m.rank === 'hero'}>Hero</option><option value="henchman" selected={m.rank === 'henchman'}>Henchman</option></select></label>
                                <label class="mg-field">Experience<input name="patch.experience" type="number" min="0" max="999" value={m.experience ?? ''} data-nullable /></label>
                              </div>
                              <label class="mg-field">Epithet<input name="patch.epithet" maxlength="120" value={m.epithet} placeholder="Who Led Them South" /><small>As it would follow the name on a tombstone.</small></label>
                              <fieldset class="mg-fieldset"><legend>Characteristics</legend>
                                <div class="mg-stats">{STAT_KEYS.map((k) => <label>{k}<input name={`patch.stats.${k}`} type="number" min="0" max="10" value={m.stats[k]} inputmode="numeric" aria-label={STAT_NAMES[k]} /></label>)}</div>
                              </fieldset>
                              <label class="mg-field">Skills &amp; special rules<textarea name="patch.skills" data-list>{m.skills.join('\n')}</textarea><small>One per line. Prayers and spells go here too. Weapons and gear are not tracked.</small></label>
                              <label class="mg-field">Old wounds<textarea name="patch.injuries" data-list>{m.injuries.join('\n')}</textarea><small>One per line, as rolled on the serious injury table.</small></label>
                              <label class="mg-field">Tale<textarea name="patch.lore" maxlength="4000">{m.lore}</textarea></label>
                              <label class="mg-field check"><input type="checkbox" name="patch.dead" checked={m.dead} /> Fallen</label>
                              <div class="mg-two">
                                <label class="mg-field">Laid to rest on<input name="patch.death.date" maxlength="80" value={m.death?.date ?? ''} placeholder="Marktag, 5th of Pflugzeit, 2004 IC" /></label>
                                <label class="mg-field">Epitaph<input name="patch.death.epitaph" maxlength="200" value={m.death?.epitaph ?? ''} placeholder="As carved. Short." /></label>
                              </div>
                              <div class="mg-actions end">
                                {chapters.length === 0 && <button type="button" class="mg-btn blood sm" data-act="warbands/remove-member" data-body={JSON.stringify({ memberId: m.id })} data-confirm={`Strike ${m.name} from the roll? They fought in no recorded battle, so nothing else remembers them.`}>Strike from the roll</button>}
                                <button type="submit" class="mg-btn">Save {m.name.split(' ')[0]}</button>
                              </div>
                            </form>
                          </details>
                        )}
                      </div>
                    </div>
                  </details>
                </li>
              );
            })}
          </ul>
          {canEdit && (
            <details class="mg-editor wb-add" id="add-warrior">
              <summary>Add a warrior to the roll</summary>
              <form class="mg-form" data-api="warbands/add-member" data-json={JSON.stringify({ warbandId: warband.id })}>
                <div class="mg-two">
                  <label class="mg-field">Name<input name="member.name" required maxlength="80" placeholder="Ulf Nordost" /></label>
                  <label class="mg-field">Role<input name="member.role" maxlength="60" placeholder="Jaeger" /></label>
                </div>
                <div class="mg-two">
                  <label class="mg-field">Rank<select name="member.rank"><option value="henchman">Henchman</option><option value="hero">Hero</option></select></label>
                  <label class="mg-field">Experience<input name="member.experience" type="number" min="0" max="999" value="0" /></label>
                </div>
                <fieldset class="mg-fieldset"><legend>Characteristics</legend>
                  <div class="mg-stats">{STAT_KEYS.map((k) => <label>{k}<input name={`member.stats.${k}`} type="number" min="0" max="10" value={{ M: 4, WS: 3, BS: 3, S: 3, T: 3, W: 1, I: 3, A: 1, Ld: 7 }[k]} inputmode="numeric" aria-label={STAT_NAMES[k]} /></label>)}</div>
                </fieldset>
                <label class="mg-field">Skills &amp; special rules<textarea name="member.skills" data-list></textarea><small>One per line.</small></label>
                <label class="mg-field">Tale<textarea name="member.lore" maxlength="4000" placeholder="Two to four sentences: who they are through habit, and one physical or historical detail."></textarea></label>
                <div class="mg-actions end"><button type="submit" class="mg-btn">Enter them on the roll</button></div>
              </form>
            </details>
          )}
        </section>

        <section class="mg-section wb-pane" id="chronicle" data-pane hidden>
          <div class="mg-section-head"><h2 class="mg-h2">Their chronicle</h2></div>
          <WarbandChronicle warband={warband} scenarios={scenarios} nights={nights} warbands={roster} />
        </section>

        {hasPen && (
          <section class="mg-section wb-pane" id="keeping" data-pane hidden>
            <div class="mg-section-head"><h2 class="mg-h2">The keeper’s pen</h2></div>
            {mayClaim && (
              <div class="mg-actions">
                {mayClaim && !gm && <button type="button" class="mg-btn" data-act="warbands/claim" data-body={JSON.stringify({ warbandId: warband.id })} data-confirm={`Take up ${warband.name}? They are yours to keep from here on: roster, story and ledger.`}>Take them up</button>}
                {mayClaim && gm && <button type="button" class="mg-btn ghost" data-act="warbands/claim" data-body={JSON.stringify({ warbandId: warband.id })} data-confirm={`Keep ${warband.name} yourself?`}>Keep them yourself</button>}
              </div>
            )}
            {!canEdit && viewer && !warband.ownerId && keeperless > 0 && <p class="mg-note">Take them up and the pen is yours.</p>}
            {canEdit && (
              <details class="mg-editor" id="record">
                <summary>The warband’s record</summary>
                <form class="mg-form" data-api="warbands/update" data-json={JSON.stringify({ warbandId: warband.id })}>
                  <div class="mg-two">
                    <label class="mg-field">Name<input name="patch.name" required maxlength="80" value={warband.name} /></label>
                    <label class="mg-field">Kind<input name="patch.type" required maxlength="60" value={warband.type} /></label>
                  </div>
                  <label class="mg-field">Warband overview<textarea name="patch.lore" maxlength="4000" class="tall">{warband.lore}</textarea><small>A paragraph for the other players: where they are from, what drove them to the city, what they want. No stats, no rules. It is what the home page shows. Their full story is written chapter by chapter under Their story.</small></label>
                  <p class="mg-note">Battles and victories are counted from the recorded scenarios.</p>
                  {gm && (
                    <div class="mg-two">
                      <label class="mg-field">Sigil<input name="patch.sigil" maxlength="3" value={warband.sigil} /><small>Two or three letters, shown where there is no crest.</small></label>
                      <label class="mg-field">Crest file<input name="patch.crest" maxlength="120" value={warband.crest ?? ''} placeholder="crest-grey-hand.svg" /><small>An image under public/, committed to the repository.</small></label>
                    </div>
                  )}
                  <div class="mg-actions end"><button type="submit" class="mg-btn">Save the record</button></div>
                </form>
              </details>
            )}

            {gm && (
              <details class="mg-editor">
                <summary>The keeper</summary>
                <div>
                  <form class="mg-form inline" data-api="warbands/assign" data-json={JSON.stringify({ warbandId: warband.id })}>
                    <label class="mg-field">Hand the warband to<select name="userId" data-nullable><option value="">nobody</option>{players.map((p) => <option value={p.id} selected={p.id === warband!.ownerId}>{p.name} — {p.email}</option>)}</select></label>
                    <button type="submit" class="mg-btn">Hand it over</button>
                  </form>
                  <p class="mg-note">The Curfew ledger goes with the warband, nights and all. A player already keeping another warband must give that one up first.</p>
                  <div class="mg-actions">
                    {warband.ownerId && <button type="button" class="mg-btn ghost" data-act="warbands/release" data-body={JSON.stringify({ warbandId: warband.id })} data-confirm={`Take ${warband.name} from ${warband.player}? Their ledger is destroyed and anyone may take the warband up.`}>Release from their keeper</button>}
                    {warband.battles === 0 && <button type="button" class="mg-btn blood" data-act="warbands/delete" data-body={JSON.stringify({ warbandId: warband.id })} data-goto={`${base}/warbands/`} data-confirm={`Strike ${warband.name} from the record? Every warrior goes with them. This does not come back.`}>Strike from the record</button>}
                  </div>
                </div>
              </details>
            )}
            {owner && !gm && (
              <details class="mg-editor">
                <summary>Give up the warband</summary>
                <div><p class="mg-muted">Someone else may take them up. The Curfew ledger, every night in it, goes too.</p>
                <div class="mg-actions"><button type="button" class="mg-btn blood" data-act="warbands/release" data-body={JSON.stringify({ warbandId: warband.id })} data-goto={`${base}/warbands/`} data-confirm={`Give up ${warband.name}? The ledger is lost with them.`}>Give them up</button></div></div>
              </details>
            )}
          </section>
        )}
      </>
    )}
  </main>
</Base>

<style>
  .wb-hero { display: flex; gap: 1.2rem; align-items: center; }
  .wb-crest { flex: none; font: 1.6rem/1 var(--font-utility); color: var(--gold); filter: drop-shadow(0 5px 8px #0007); }
  .wb-crest img { display: block; width: 84px; height: auto; }
  .wb-kicker-link { color: var(--gold); letter-spacing: .1em; text-underline-offset: .25em; }
  .wb-kicker-link:hover { color: var(--parchment); }
  /* the page's parts as tabs: one shows at a time, and the bar stays in reach while it is read */
  .wb-tabs { position: sticky; top: 0; z-index: 20; display: flex; gap: 0 1.6rem; overflow-x: auto; scrollbar-width: none; margin: 0 -1rem; padding: 0 1rem; border-bottom: 1px solid var(--border); background: var(--bg); box-shadow: 0 8px 16px -12px #000c; font: var(--text-ui)/1.5 var(--font-utility); text-transform: uppercase; letter-spacing: .1em; }
  .wb-tabs::-webkit-scrollbar { display: none; }
  .wb-tabs a { flex: none; display: inline-flex; align-items: center; min-height: 3rem; color: var(--ink-dim); text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; transition: color .2s, border-color .2s; }
  .wb-tabs a:hover { color: var(--parchment); }
  .wb-tabs a[aria-current='page'] { color: var(--gold); border-bottom-color: var(--gold); }
  @media (max-width: 640px) { .wb-tabs { padding-right: 3.5rem; } }
  .wb-pane { margin-top: 1.6rem; scroll-margin-top: 4rem; }
  .wb-overview { max-width: 68ch; }
  .wb-overview p { color: var(--ink-dim); font-style: italic; line-height: 1.8; }
  .wb-overview p + p { margin-top: 1rem; }
  .wb-hint { margin: -.25rem 0 .75rem; }
  /* the add drawer reads as a row of the roll waiting to be filled */
  .wb-add { margin-top: .5rem; border-style: dashed; border-color: var(--gold-dim); background: transparent; }
  .wb-add > summary { min-height: 3.5rem; justify-content: center; }
  .wb-add[open] { border-style: solid; background: #0f1512; }
  .wb-add[open] > summary { justify-content: flex-start; }
  @media (max-width: 540px) { .wb-crest img { width: 56px; } .wb-hero { gap: .9rem; } }
</style>

<script>
  import { wireManage } from '../../lib/manage';
  import { wirePortraits } from '../../lib/portrait';
  const root = document.getElementById('main-content')!;
  wireManage(root, root.dataset.base ?? '');
  wirePortraits(root, root.dataset.base ?? '');
  // One part of the page shows at a time, chosen by the address: a tab's own name (#roster), or anything inside a
  // part (#agnar, #record, #add-warrior, #chapter-3), which shows that part and opens or scrolls to the thing itself.
  const panes = [...root.querySelectorAll<HTMLElement>('[data-pane]')];
  const tabs = [...root.querySelectorAll<HTMLAnchorElement>('a[data-tab]')];
  const bar = root.querySelector<HTMLElement>('.wb-tabs');
  const show = (pane: HTMLElement) => {
    for (const p of panes) p.hidden = p !== pane;
    for (const t of tabs) { if (t.hash === `#${pane.id}`) t.setAttribute('aria-current', 'page'); else t.removeAttribute('aria-current'); }
  };
  const route = (id: string, opening: boolean) => {
    const target = id ? document.getElementById(id) : null;
    const pane = target?.closest<HTMLElement>('[data-pane]') ?? panes[0];
    if (!pane) return;
    show(pane);
    if (target === pane) { if (bar && bar.getBoundingClientRect().top < 0) bar.scrollIntoView({ block: 'start' }); return; }
    if (!target) return;
    if (target instanceof HTMLDetailsElement) target.open = true;
    target.scrollIntoView({ block: 'start' });
    if (opening && target instanceof HTMLDetailsElement) (target.querySelector('textarea, input, select') as HTMLElement | null)?.focus({ preventScroll: true });
  };
  const fromAddress = () => route(location.hash.slice(1), true);
  fromAddress();
  addEventListener('hashchange', fromAddress);
  addEventListener('popstate', fromAddress);
  // a tab switches in place, without the jump a bare anchor makes
  for (const t of tabs) t.addEventListener('click', (e) => {
    e.preventDefault();
    if (location.hash !== t.hash) history.pushState(null, '', t.hash);
    route(t.hash.slice(1), false);
  });
</script>
