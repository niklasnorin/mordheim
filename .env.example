# Copy to .env for local development. On Vercel, set these under Project → Settings → Environment Variables.

# Postgres. The Neon integration on the Vercel Marketplace sets DATABASE_URL for you (free tier is enough).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Better Auth. Generate the secret with `openssl rand -base64 32`.
# The public URL of the deployment; on Vercel this can be left unset and is derived from VERCEL_PROJECT_PRODUCTION_URL.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# Social login. A provider's button only appears when both of its values are set.
# Redirect URI to register with each provider: <BETTER_AUTH_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared secret for the nightly cron. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Set to true to allow `?date=YYYY-MM-DD` and the Debug strip on Curfew pages. Never in production.
CURFEW_DEBUG=false
