# Local development needs none of this: `npm run dev` with no .env uses a local Postgres under .pglite/,
# a password-free dev sign-in, and the Debug strip for stepping through nights. Copy to .env only to
# change that, e.g. to point at Neon, require an invite word, or turn the dev conveniences off.
#
# On Vercel, set these under Project → Settings → Environment Variables.

# Postgres. The Neon integration on the Vercel Marketplace sets DATABASE_URL for you (free tier is enough).
# Locally, leave unset for PGlite, or paste the Neon string to work against the real database. Note that
# `vercel env pull` writes "[SENSITIVE]" for it: copy the real string from the Neon console instead.
DATABASE_URL=

# Better Auth (email and password; no emails are ever sent). Generate the secret with `openssl rand -base64 32`.
# Required on Vercel; a fixed dev value is used locally. BETTER_AUTH_URL can be left unset on Vercel.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321

# The word new players must give to sign up. Leave unset and anyone with the URL may create an account.
CURFEW_INVITE_CODE=

# Shared secret for the nightly cron. Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Game masters who may open the Watch House at /admin/, by sign-in email, comma-separated.
# Locally, with the dev sign-in and this left empty, every player is an admin.
ADMIN_EMAILS=

# Local development switches. All three default to on in `astro dev` and can never be on where VERCEL is set.
# CURFEW_LOCAL_DB=false     # refuse to fall back to PGlite when DATABASE_URL is missing
# CURFEW_DEV_LOGIN=false    # hide the name-only sign-in
# CURFEW_DEBUG=false        # hide the Debug strip and ignore ?date=
